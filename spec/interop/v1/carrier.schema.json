{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/interop/v1/carrier.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "channel",
    "type",
    "digest",
    "length",
    "index",
    "data"
  ],
  "properties": {
    "channel": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "type": {
      "enum": [
        "endpoint-identity",
        "user-authority",
        "prekey-bundle",
        "first-packet",
        "session-accept",
        "protected-record"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 524288
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "data": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 10924
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/conformance-case.schema.json",
  "title": "LicoArc authority-owned conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "caseVersion",
    "id",
    "target",
    "context",
    "input",
    "expected"
  ],
  "properties": {
    "$schema": {
      "const": "https://licoarc.com/spec/schemas/conformance-case.schema.json"
    },
    "caseVersion": {
      "const": "licoarc.conformance-case.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,191}$",
      "maxLength": 192
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^licoarc[.][a-z0-9-]+(?:[.][a-z0-9-]+)*[.]v[1-9][0-9]*$",
          "maxLength": 192
        }
      }
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "input": {},
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result"
          ],
          "properties": {
            "result": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,127}$",
                  "maxLength": 128
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBindings",
        "catalogs",
        "publicMaterial",
        "clock",
        "state",
        "transport",
        "storage"
      ],
      "properties": {
        "sourceBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourcePath",
              "sha256"
            ],
            "properties": {
              "sourcePath": {
                "type": "string",
                "pattern": "^(?:spec|conformance|formal|docs)/[A-Za-z0-9._/-]+$",
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "maxLength": 64
              }
            }
          }
        },
        "catalogs": {
          "$ref": "#/$defs/namedDocuments"
        },
        "publicMaterial": {
          "$ref": "#/$defs/namedDocuments"
        },
        "clock": {},
        "state": {},
        "transport": {},
        "storage": {}
      }
    },
    "namedDocuments": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sourcePath",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,127}$",
            "maxLength": 128
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^(?:spec|conformance|formal|docs)/[A-Za-z0-9._/-]+$",
            "maxLength": 256
          },
          "value": {}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/protection-profiles.schema.json",
  "title": "LicoArc initial V1 Protection Profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "registryVersion",
    "definitionStates",
    "lifecycleStates",
    "profiles",
    "activeProfileIds",
    "contentIdentity",
    "admission"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "const": "https://licoarc.com/spec/protection-profiles.json"
    },
    "registryVersion": {
      "const": "licoarc.protection-profiles.v1"
    },
    "definitionStates": {
      "const": [
        "PENDING",
        "DRAFT",
        "PARTIAL",
        "COMPLETE"
      ]
    },
    "lifecycleStates": {
      "const": [
        "Candidate"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileLocator",
          "generation",
          "profileId",
          "lifecycle",
          "definitionStatus",
          "sessionEligible",
          "publicationEligible",
          "sourceDescriptorPath",
          "requiredClaimIds",
          "stableNonClaimIds",
          "blockers"
        ],
        "properties": {
          "profileLocator": {
            "const": "stable-core"
          },
          "generation": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/generation"
          },
          "profileId": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/pendingDigest256"
          },
          "lifecycle": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/lifecycle"
          },
          "definitionStatus": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/pendingDefinitionStatus"
          },
          "sessionEligible": {
            "type": "boolean"
          },
          "publicationEligible": {
            "type": "boolean"
          },
          "sourceDescriptorPath": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/sourcePath"
          },
          "requiredClaimIds": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/claimId"
            }
          },
          "stableNonClaimIds": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$",
              "maxLength": 128
            }
          },
          "blockers": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/blockerId"
            }
          }
        }
      }
    },
    "activeProfileIds": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/digest256"
      },
      "minItems": 1
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "algorithm",
        "include",
        "exclude"
      ],
      "properties": {
        "name": {
          "const": "ProtectionProfileSemanticProjectionV1"
        },
        "algorithm": {
          "const": "SHA-256-over-domain-and-deterministic-CBOR"
        },
        "include": {
          "const": [
            "profile-semantic-version",
            "indivisible-composition-rules",
            "canonical-semantic-source-bytes-excluding-authority-vectors",
            "stable-positive-claim-identifiers",
            "stable-nonclaim-identifiers"
          ]
        },
        "exclude": {
          "const": [
            "profileId-and-contentIdentity",
            "catalogs-containing-identities",
            "lifecycle-and-publication",
            "admission-status",
            "proof-results-and-tools",
            "formal-bindings",
            "source-and-artifact-digests"
          ]
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "contentIdentity",
        "claimClosure",
        "corpusClosure",
        "reducedSecurityFallback",
        "componentNegotiation",
        "unknownProfile",
        "identifierReuse",
        "stateAdvanceOnFailure"
      ],
      "properties": {
        "requires": {
          "const": "known-complete-content-identical-profile"
        },
        "contentIdentity": {
          "const": "recomputed-before-active-admission"
        },
        "claimClosure": {
          "const": "all-required-positive-claims-known-proved-and-fully-bound"
        },
        "corpusClosure": {
          "const": "complete-declared-profile-corpus"
        },
        "reducedSecurityFallback": {
          "const": "forbidden"
        },
        "componentNegotiation": {
          "const": "forbidden"
        },
        "unknownProfile": {
          "const": "terminal-unknown-profile"
        },
        "identifierReuse": {
          "const": "forbidden"
        },
        "stateAdvanceOnFailure": {
          "const": false
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/protection-profiles.schema.json",
  "title": "LicoArc lifecycle-generic Protection Profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "registryVersion", "definitionStates", "lifecycleStates", "profiles", "activeProfileIds", "reservedIdentifiers", "contentIdentity", "admission"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "$id": {"const": "https://licoarc.com/spec/protection-profiles.json"},
    "registryVersion": {"const": "licoarc.protection-profiles.v1"},
    "definitionStates": {"const": ["PENDING", "DRAFT", "PARTIAL", "COMPLETE"]},
    "lifecycleStates": {"const": ["Candidate", "Published", "Deprecated", "Retired"]},
    "profiles": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profileLocator", "generation", "minimumGeneration", "profileId", "lifecycle", "definitionStatus", "sessionEligible", "publicationEligible", "newSessionPolicy", "existingSessionPolicy", "authenticatedEffectiveGeneration", "sourceDescriptorPath", "requiredClaimIds", "stableNonClaimIds", "blockers"],
        "properties": {
          "profileLocator": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/profileLocator"},
          "generation": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/generation"},
          "minimumGeneration": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/generation"},
          "profileId": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/pendingDigest256"},
          "lifecycle": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/lifecycle"},
          "definitionStatus": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/pendingDefinitionStatus"},
          "sessionEligible": {"type": "boolean"},
          "publicationEligible": {"type": "boolean"},
          "newSessionPolicy": {"type": "string", "enum": ["allow-authenticated", "forbid-incomplete", "forbid-deprecated", "forbid-retired"]},
          "existingSessionPolicy": {"type": "string", "enum": ["continue-authenticated", "terminate-on-authenticated-adoption", "terminate-at-authenticated-generation"]},
          "authenticatedEffectiveGeneration": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
          "sourceDescriptorPath": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/sourcePath"},
          "requiredClaimIds": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/claimId"}},
          "stableNonClaimIds": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$", "maxLength": 128}},
          "blockers": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/blockerId"}}
        }
      }
    },
    "activeProfileIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/digest256"}},
    "reservedIdentifiers": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "generation", "lifecycle", "status", "wireAllocation", "newSessionPolicy", "existingSessionPolicy", "authenticatedEffectiveGeneration", "reusable"],
        "properties": {
          "id": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/digest256"},
          "generation": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/generation"},
          "lifecycle": {"const": "Retired"},
          "status": {"const": "withdrawn-candidate"},
          "wireAllocation": {"const": "DIGEST256-profile-id-retained-as-tombstone-only"},
          "newSessionPolicy": {"const": "forbid-retired"},
          "existingSessionPolicy": {"type": "string", "enum": ["continue-authenticated", "terminate-on-authenticated-adoption", "terminate-at-authenticated-generation"]},
          "authenticatedEffectiveGeneration": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
          "reusable": {"const": false}
        }
      }
    },
    "contentIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "algorithm", "include", "exclude"],
      "properties": {
        "name": {"const": "ProtectionProfileSemanticProjectionV1"},
        "algorithm": {"const": "SHA-256-over-domain-and-deterministic-CBOR"},
        "include": {"const": ["profile-semantic-version", "indivisible-composition-rules", "canonical-semantic-source-bytes-excluding-authority-vectors", "stable-positive-claim-identifiers", "stable-nonclaim-identifiers"]},
        "exclude": {"const": ["profileId-and-contentIdentity", "catalogs-containing-identities", "lifecycle-and-publication", "admission-status", "proof-results-and-tools", "formal-bindings", "source-and-artifact-digests"]}
      }
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["requires", "contentIdentity", "claimClosure", "corpusClosure", "reducedSecurityFallback", "componentNegotiation", "unknownProfile", "retiredProfile", "identifierReuse", "stateAdvanceOnFailure"],
      "properties": {
        "requires": {"const": "known-complete-content-identical-profile"},
        "contentIdentity": {"const": "recomputed-before-active-admission"},
        "claimClosure": {"const": "all-required-positive-claims-known-proved-and-fully-bound"},
        "corpusClosure": {"const": "complete-declared-profile-corpus"},
        "reducedSecurityFallback": {"const": "forbidden"},
        "componentNegotiation": {"const": "forbidden"},
        "unknownProfile": {"const": "terminal-unknown-profile"},
        "retiredProfile": {"const": "terminal-retired-profile"},
        "identifierReuse": {"const": "forbidden"},
        "stateAdvanceOnFailure": {"const": false}
      }
    }
  }
}

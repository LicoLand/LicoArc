{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/protection-profiles.schema.json",
  "title": "LicoArc Protection Profile lifecycle registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "registryVersion", "lifecycleStates", "activeProfiles", "reservedIdentifiers", "admission"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "$id": {"const": "https://licoarc.com/spec/protection-profiles.json"},
    "registryVersion": {"const": "licoarc.protection-profiles.v1"},
    "lifecycleStates": {"const": ["Candidate", "Published", "Deprecated", "Retired"]},
    "activeProfiles": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "generation", "minimumGeneration", "contentDigest", "lifecycle", "definitionStatus", "sessionEligible", "publicationEligible", "newSessionPolicy", "existingSessionPolicy", "authenticatedEffectiveGeneration", "sourceManifestPath", "requiredClaimIds"],
        "properties": {
          "profileId": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
          "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "minimumGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "contentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
          "lifecycle": {"type": "string", "enum": ["Candidate", "Published", "Deprecated"]},
          "definitionStatus": {"const": "COMPLETE"},
          "sessionEligible": {"type": "boolean"},
          "publicationEligible": {"type": "boolean"},
          "newSessionPolicy": {"type": "string", "enum": ["allow-authenticated", "forbid-deprecated"]},
          "existingSessionPolicy": {"type": "string", "enum": ["continue-authenticated", "terminate-on-authenticated-adoption", "terminate-at-authenticated-generation"]},
          "authenticatedEffectiveGeneration": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
          "sourceManifestPath": {"type": "string", "pattern": "^spec/[A-Za-z0-9._/-]+$", "maxLength": 256},
          "requiredClaimIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^SEC-[0-9]{3}$", "maxLength": 7}}
        }
      }
    },
    "reservedIdentifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "generation", "lifecycle", "status", "newSessionPolicy", "existingSessionPolicy", "authenticatedEffectiveGeneration", "reusable"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
          "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "lifecycle": {"const": "Retired"},
          "status": {"type": "string", "enum": ["withdrawn-candidate", "retired"]},
          "newSessionPolicy": {"const": "forbid-retired"},
          "existingSessionPolicy": {"type": "string", "enum": ["continue-authenticated", "terminate-on-authenticated-adoption", "terminate-at-authenticated-generation"]},
          "authenticatedEffectiveGeneration": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
          "reusable": {"const": false}
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "contentIdentity", "reducedSecurityFallback", "componentNegotiation", "unknownProfile", "retiredProfile", "identifierReuse", "stateAdvanceOnFailure"],
      "properties": {
        "requires": {"const": "decided-specified-complete-profile-with-proof-bound-claims"},
        "contentIdentity": {"const": "required-before-active-admission"},
        "reducedSecurityFallback": {"const": "forbidden"},
        "componentNegotiation": {"const": "forbidden"},
        "unknownProfile": {"const": "terminal-unknown-profile"},
        "retiredProfile": {"const": "terminal-retired-profile"},
        "identifierReuse": {"const": "forbidden"},
        "stateAdvanceOnFailure": {"const": false}
      }
    }
  }
}

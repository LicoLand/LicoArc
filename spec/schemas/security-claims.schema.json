{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/security-claims.schema.json",
  "title": "LicoArc security claim registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "registryVersion",
    "lifecycle",
    "claimStatusValues",
    "claims",
    "nonClaims"
  ],
  "properties": {
    "$schema": {
      "const": "https://licoarc.com/spec/schemas/security-claims.schema.json"
    },
    "$id": {
      "const": "https://licoarc.com/spec/v1/security/claims.json"
    },
    "registryVersion": {
      "const": "licoarc.security-claims.v1"
    },
    "lifecycle": {
      "const": "Candidate"
    },
    "claimStatusValues": {
      "const": [
        "unproved",
        "proved",
        "explicit-nonclaim"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "property",
          "scope",
          "adversary",
          "assumptions",
          "proofModel",
          "proofLemma",
          "counterexampleStatus",
          "residualRisk",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SEC-[0-9]{3}$",
            "maxLength": 7
          },
          "property": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$",
            "maxLength": 128
          },
          "scope": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$",
            "maxLength": 128
          },
          "adversary": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^A(?:[0-9]+|-[A-Z][A-Z0-9-]*)$",
              "maxLength": 128
            }
          },
          "assumptions": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$",
              "maxLength": 128
            }
          },
          "proofModel": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-zA-Z0-9._/-]+$",
            "maxLength": 256
          },
          "proofLemma": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-zA-Z0-9._/-]+$",
            "maxLength": 256
          },
          "counterexampleStatus": {
            "type": "string",
            "enum": [
              "not-evaluated",
              "no-counterexample-found",
              "counterexample-found"
            ]
          },
          "residualRisk": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$",
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "unproved",
              "proved",
              "explicit-nonclaim"
            ]
          }
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$",
        "maxLength": 128
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/protocol-lines.schema.json",
  "title": "LicoArc initial V1 Protocol Line catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "registryVersion",
    "definitionStates",
    "lifecycleStates",
    "lines",
    "contentIdentity",
    "immutability"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "const": "https://licoarc.com/spec/protocol-lines.json"
    },
    "registryVersion": {
      "const": "licoarc.protocol-lines.v1"
    },
    "definitionStates": {
      "const": [
        "DRAFT",
        "PARTIAL",
        "COMPLETE"
      ]
    },
    "lifecycleStates": {
      "const": [
        "Candidate"
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wireId",
          "generation",
          "protocolLineId",
          "lifecycle",
          "definitionStatus",
          "sessionEligible",
          "publicationEligible",
          "mandatoryCapabilities",
          "definedCapabilities",
          "protectionProfileIds",
          "stableClaimIds",
          "blockers"
        ],
        "properties": {
          "wireId": {
            "const": "licoarc.protocol-line.v1"
          },
          "generation": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/generation"
          },
          "protocolLineId": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/pendingDigest256"
          },
          "lifecycle": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/lifecycle"
          },
          "definitionStatus": {
            "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/definitionStatus"
          },
          "sessionEligible": {
            "type": "boolean"
          },
          "publicationEligible": {
            "type": "boolean"
          },
          "mandatoryCapabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/protocolLocator"
            }
          },
          "definedCapabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/protocolLocator"
            }
          },
          "protectionProfileIds": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/digest256"
            }
          },
          "stableClaimIds": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/claimId"
            }
          },
          "blockers": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/blockerId"
            }
          }
        }
      }
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "algorithm",
        "include",
        "exclude"
      ],
      "properties": {
        "name": {
          "const": "ProtocolLineSemanticProjectionV1"
        },
        "algorithm": {
          "const": "SHA-256-over-domain-and-deterministic-CBOR"
        },
        "include": {
          "const": [
            "generation",
            "mandatory-capability-semantic-identities",
            "active-protection-profile-identities",
            "stable-positive-claim-identifiers",
            "session-rules"
          ]
        },
        "exclude": {
          "const": [
            "protocolLineId",
            "wireId",
            "catalogs-containing-identities",
            "lifecycle-and-publication",
            "proof-results-and-tools",
            "formal-bindings",
            "source-and-artifact-digests"
          ]
        }
      }
    },
    "immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishedBytes",
        "lifecycleRecord",
        "identifierReuse"
      ],
      "properties": {
        "publishedBytes": {
          "const": "protocol-line-id-bound-and-immutable"
        },
        "lifecycleRecord": {
          "const": "may-change-without-changing-protocol-line-id"
        },
        "identifierReuse": {
          "const": "forbidden"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/protocol-lines.schema.json",
  "title": "LicoArc lifecycle-generic Protocol Line catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "registryVersion", "definitionStates", "lifecycleStates", "lines", "selection", "contentIdentity", "immutability", "retirement"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "$id": {"const": "https://licoarc.com/spec/protocol-lines.json"},
    "registryVersion": {"const": "licoarc.protocol-lines.v1"},
    "definitionStates": {"const": ["DRAFT", "PARTIAL", "COMPLETE"]},
    "lifecycleStates": {"const": ["Candidate", "Published", "Deprecated", "Retired"]},
    "lines": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["wireId", "generation", "minimumGeneration", "protocolLineId", "lifecycle", "definitionStatus", "sessionEligible", "publicationEligible", "newSessionPolicy", "existingSessionPolicy", "authenticatedEffectiveGeneration", "mandatoryCapabilities", "definedCapabilities", "protectionProfileIds", "stableClaimIds", "blockers"],
        "properties": {
          "wireId": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/protocolLocator"},
          "generation": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/generation"},
          "minimumGeneration": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/generation"},
          "protocolLineId": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/pendingDigest256"},
          "lifecycle": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/lifecycle"},
          "definitionStatus": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/definitionStatus"},
          "sessionEligible": {"type": "boolean"},
          "publicationEligible": {"type": "boolean"},
          "newSessionPolicy": {"type": "string", "enum": ["allow-authenticated", "forbid-incomplete", "forbid-deprecated", "forbid-retired"]},
          "existingSessionPolicy": {"type": "string", "enum": ["continue-authenticated", "terminate-on-authenticated-adoption", "terminate-at-authenticated-generation"]},
          "authenticatedEffectiveGeneration": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
          "mandatoryCapabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/protocolLocator"}},
          "definedCapabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/protocolLocator"}},
          "protectionProfileIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/digest256"}},
          "stableClaimIds": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/claimId"}},
          "blockers": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "https://licoarc.com/spec/schemas/catalog-common.schema.json#/$defs/blockerId"}}
        }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["supportStatementAuthority", "supportEntry", "minimumGeneration", "filterOrder", "choice", "success", "zeroResult", "ambiguousHighest", "unknown", "contentIdentityMismatch", "unauthenticatedSupport", "fallback", "componentNegotiation", "translation", "stateAdvanceOnFailure"],
      "properties": {
        "supportStatementAuthority": {"const": "endpoint-authenticated"},
        "supportEntry": {"const": "wire-id-generation-and-protocol-line-id"},
        "minimumGeneration": {"const": "endpoint-authenticated-monotonic-floor"},
        "filterOrder": {"const": ["known-exact-protocol-line-identity", "complete-definition", "new-session-policy-allows", "session-eligible", "meets-both-minimum-generations", "all-mandatory-capabilities-defined", "all-protection-profiles-complete-and-eligible"]},
        "choice": {"const": "unique-highest-common-generation"},
        "success": {"const": "selected-pending-transcript-authentication"},
        "zeroResult": {"const": "terminal-no-common-line"},
        "ambiguousHighest": {"const": "terminal-ambiguous-generation"},
        "unknown": {"const": "terminal-unknown-line"},
        "contentIdentityMismatch": {"const": "terminal-content-identity-mismatch"},
        "unauthenticatedSupport": {"const": "terminal-unauthenticated-support"},
        "fallback": {"const": "forbidden"},
        "componentNegotiation": {"const": "forbidden"},
        "translation": {"const": "forbidden"},
        "stateAdvanceOnFailure": {"const": false}
      }
    },
    "contentIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "algorithm", "include", "exclude"],
      "properties": {
        "name": {"const": "ProtocolLineSemanticProjectionV1"},
        "algorithm": {"const": "SHA-256-over-domain-and-deterministic-CBOR"},
        "include": {"const": ["generation", "mandatory-capability-semantic-identities", "active-protection-profile-identities", "stable-positive-claim-identifiers", "selection-rules", "session-rules"]},
        "exclude": {"const": ["protocolLineId", "wireId", "catalogs-containing-identities", "lifecycle-and-publication", "proof-results-and-tools", "formal-bindings", "source-and-artifact-digests"]}
      }
    },
    "immutability": {
      "type": "object", "additionalProperties": false,
      "required": ["publishedBytes", "lifecycleRecord", "semanticChange", "identifierReuse"],
      "properties": {
        "publishedBytes": {"const": "protocol-line-id-bound-and-immutable"},
        "lifecycleRecord": {"const": "may-change-without-changing-protocol-line-id"},
        "semanticChange": {"const": "new-complete-line-and-generation"},
        "identifierReuse": {"const": "forbidden"}
      }
    },
    "retirement": {
      "type": "object", "additionalProperties": false,
      "required": ["retiredNewSessions", "existingSessionPolicyOwner", "effectiveBoundOwner", "implementationChoice", "silentMigration", "successorRebinding"],
      "properties": {
        "retiredNewSessions": {"const": "forbid-retired"},
        "existingSessionPolicyOwner": {"const": "authenticated-protocol-line-registry"},
        "effectiveBoundOwner": {"const": "authenticated-protocol-line-registry"},
        "implementationChoice": {"const": "forbidden"},
        "silentMigration": {"const": "forbidden"},
        "successorRebinding": {"const": "fresh-complete-authenticated-handshake-only"}
      }
    }
  }
}

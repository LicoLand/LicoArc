{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/schemas/conformance-envelope.schema.json",
  "title": "LicoArc conformance case envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "envelopeVersion", "corpusId", "cases"],
  "properties": {
    "$schema": {"const": "https://licoarc.com/spec/schemas/conformance-envelope.schema.json"},
    "envelopeVersion": {"const": "licoarc.conformance-envelope.v1"},
    "corpusId": {"type": "string", "pattern": "^licoarc[.][a-z0-9-]+(?:[.][a-z0-9-]+)*[.]v[1-9][0-9]*$", "maxLength": 192},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "https://licoarc.com/spec/schemas/conformance-case.schema.json"}
    }
  }
}

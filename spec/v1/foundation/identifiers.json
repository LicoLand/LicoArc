{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/schemas/foundation-identifiers.schema.json",
  "registryVersion": "licoarc.foundation-identifiers.v1",
  "lifecycle": "Candidate",
  "scope": "foundation-contract-identifiers-only",

    {
      "name": "foundationIdentifierRegistry",
      "value": "licoarc.foundation-identifiers.v1",
      "kind": "source-contract",
      "wire": false,
      "status": "Candidate"
    },
    {
      "name": "foundationLifecycleRegistry",
      "value": "licoarc.foundation-lifecycle.v1",
      "kind": "source-contract",
      "wire": false,
      "status": "Candidate"
    },
    {
      "name": "foundationSourceManifest",
      "value": "licoarc.foundation-source-manifest.v1",
      "kind": "source-contract",
      "wire": false,
      "status": "Candidate"
    },
    {
      "name": "protocolLineManifest",
      "value": "licoarc.protocol-line-manifest.v1",

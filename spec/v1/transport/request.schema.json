{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/transport/request.schema.json",
  "title": "Lico Arc HTTPS Transport v1 control requests",
  "oneOf": [
    { "$ref": "#/$defs/affiliateRequest" },
    { "$ref": "#/$defs/reserveRequest" },
    { "$ref": "#/$defs/retrieveRequest" },
    { "$ref": "#/$defs/claimRequest" },
    { "$ref": "#/$defs/settleRequest" }
  ],
  "$defs": {
    "digest256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id128": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "token256": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "handleClass": { "type": "string", "enum": ["async", "firstContact"] },
    "affiliateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operationId", "stationDescriptorDigest", "affiliationCommitment"],
      "properties": {
        "operation": { "const": "affiliate" },
        "operationId": { "$ref": "#/$defs/id128" },
        "stationDescriptorDigest": { "$ref": "#/$defs/digest256" },
        "affiliationCommitment": { "$ref": "#/$defs/digest256" }
      }
    },
    "reserveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operationId", "stationDescriptorDigest", "affiliationCommitment", "transportProfileId", "handleClass"],
      "properties": {
        "operation": { "const": "reserve" },
        "operationId": { "$ref": "#/$defs/id128" },
        "stationDescriptorDigest": { "$ref": "#/$defs/digest256" },
        "affiliationCommitment": { "$ref": "#/$defs/digest256" },
        "transportProfileId": { "$ref": "#/$defs/digest256" },
        "handleClass": { "$ref": "#/$defs/handleClass" }
      }
    },
    "retrieveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operationId", "claimId", "claimEpoch", "itemId"],
      "properties": {
        "operation": { "const": "retrieve" },
        "operationId": { "$ref": "#/$defs/id128" },
        "claimId": { "$ref": "#/$defs/token256" },
        "claimEpoch": { "$ref": "#/$defs/epoch" },
        "itemId": { "$ref": "#/$defs/token256" }
      }
    },
    "claimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operationId", "maxItems"],
      "properties": {
        "operation": { "const": "claim" },
        "operationId": { "$ref": "#/$defs/id128" },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "settleAction"],
      "properties": {
        "itemId": { "$ref": "#/$defs/token256" },
        "settleAction": { "type": "string", "enum": ["complete", "release"] }
      }
    },
    "settleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operationId", "claimId", "claimEpoch", "settlements"],
      "properties": {
        "operation": { "const": "settle" },
        "operationId": { "$ref": "#/$defs/id128" },
        "claimId": { "$ref": "#/$defs/token256" },
        "claimEpoch": { "$ref": "#/$defs/epoch" },
        "settlements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/settlement" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/transport/bounds.json",
  "registryVersion": "licoarc.https-transport-bounds.v1",
  "lifecycle": "Candidate",
  "scope": "https-tls13-transport-profile-v1",
  "units": {
    "MAX_PACKET_BYTES": "bytes",
    "MAX_CONTROL_BODY_BYTES": "bytes",
    "MAX_CLAIM_RESPONSE_BYTES": "bytes",
    "MAX_TRANSPORT_OVERHEAD_BYTES_PER_OPERATION": "bytes",
    "STORAGE_WINDOW_SECONDS": "seconds",
    "IDEMPOTENCY_WINDOW_SECONDS": "seconds",
    "CLAIM_WINDOW_SECONDS": "seconds",
    "MAX_QUEUE_BYTES_PER_HANDLE": "bytes",
    "MAX_CLAIM_BYTES": "bytes"
  },
  "bounds": {
    "MAX_PACKET_BYTES": 524288,
    "MAX_CONTROL_BODY_BYTES": 16384,
    "MAX_CLAIM_RESPONSE_BYTES": 33554432,
    "MAX_TRANSPORT_OVERHEAD_BYTES_PER_OPERATION": 2048,
    "MAX_OPERATION_ID_BYTES": 16,
    "MAX_DELIVERY_HANDLE_BYTES": 32,
    "MAX_CLAIM_ID_BYTES": 32,
    "MAX_ITEM_ID_BYTES": 32,
    "MAX_QUEUE_ITEMS_PER_HANDLE": 128,
    "MAX_QUEUE_BYTES_PER_HANDLE": 67108864,
    "MAX_CLAIM_ITEMS": 64,
    "MAX_CLAIM_BYTES": 33554432,
    "MAX_SETTLEMENT_ITEMS": 64,
    "MAX_SETTLEMENT_ATTEMPTS": 8,
    "MAX_SETTLEMENT_RESULT_BYTES": 16384,
    "MAX_RETRY_AFTER_MS": 60000,
    "STORAGE_WINDOW_SECONDS": 3600,
    "IDEMPOTENCY_WINDOW_SECONDS": 300,
    "CLAIM_WINDOW_SECONDS": 300,
    "MAX_PATH_BYTES": 128,
    "MAX_HEADER_BYTES": 2048
  },
  "relationships": [
    "MAX_PACKET_BYTES <= MAX_QUEUE_BYTES_PER_HANDLE",
    "MAX_CLAIM_BYTES <= MAX_QUEUE_BYTES_PER_HANDLE",
    "MAX_CLAIM_RESPONSE_BYTES >= MAX_CLAIM_BYTES",
    "MAX_SETTLEMENT_ITEMS <= MAX_CLAIM_ITEMS",
    "MAX_SETTLEMENT_ATTEMPTS >= 1",
    "IDEMPOTENCY_WINDOW_SECONDS < STORAGE_WINDOW_SECONDS",
    "CLAIM_WINDOW_SECONDS <= STORAGE_WINDOW_SECONDS",
    "MAX_TRANSPORT_OVERHEAD_BYTES_PER_OPERATION < MAX_CONTROL_BODY_BYTES",
    "MAX_OPERATION_ID_BYTES = 16",
    "MAX_DELIVERY_HANDLE_BYTES = 32",
    "MAX_CLAIM_ID_BYTES = 32",
    "MAX_ITEM_ID_BYTES = 32"
  ],
  "resetPolicy": "retry-reconnect-route-change-station-migration-never-reset-or-extend-a-window",
  "storage": {
    "retention": "one fixed storage window from accepted submission",
    "queue": "opaque protected packets only",
    "claim": "one bounded live claim per returned item and fixed claim window",
    "settlement": "complete or release atomically for the complete requested set",
    "senderRetentionInput": "forbidden",
    "pollingResource": "forbidden"
  }
}

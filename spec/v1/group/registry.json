{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/group/registry.json",
  "registryVersion": "licoarc.group-collaboration.v1",
  "wireId": "licoarc.group-collaboration.v1",
  "protocolLineIdType": "DIGEST256-line-content-identity",
  "capabilityId": "licoarc.group-collaboration.v1",
  "lifecycle": "Candidate",
  "normativeLanguage": "en",
  "scope": "protected-bounded-group-state-message-and-per-member-projection",
  "sourcePaths": {
    "bounds": "spec/v1/group/bounds.json",
    "labels": "spec/v1/group/labels.json",
    "runtime": "spec/v1/group/runtime.cddl",
    "schema": "spec/v1/group/group.schema.json",
    "stateSchema": "spec/v1/group/state.schema.json",
    "messageSchema": "spec/v1/group/message.schema.json",
    "transitionSchema": "spec/v1/group/transition.schema.json",
    "resultSchema": "spec/v1/group/result.schema.json",
    "fieldRegistry": "spec/v1/group/field-registry.json",
    "sourceManifest": "spec/v1/group/source-manifest.json",
    "conformanceManifest": "conformance/v1/group/manifest.json"
  },
  "representation": {
    "governance": "restricted-jcs-json",
    "runtime": "deterministic-cbor",
    "mapKeyEncoding": "compact-unsigned-integer",
    "lengthEncoding": "definite",
    "rawBytes": "bstr",
    "tags": "forbidden",
    "floats": "forbidden",
    "indefiniteLengths": "forbidden",
    "duplicateLabels": "reject",
    "unknownLabels": "reject",
    "trailingBytes": "reject"
  },
  "sourceClosure": {
    "manifestPath": "spec/v1/group/source-manifest.json",
    "undeclaredFiles": "reject",
    "symlinks": "reject",
    "sortedPaths": "required"
  },
  "authority": {
    "stateAndTransition": "owning-group-capability-and-endpoint-protection",
    "perMemberProjection": "owning-group-capability-and-endpoint-evidence",
    "endpointAdmission": "endpoint-local",
    "crossCapabilityTotals": "bounded-by-protocol-line",
    "inheritance": "forbidden"
  },
  "stateIdentity": {
    "digest": "SHA-256(domain=LICOARC-GROUP-STATE\\0, canonical-state)",
    "tuple": ["groupId", "groupEpoch", "previousGroupStateDigest", "members", "transitionDigest"],
    "genesisEpoch": 0,
    "successorRule": "exactly-predecessor-epoch-plus-one",
    "predecessorRule": "exact-complete-canonical-immediate-predecessor"
  },
  "transitionAuthorization": {
    "genesis": "author-is-a-state-authority-member-in-the-genesis-snapshot",
    "successor": "author-is-a-state-authority-in-the-exact-predecessor-snapshot",
    "operations": ["add", "remove", "role"],
    "stationOrder": "never-authority",
    "productPermissions": "never-authority",
    "arrivalOrder": "never-authority",
    "evidence": "the-Endpoint-protection-and-Endpoint-evidence-context-authenticate-the-transition"
  },
  "forkPolicy": {
    "samePredecessorAndEpochSameDigest": "idempotent-duplicate",
    "samePredecessorAndEpochDifferentDigest": "reject-fork",
    "missingPredecessor": "reject-gap",
    "staleEpoch": "reject-stale",
    "crossGroup": "reject-cross-group",
    "terminalRemovalReplay": "reject-removed-member"
  },
  "projectionPolicy": {
    "recipients": "canonical-sorted-members-excluding-sender",
    "maxRecipients": "MAX_GROUP_PROJECTIONS",
    "projectionId": "first-16-bytes-SHA-256(domain=LICOARC-GROUP-PROJECTION\\0, stateDigest, messageId, recipient)",
    "retry": "per-member-at-least-once-with-stable-projection-id",
    "stationReceipt": "never-endpoint-evidence"
  },
  "aggregationPolicy": {
    "resultOrder": "recipient-endpoint-reference-byte-order",
    "missingResult": "pending",
    "allDelivered": "complete",
    "noDeliveredAndAllTerminalFailure": "failed",
    "otherwise": "partial",
    "authority": "endpoint-evidence-or-none-only"
  },
  "persistencePolicy": {
    "restart": "restore-high-water-predecessor-evidence-current-members-tombstones-and-per-member-projections-before-accepting-input",
    "bounded": true,
    "persistedStationState": false,
    "persistedProductPermission": false,
    "retiredStateReset": "no-legacy-group-root-or-namespace-is-read"
  },
  "resourceAccounting": {
    "memberSet": "MAX_GROUP_MEMBERS-bounded-sorted-unique-Endpoint-references",
    "state": "MAX_GROUP_STATE_BYTES-is-the-complete-canonical-state-CBOR",
    "operation": "MAX_GROUP_OPERATION_BYTES-is-the-complete-canonical-transition-CBOR",
    "messageControl": "MAX_GROUP_MESSAGE_CONTROL_BYTES-includes-control-and-maximum-payload-length-prefix-but-not-payload-octets",
    "payload": "MAX_GROUP_PAYLOAD_BYTES-is-opaque-payload-octets",
    "projectionResults": "MAX_GROUP_RESULTS-equals-MAX_GROUP_PROJECTIONS-one-result-per-recipient",
    "aggregate": "MAX_GROUP_AGGREGATE_BYTES-is-the-complete-canonical-result-CBOR",
    "persisted": "MAX_GROUP_PERSISTED_BYTES-is-the-complete-bounded-retained-group-state",
    "rejectedOrDuplicateInput": "no-budget-consumption-and-no-state-mutation",
    "retryReset": "forbidden"
  },
  "atomicity": {
    "transition": "validate-complete-predecessor-and-protected-operation-then-commit-successor-once",
    "projection": "register-one-stable-projection-per-canonical-recipient-or-commit-none",
    "result": "same-projection-and-identical-result-replays-without-reapplying-state",
    "restart": "restore-current-state-predecessor-evidence-tombstones-and-projections-before-input",
    "failure": "malformed-gap-fork-stale-unauthorized-or-over-bound-input-leaves-byte-identical-pre-state"
  },
  "outOfScope": [
    "Station-membership-or-ordering-authority",
    "Network-or-account-membership",
    "human-or-device-identity",
    "product-permission-or-command-catalogue",
    "group-key-management",
    "application-payload-interpretation",
    "unbounded-broadcast",
    "compatibility-translator-or-alternate-wire"
  ]
}

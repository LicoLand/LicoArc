{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/group/bounds.json",
  "registryVersion": "licoarc.group-collaboration-bounds.v1",
  "lifecycle": "Candidate",
  "scope": "protected-group-state-message-and-projection-v1",
  "authority": {
    "recordAndStateBounds": "owned-by-group-capability",
    "perMemberProjectionBounds": "owned-by-group-capability",
    "endpointAdmission": "endpoint-local",
    "crossCapabilityTotals": "bounded-by-protocol-line",
    "inheritance": "forbidden"
  },
  "units": {
    "MAX_GROUP_MEMBERS": "members",
    "MAX_GROUP_EPOCH": "safe-integer",
    "MAX_GROUP_STATE_BYTES": "bytes",
    "MAX_GROUP_OPERATION_BYTES": "bytes",
    "MAX_GROUP_MESSAGE_CONTROL_BYTES": "bytes",
    "MAX_GROUP_PAYLOAD_BYTES": "bytes",
    "MAX_GROUP_PROJECTIONS": "projections",
    "MAX_GROUP_RESULTS": "results",
    "MAX_GROUP_AGGREGATE_BYTES": "bytes",
    "MAX_PENDING_GROUP_TRANSITIONS": "transitions",
    "MAX_PENDING_GROUP_RESULTS": "results",
    "MAX_GROUP_EPOCH_TOMBSTONES": "tombstones",
    "MAX_GROUP_PERSISTED_BYTES": "bytes",
    "MAX_GROUP_UNAUTHENTICATED_BYTES": "bytes"
  },
  "bounds": {
    "MAX_GROUP_MEMBERS": 64,
    "MAX_GROUP_EPOCH": 9007199254740991,
    "MAX_GROUP_OPERATION_BYTES": 2512,
    "MAX_GROUP_STATE_BYTES": 2551,
    "MAX_GROUP_MESSAGE_CONTROL_BYTES": 60,
    "MAX_GROUP_PAYLOAD_BYTES": 262144,
    "MAX_GROUP_PROJECTIONS": 64,
    "MAX_GROUP_RESULTS": 64,
    "MAX_GROUP_AGGREGATE_BYTES": 3913,
    "MAX_PENDING_GROUP_TRANSITIONS": 128,
    "MAX_PENDING_GROUP_RESULTS": 256,
    "MAX_GROUP_EPOCH_TOMBSTONES": 1024,
    "MAX_GROUP_PERSISTED_BYTES": 4194304,
    "MAX_GROUP_UNAUTHENTICATED_BYTES": 16384
  },
  "relationships": [
    "MAX_GROUP_MEMBERS >= 1",
    "MAX_GROUP_PROJECTIONS <= MAX_GROUP_MEMBERS",
    "MAX_GROUP_RESULTS = MAX_GROUP_PROJECTIONS",
    "MAX_GROUP_STATE_BYTES = 2551",
    "MAX_GROUP_OPERATION_BYTES = 2512",
    "MAX_GROUP_MESSAGE_CONTROL_BYTES = 60",
    "MAX_GROUP_AGGREGATE_BYTES = 3913",
    "MAX_GROUP_STATE_BYTES <= MAX_GROUP_PERSISTED_BYTES",
    "MAX_GROUP_OPERATION_BYTES < MAX_GROUP_STATE_BYTES",
    "MAX_GROUP_UNAUTHENTICATED_BYTES >= MAX_GROUP_OPERATION_BYTES"
  ],
  "canonicalMaxima": {
    "encoding": "deterministic-cbor",
    "groupMemberBytes": 38,
    "maximumMemberArrayBytes": 2434,
    "maximumStateBytes": 2551,
    "maximumGenesisOperationBytes": 2438,
    "maximumGenesisTransitionBytes": 2512,
    "maximumMessageControlBytes": 60,
    "maximumResultBytes": 60,
    "maximumAggregateBytes": 3913
  },
  "arithmeticAuthority": "stored maxima equal the canonical-CBOR sums of fixed digest, identifier, label, role, outcome, and bounded collection components; payload octets are charged separately",
  "resetPolicy": "retry-reconnect-route-change-station-change-and-restart-never-reset-or-extend-a-group-bound",
  "allocationPolicy": "validate-counts-and-canonical-predecessor-before-copying-member-or-result-collections"
}

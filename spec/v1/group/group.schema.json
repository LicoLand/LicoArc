{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/group/group.schema.json",
  "title": "Lico Arc Protocol v1 protected Group Collaboration profile",
  "oneOf": [
    {
      "$ref": "#/$defs/groupState"
    },
    {
      "$ref": "#/$defs/groupTransition"
    },
    {
      "$ref": "#/$defs/groupMessage"
    },
    {
      "$ref": "#/$defs/groupProjection"
    },
    {
      "$ref": "#/$defs/groupResult"
    },
    {
      "$ref": "#/$defs/groupAggregate"
    }
  ],
  "$defs": {
    "digest256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id128": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "state-authority"
      ]
    },
    "operationKind": {
      "type": "string",
      "enum": [
        "genesis",
        "add",
        "remove",
        "role"
      ]
    },
    "resultOutcome": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "rejected",
        "failed"
      ]
    },
    "failureCode": {
      "type": "string",
      "enum": [
        "malformed",
        "unauthorized",
        "duplicate",
        "fork",
        "gap",
        "stale",
        "removed-member",
        "over-bound",
        "unknown-state",
        "station-authority",
        "conflict",
        "tombstone-overflow",
        "timeout"
      ]
    },
    "aggregateOutcome": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "groupMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointIdentityRef",
        "role"
      ],
      "properties": {
        "endpointIdentityRef": {
          "$ref": "#/$defs/digest256"
        },
        "role": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "groupOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/operationKind"
        },
        "targetEndpointRef": {
          "$ref": "#/$defs/digest256"
        },
        "targetRole": {
          "$ref": "#/$defs/role"
        },
        "initialMembers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/groupMember"
          }
        }
      }
    },
    "groupState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "groupEpoch",
        "members",
        "transitionDigest"
      ],
      "properties": {
        "groupId": {
          "$ref": "#/$defs/digest256"
        },
        "groupEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previousGroupStateDigest": {
          "$ref": "#/$defs/digest256"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/groupMember"
          }
        },
        "transitionDigest": {
          "$ref": "#/$defs/digest256"
        }
      }
    },
    "groupTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "nextGroupEpoch",
        "authorEndpointRef",
        "operation"
      ],
      "properties": {
        "groupId": {
          "$ref": "#/$defs/digest256"
        },
        "previousGroupStateDigest": {
          "$ref": "#/$defs/digest256"
        },
        "nextGroupEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authorEndpointRef": {
          "$ref": "#/$defs/digest256"
        },
        "operation": {
          "$ref": "#/$defs/groupOperation"
        }
      }
    },
    "groupMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "groupStateDigest",
        "payload"
      ],
      "properties": {
        "messageId": {
          "$ref": "#/$defs/id128"
        },
        "groupStateDigest": {
          "$ref": "#/$defs/digest256"
        },
        "payload": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 349528
        }
      }
    },
    "groupProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "messageId",
        "groupStateDigest",
        "recipientEndpointRef"
      ],
      "properties": {
        "projectionId": {
          "$ref": "#/$defs/id128"
        },
        "messageId": {
          "$ref": "#/$defs/id128"
        },
        "groupStateDigest": {
          "$ref": "#/$defs/digest256"
        },
        "recipientEndpointRef": {
          "$ref": "#/$defs/digest256"
        }
      }
    },
    "groupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "recipientEndpointRef",
        "outcome",
        "authority"
      ],
      "properties": {
        "projectionId": {
          "$ref": "#/$defs/id128"
        },
        "recipientEndpointRef": {
          "$ref": "#/$defs/digest256"
        },
        "outcome": {
          "$ref": "#/$defs/resultOutcome"
        },
        "failureCode": {
          "$ref": "#/$defs/failureCode"
        },
        "authority": {
          "type": "string",
          "enum": [
            "endpoint-confirmation",
            "none"
          ]
        }
      }
    },
    "groupAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "groupStateDigest",
        "results",
        "outcome",
        "counts"
      ],
      "properties": {
        "messageId": {
          "$ref": "#/$defs/id128"
        },
        "groupStateDigest": {
          "$ref": "#/$defs/digest256"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/groupResult"
          }
        },
        "outcome": {
          "$ref": "#/$defs/aggregateOutcome"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pending",
            "delivered",
            "rejected",
            "failed"
          ],
          "properties": {
            "pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "delivered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "rejected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        }
      }
    }
  }
}

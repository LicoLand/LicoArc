{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/epoch.schema.json",
  "title": "Lico Arc Pairwise Protection high-assurance post-quantum epoch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "sessionId",
    "epoch",
    "previousEpochDigest",
    "x25519RekeyPublicKey",
    "mlKemCiphertext",
    "transcriptDigest",
    "signature"
  ],
  "properties": {
    "recordType": { "const": "pqEpoch" },
    "sessionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "previousEpochDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "x25519RekeyPublicKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mlKemCiphertext": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){32,3136}$" },
    "transcriptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "purpose", "context", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ML-DSA-87" },
        "purpose": { "const": "epoch-transition" },
        "context": { "const": "LicoArc-High-Transcript" },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "value": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){64,8192}$" }
      }
    }
  }
}

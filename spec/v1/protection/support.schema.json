{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/support.schema.json",
  "title": "Decoded Core v1 authenticated Protocol Support Statement",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sig64": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "sig3309": {"type": "string", "pattern": "^[0-9a-f]{6618}$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["wireId", "generation", "protocolLineId"],
      "properties": {
        "wireId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "protocolLineId": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["identityStateDigest", "minimumProtocolGeneration", "entries", "ed25519KeyId", "mlDsa65KeyId", "ed25519Signature", "mlDsa65Signature"],
  "properties": {
    "identityStateDigest": {"$ref": "#/$defs/digest"},
    "minimumProtocolGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "entries": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/entry"}},
    "ed25519KeyId": {"$ref": "#/$defs/digest"},
    "mlDsa65KeyId": {"$ref": "#/$defs/digest"},
    "ed25519Signature": {"$ref": "#/$defs/sig64"},
    "mlDsa65Signature": {"$ref": "#/$defs/sig3309"}
  }
}

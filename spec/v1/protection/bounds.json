{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/bounds.json",
  "registryVersion": "licoarc.protection-bounds.v1",
  "lifecycle": "Candidate",
  "scope": "pairwise-protection-profile-bounds",
  "bounds": {
    "MAX_PROFILES": 2,
    "MAX_CAPABILITY_DECLARATION_BYTES": 8192,
    "MAX_CAPABILITY_PROFILES": 2,
    "MAX_CAPABILITY_SIGNATURES": 1,
    "MAX_PREKEYS_BASELINE": 64,
    "MAX_PREKEYS_HIGH": 32,
    "MAX_PREKEY_BUNDLE_BYTES_BASELINE": 16384,
    "MAX_PREKEY_BUNDLE_BYTES_HIGH": 32768,
    "MAX_HANDSHAKE_WIRE_BYTES_BASELINE": 32768,
    "MAX_HANDSHAKE_WIRE_BYTES_HIGH": 65536,
    "MAX_ESTABLISHED_RECORD_OVERHEAD_BYTES_BASELINE": 128,
    "MAX_ESTABLISHED_RECORD_OVERHEAD_BYTES_HIGH": 160,
    "MAX_USER_PAYLOAD_BYTES": 262144,
    "MAX_ESTABLISHED_RECORD_BYTES_BASELINE": 262272,
    "MAX_ESTABLISHED_RECORD_BYTES_HIGH": 262304,
    "MAX_CONTROL_RECORD_BYTES_BASELINE": 4096,
    "MAX_CONTROL_RECORD_BYTES_HIGH": 6144,
    "MAX_EVIDENCE_STATEMENTS": 32,
    "MAX_EVIDENCE_SIGNATURES": 4,
    "MAX_EVIDENCE_CHECKPOINT_BYTES": 8192,
    "MAX_SKIPPED_MESSAGE_KEYS_BASELINE": 256,
    "MAX_SKIPPED_MESSAGE_KEYS_HIGH": 128,
    "MAX_REPLAY_WINDOW_BASELINE": 512,
    "MAX_REPLAY_WINDOW_HIGH": 256,
    "MAX_PERSISTENT_STATE_BYTES_BASELINE": 2097152,
    "MAX_PERSISTENT_STATE_BYTES_HIGH": 8388608,
    "MAX_HEAP_BYTES_BASELINE": 67108864,
    "MAX_HEAP_BYTES_HIGH": 134217728,
    "MAX_STACK_BYTES_BASELINE": 1048576,
    "MAX_STACK_BYTES_HIGH": 2097152,
    "MAX_UNAUTHENTICATED_PARSE_BYTES_BASELINE": 32768,
    "MAX_UNAUTHENTICATED_PARSE_BYTES_HIGH": 65536,
    "MAX_UNAUTHENTICATED_SIGNATURE_HASH_OPS_BASELINE": 64,
    "MAX_UNAUTHENTICATED_SIGNATURE_HASH_OPS_HIGH": 128,
    "MAX_UNAUTHENTICATED_KEM_CANDIDATES_BASELINE": 64,
    "MAX_UNAUTHENTICATED_KEM_CANDIDATES_HIGH": 32,
    "MAX_PENDING_PQ_EPOCHS": 1,
    "MAX_HIGH_EPOCH_RECORDS": 64,
    "HIGH_EPOCH_ACTIVITY_SECONDS": 600,
    "MAX_COUNTER": 9223372036854775807
  },
  "relationships": [
    "MAX_PROFILES = 2",
    "MAX_CAPABILITY_PROFILES <= MAX_PROFILES",
    "MAX_ESTABLISHED_RECORD_BYTES_BASELINE = MAX_USER_PAYLOAD_BYTES + MAX_ESTABLISHED_RECORD_OVERHEAD_BYTES_BASELINE",
    "MAX_ESTABLISHED_RECORD_BYTES_HIGH = MAX_USER_PAYLOAD_BYTES + MAX_ESTABLISHED_RECORD_OVERHEAD_BYTES_HIGH",
    "MAX_PREKEYS_HIGH < MAX_PREKEYS_BASELINE",
    "MAX_REPLAY_WINDOW_HIGH < MAX_REPLAY_WINDOW_BASELINE",
    "MAX_SKIPPED_MESSAGE_KEYS_HIGH < MAX_SKIPPED_MESSAGE_KEYS_BASELINE",
    "MAX_PENDING_PQ_EPOCHS = 1",
    "HIGH_EPOCH_ACTIVITY_SECONDS = 600"
  ],
  "resetPolicy": "retry-reconnect-route-change-station-migration-never-raise-or-reset-a-bound",
  "attackerWorkPolicy": "parse-and-validate-before-allocation; work is bounded by profile limits"
}

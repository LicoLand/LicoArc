{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/bounds.json",
  "registryVersion": "licoarc.pairwise-protection-bounds.v1",
  "lifecycle": "Candidate",
  "scope": "stable-core-pairwise-protection-v1",
  "bounds": {
    "MAX_ACTIVE_PREKEY_PAIRS": 256,
    "MAX_ACTIVE_SESSIONS": 256,
    "MAX_COMMITTED_HANDSHAKE_REPLAY_BINDINGS": 256,
    "MAX_PREKEY_PAIR_SEQUENCE": 9007199254740991,
    "MAX_BUNDLE_VALIDITY_SPAN_SECONDS": 604800,
    "MAX_PREKEY_BUNDLE_BYTES": 4809,
    "MAX_FIRST_PACKET_BYTES": 9655,
    "MAX_SESSION_ACCEPT_BYTES": 221,
    "MAX_HANDSHAKE_BYTES": 32768,
    "MAX_RATCHET_HEADER_BYTES": 48,
    "MAX_RECORD_AAD_BYTES": 102,
    "MAX_PROTECTED_PACKET_BYTES": 524288,
    "MAX_PLAINTEXT_BYTES": 524224,
    "MAX_RATCHET_COUNTER": 4294967295,
    "MAX_SKIP_PER_RECORD": 256,
    "MAX_SKIPPED_KEYS": 1024,
    "MAX_RETRYABLE_PACKETS": 1,
    "MAX_DURABLE_INBOX_RECORDS_PER_COMMIT": 1,
    "MAX_STATE_GENERATION": 9007199254740991
  },
  "primitiveBytes": {
    "DIGEST256": 32,
    "X25519_PRIVATE_KEY": 32,
    "X25519_PUBLIC_KEY": 32,
    "X25519_SHARED_SECRET": 32,
    "ML_KEM_768_DK_SEED": 64,
    "ML_KEM_768_ENCAPSULATION_KEY": 1184,
    "ML_KEM_768_CIPHERTEXT": 1088,
    "ML_KEM_768_SHARED_SECRET": 32,
    "ED25519_SEED": 32,
    "ED25519_PUBLIC_KEY": 32,
    "ED25519_SIGNATURE": 64,
    "ML_DSA_65_SEED": 32,
    "ML_DSA_65_PUBLIC_KEY": 1952,
    "ML_DSA_65_SIGNATURE": 3309,
    "HKDF_SHA256_HASH": 32,
    "HMAC_SHA256_FULL": 32,
    "CHACHA20_POLY1305_KEY": 32,
    "CHACHA20_POLY1305_NONCE": 12,
    "CHACHA20_POLY1305_TAG": 16
  },
  "algorithmLimits": {
    "CHACHA20_POLY1305_MAX_PLAINTEXT_BYTES": 274877906880,
    "CHACHA20_POLY1305_MAX_AAD_BYTES": "18446744073709551615",
    "profilePlaintextLimit": "minimum-of-algorithm-limit-and-MAX_PLAINTEXT_BYTES",
    "profileAadLimit": "exactly-32-byte-session-context-digest-plus-canonical-ratchet-header"
  },
  "relationships": [
    "MAX_PLAINTEXT_BYTES + 64 = MAX_PROTECTED_PACKET_BYTES",
    "MAX_FIRST_PACKET_BYTES <= MAX_HANDSHAKE_BYTES",
    "MAX_RECORD_AAD_BYTES = 22 + DIGEST256 + MAX_RATCHET_HEADER_BYTES",
    "MAX_SKIP_PER_RECORD <= MAX_SKIPPED_KEYS",
    "MAX_COMMITTED_HANDSHAKE_REPLAY_BINDINGS = MAX_ACTIVE_SESSIONS",
    "MAX_RETRYABLE_PACKETS = 1",
    "MAX_DURABLE_INBOX_RECORDS_PER_COMMIT = 1",
    "MAX_PREKEY_PAIR_SEQUENCE <= MAX_STATE_GENERATION"
  ],
  "resetPolicy": "retry-reconnect-restart-route-change-station-migration-never-resets-or-extends-a-bound"
}

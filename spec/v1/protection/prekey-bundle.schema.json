{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/prekey-bundle.schema.json",
  "title": "Decoded Core v1 paired one-time prekey bundle",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "x25519": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mlKem768Ek": {"type": "string", "pattern": "^[0-9a-f]{2368}$"},
    "ed25519Signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "mlDsa65Signature": {"type": "string", "pattern": "^[0-9a-f]{6618}$"}
  },
  "type": "object", "additionalProperties": false,
  "required": ["protocolLineId", "protectionProfileId", "responderIdentityStateDigest", "ed25519KeyId", "mlDsa65KeyId", "pairSequence", "x25519PublicKey", "mlKem768EncapsulationKey", "validFrom", "validUntil", "ed25519Signature", "mlDsa65Signature"],
  "properties": {
    "protocolLineId": {"$ref": "#/$defs/digest"},
    "protectionProfileId": {"$ref": "#/$defs/digest"},
    "responderIdentityStateDigest": {"$ref": "#/$defs/digest"},
    "ed25519KeyId": {"$ref": "#/$defs/digest"},
    "mlDsa65KeyId": {"$ref": "#/$defs/digest"},
    "pairSequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "x25519PublicKey": {"$ref": "#/$defs/x25519"},
    "mlKem768EncapsulationKey": {"$ref": "#/$defs/mlKem768Ek"},
    "validFrom": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "validUntil": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "ed25519Signature": {"$ref": "#/$defs/ed25519Signature"},
    "mlDsa65Signature": {"$ref": "#/$defs/mlDsa65Signature"}
  }
}

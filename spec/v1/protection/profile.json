{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/profile.json",
  "profileSemanticVersion": "licoarc.stable-core-protection.v1",
  "profileLocator": "stable-core",
  "semanticSourceStatus": "COMPLETE",
  "definitionStatus": "PARTIAL",
  "admissionStatus": "source-specified-security-requalification-required",
  "contentIdentity": "abef93baec2b1a7ecdf67bb3783bc641c0c1be7f3696615462597f323e4b46b5",
  "indivisible": true,
  "componentNegotiation": false,
  "fallback": "forbidden",
  "authorityBinding": {
    "transcript": "initiator-and-responder-endpoint-state-digests-with-sibling-user-authority-state-digests",
    "authorityStateAcyclicity": "authority-snapshots-never-contain-peer-authority-digests",
    "applicationAdmission": "matching-independently-validated-protected-authority-payload-required",
    "localPeerTrust": "unchanged"
  },
  "semanticSources": {
    "algorithms": "spec/v1/protection/algorithms.json",
    "domains": "spec/v1/protection/domains.json",
    "labels": "spec/v1/protection/labels.json",
    "bounds": "spec/v1/protection/bounds.json",
    "state": "spec/v1/protection/state.json",
    "failures": "spec/v1/protection/failures.json",
    "runtimeGrammar": "spec/v1/protection/runtime.cddl",
    "prekeySchema": "spec/v1/protection/prekey-bundle.schema.json",
    "handshakeSchema": "spec/v1/protection/handshake.schema.json",
    "sessionAcceptSchema": "spec/v1/protection/session-accept.schema.json",
    "recordSchema": "spec/v1/protection/record.schema.json",
    "authorityVectors": "conformance/v1/protection/cases.json"
  },
  "contentIdentityProjection": {
    "include": [
      "profileSemanticVersion",
      "indivisible",
      "componentNegotiation",
      "fallback",
      "canonical semantic bytes of every semanticSources member except authority vectors",
      "stable claim identifiers",
      "stable nonclaim identifiers"
    ],
    "exclude": [
      "contentIdentity",
      "profile catalogs",
      "Protocol Line catalogs",
      "lifecycle",
      "publication state",
      "admissionStatus",
      "proof results",
      "formal bindings",
      "artifact or source digests",
      "external tool metadata"
    ],
    "algorithm": "SHA-256 over deterministic CBOR of the projection",
    "computationOwner": "final-authority-join"
  }
}

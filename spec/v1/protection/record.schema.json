{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/record.schema.json",
  "title": "Lico Arc Pairwise Protection established record",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordType", "sessionId", "epoch", "direction", "counter", "ciphertext"],
  "properties": {
    "recordType": { "const": "establishedRecord" },
    "sessionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "direction": { "enum": ["initiator-to-responder", "responder-to-initiator"] },
    "counter": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "ciphertext": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){16,262304}$" }
  }
}

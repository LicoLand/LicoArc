    { "class": "kem-invalid", "action": "reject", "stateMutation": "none", "terminal": true },
    { "class": "all-zero-shared-secret", "action": "reject", "stateMutation": "none", "terminal": true },
    { "class": "canonical-encoding", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "unknown-critical-value", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "length-bound", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "unauthenticated-work-bound", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "record-context-mismatch", "action": "reject", "stateMutation": "none", "terminal": true },
    { "class": "record-authentication", "action": "reject", "stateMutation": "none", "terminal": false },

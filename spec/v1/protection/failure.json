  "atomicity": {
    "validation": "complete-before-state-replacement",
    "rejectedInput": "never-advances-counter-window-chain-epoch-or-prekey-tombstone",
    "keyDeletion": "before-committing-replaced-root-chain-or-consumed-key",
    "terminal": "no-further-record-or-reset-acceptance",
    "retry": "same-valid-identity-and-bytes-may-be-observed-as-replay-only"
  },
  "retirement": {
    "handshake": "retired-profile",
    "activeSession": "terminal-session",
    "fallback": "forbidden",
    "translator": "forbidden"
  }

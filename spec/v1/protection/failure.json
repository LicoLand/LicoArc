    { "class": "line-mismatch", "action": "reject", "stateMutation": "none", "terminal": true },
    { "class": "profile-mismatch", "action": "reject", "stateMutation": "none", "terminal": true },
    { "class": "purpose-mismatch", "action": "reject", "stateMutation": "none", "terminal": true },
    { "class": "role-mismatch", "action": "reject", "stateMutation": "none", "terminal": true },

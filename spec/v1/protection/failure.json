    { "class": "skipped-bound-exceeded", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "epoch-gap", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "epoch-duplicate", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "epoch-stale", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "epoch-out-of-order", "action": "reject", "stateMutation": "none", "terminal": false },
    { "class": "epoch-cadence", "action": "reject", "stateMutation": "none", "terminal": false },

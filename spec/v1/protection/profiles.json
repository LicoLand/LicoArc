      },
      "record": {
        "outerFields": ["recordType", "sessionId", "epoch", "direction", "counter", "ciphertext"],
        "innerProjection": ["senderEndpointIdentityRef", "recordType", "userPayload"],
        "senderIdentityOuterVisibility": "never",
        "associatedData": ["protocolLineId", "protectionProfileId", "sessionId", "epoch", "direction", "counter", "canonicalRecordHeader"],
        "nonceField": "forbidden-derived-from-chain-counter-direction",

        "expandLabels": ["LicoArc/Base/Root", "LicoArc/Base/Send", "LicoArc/Base/Receive"],
        "recordKey": "HKDF-Expand(chainSecret, length-prefixed(counter || direction), 32)",
        "recordNonce": "HKDF-Expand(chainSecret, length-prefixed(counter || direction), 12)",

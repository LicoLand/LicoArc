      "authentication": {
        "identityKeyAlgorithms": ["Ed25519", "ML-DSA-87"],
        "signatureCount": 2,
        "signatures": [
          {
            "algorithm": "Ed25519",
            "purpose": "identity",
            "context": "LicoArc-High-Identity"
          },
          {
            "algorithm": "ML-DSA-87",
            "purpose": "transcript",
            "context": "LicoArc-High-Transcript"
          }
        ],
        "exactSet": true,
        "missingOrDuplicate": "reject"
      },
      "transcript": {
        "domain": "LP-HIGH-TRANSCRIPT\u0000",
        "digest": "SHA-256",
        "encoding": "deterministic-cbor",
        "orderedFields": [
          "domain",
          "protocolLineId",
          "protectionProfileId",
          "handshakePurpose",
          "initiatorRole",
          "responderRole",
          "initiatorEndpointIdentityRef",
          "responderEndpointIdentityRef",
          "initiatorCapabilityDeclaration",
          "responderCapabilityDeclaration",
          "responderPrekeyBundle",
          "responderSignedPrekeyId",
          "responderOneTimePrekeyId",
          "initiatorEphemeralX25519PublicKey",
          "responderMlKemPublicKey",
          "initiatorMlKemCiphertext",
          "roleBytes"
        ],
        "authenticatedOnce": true,
        "establishedRepetition": "reject"
      },
      "keySchedule": {
        "extract": "HKDF-Extract(SHA-256, zero-salt-32-octets, X25519 || ML-KEM-1024 || transcriptDigest)",
        "rootEvolution": "HKDF-Extract(SHA-256, zero-salt-32-octets, classicalChain || x25519Secret || pqChain || transcriptDigest)",
        "expandLabels": ["LicoArc/High/Classical", "LicoArc/High/Rekey", "LicoArc/High/PQ"],
        "recordKey": "HKDF-Expand(chainSecret, length-prefixed(counter || direction || epoch), 32)",
        "recordNonce": "HKDF-Expand(chainSecret, length-prefixed(counter || direction || epoch), 12)",
        "aead": "ChaCha20-Poly1305",
        "nonceReuse": "reject-and-terminal"
      },
      "ratchet": {
        "kind": "TripleRatchet",
        "chains": ["classical-symmetric", "classical-x25519-rekey", "post-quantum-ml-kem-braid"],
        "recordAdvance": "one-direction-chain-step-per-valid-record",
        "pqEpochAdvance": "after-64-records-or-600-seconds-of-endpoint-activity-whichever-first",
        "maxPendingEpochs": 1,
        "epochTransition": "all-or-nothing",
        "reset": "new-authenticated-handshake-required",
        "deletion": "erase-consumed-message-keys-old-chains-decapsulation-secrets-before-commit"
      },
      "record": {
        "outerFields": ["recordType", "sessionId", "epoch", "direction", "counter", "ciphertext"],
        "innerProjection": ["senderEndpointIdentityRef", "recordType", "userPayload"],
        "senderIdentityOuterVisibility": "never",
        "associatedData": ["protocolLineId", "protectionProfileId", "sessionId", "epoch", "direction", "counter", "canonicalRecordHeader"],
        "nonceField": "forbidden-derived-from-chain-counter-direction-epoch",
        "profileField": "forbidden-after-establishment",
        "capabilityField": "forbidden-after-establishment",
        "endpointIdentityField": "forbidden-after-establishment"
      },
      "boundsRef": "high",
      "failurePolicyRef": "spec/v1/protection/failure.json"
    },

      "establishment": {
        "construction": "asynchronous-prekey-hybrid",
        "classicalKeyAgreement": "X25519",
        "postQuantumKeyEncapsulation": "ML-KEM-1024",
        "sharedSecretOrder": ["X25519", "ML-KEM-1024"],
        "signedPrekeyAlgorithm": "Ed25519",
        "oneTimePrekeyAlgorithm": "X25519",
        "maxOneTimePrekeys": 32,
        "oneTimePrekeyConsumption": "at-most-one-per-authenticated-handshake",
        "allZeroSharedSecret": "reject",
        "kemFailure": "reject-without-state-advance"

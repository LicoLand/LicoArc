      },
      "transcript": {
        "domain": "LP-BASE-TRANSCRIPT\u0000",
        "digest": "SHA-256",
        "encoding": "deterministic-cbor",
        "orderedFields": [
          "domain",
          "protocolLineId",
          "protectionProfileId",
          "handshakePurpose",
          "initiatorRole",
          "responderRole",

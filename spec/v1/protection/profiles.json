{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/profiles.json",
  "registryVersion": "licoarc.cryptographic-profile-registry.v1",
  "lifecycle": "Candidate",
  "scope": "complete-indivisible-pairwise-protection-profiles",
  "profileIdDerivation": "sha256(UTF8('LicoArc/Protection/Profile/v1/' + profileName + NUL))",
  "profiles": [
    {

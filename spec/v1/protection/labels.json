{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/labels.json",
  "registryVersion": "licoarc.protection-labels.v1",
  "lifecycle": "Candidate",
  "scope": "pairwise-protection-runtime-labels",
  "wireEncoding": "deterministic-cbor-unsigned-integer-labels",
  "unknownLabelPolicy": "reject-record",
  "duplicateLabelPolicy": "reject-record",
  "trailingBytePolicy": "reject-record",
  "indefiniteLengthPolicy": "reject-record",
  "capability": [
    { "name": "recordType", "label": 0, "presence": "mandatory", "type": "CapabilityRecordType" },
    { "name": "protocolLineId", "label": 1, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "endpointIdentityRef", "label": 2, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "supportedProtectionProfiles", "label": 3, "presence": "mandatory", "type": "DIGEST256[]" },
    { "name": "minimumProtectionProfile", "label": 4, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "capabilityEpoch", "label": 5, "presence": "mandatory", "type": "uint64" },
    { "name": "validFrom", "label": 6, "presence": "mandatory", "type": "uint64" },
    { "name": "validUntil", "label": 7, "presence": "mandatory", "type": "uint64" },
    { "name": "declarationNonce", "label": 8, "presence": "mandatory", "type": "TOKEN256" },
    { "name": "signature", "label": 9, "presence": "mandatory", "type": "Signature" }
  ],
  "handshake": [
    { "name": "recordType", "label": 0, "presence": "mandatory", "type": "HandshakeRecordType" },
    { "name": "handshakeId", "label": 1, "presence": "mandatory", "type": "ID128" },
    { "name": "protocolLineId", "label": 2, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "protectionProfileId", "label": 3, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "handshakePurpose", "label": 4, "presence": "mandatory", "type": "Purpose" },
    { "name": "initiatorRole", "label": 5, "presence": "mandatory", "type": "Role" },
    { "name": "responderRole", "label": 6, "presence": "mandatory", "type": "Role" },
    { "name": "initiatorEndpointIdentityRef", "label": 7, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "responderEndpointIdentityRef", "label": 8, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "initiatorCapabilityDigest", "label": 9, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "responderCapabilityDigest", "label": 10, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "responderSignedPrekeyId", "label": 11, "presence": "mandatory", "type": "ID128" },
    { "name": "responderOneTimePrekeyId", "label": 12, "presence": "conditional", "type": "ID128" },
    { "name": "initiatorEphemeralX25519PublicKey", "label": 13, "presence": "mandatory", "type": "BYTES32" },
    { "name": "responderMlKemPublicKey", "label": 14, "presence": "mandatory", "type": "ProfileSizedBytes" },
    { "name": "initiatorMlKemCiphertext", "label": 15, "presence": "mandatory", "type": "ProfileSizedBytes" },
    { "name": "transcriptDigest", "label": 16, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "signatures", "label": 17, "presence": "mandatory", "type": "Signature[]" },
    { "name": "initiatorCapabilityDeclaration", "label": 18, "presence": "mandatory", "type": "CapabilityDeclaration" },
    { "name": "responderCapabilityDeclaration", "label": 19, "presence": "mandatory", "type": "CapabilityDeclaration" },
    { "name": "responderPrekeyBundle", "label": 20, "presence": "mandatory", "type": "PrekeyBundle" }
  ],
  "establishedRecord": [
    { "name": "recordType", "label": 0, "presence": "mandatory", "type": "EstablishedRecordType" },
    { "name": "sessionId", "label": 1, "presence": "mandatory", "type": "ID128" },
    { "name": "epoch", "label": 2, "presence": "mandatory", "type": "uint64" },
    { "name": "direction", "label": 3, "presence": "mandatory", "type": "Direction" },
    { "name": "counter", "label": 4, "presence": "mandatory", "type": "uint64" },
    { "name": "ciphertext", "label": 5, "presence": "mandatory", "type": "bstr" }
  ],
  "pqEpoch": [
    { "name": "recordType", "label": 0, "presence": "mandatory", "type": "EpochRecordType" },
    { "name": "sessionId", "label": 1, "presence": "mandatory", "type": "ID128" },
    { "name": "epoch", "label": 2, "presence": "mandatory", "type": "uint64" },
    { "name": "previousEpochDigest", "label": 3, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "x25519RekeyPublicKey", "label": 4, "presence": "mandatory", "type": "BYTES32" },
    { "name": "mlKemCiphertext", "label": 5, "presence": "mandatory", "type": "ProfileSizedBytes" },
    { "name": "transcriptDigest", "label": 6, "presence": "mandatory", "type": "DIGEST256" },
    { "name": "signature", "label": 7, "presence": "mandatory", "type": "Signature" }
  ],
  "recordTypes": {
    "capability": 0,
    "handshake": 1,
    "established": 2,
    "pqEpoch": 3,
    "prekeyBundle": 4
  },
  "directions": { "initiatorToResponder": 0, "responderToInitiator": 1 },
  "roles": { "initiator": 0, "responder": 1 },
  "purposes": { "pairing": 0, "reconnect": 1, "rekey": 2 }
}

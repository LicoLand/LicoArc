; Lico Arc Protocol v1 Pairwise Protection runtime grammar.
; Runtime values are deterministic definite-length CBOR maps with unsigned
; integer labels. Governance JSON names are projections and never appear as
; runtime text. Unknown labels are rejected; duplicate labels, tags, floating-point values,
; indefinite lengths, non-canonical integers, and trailing bytes are rejected.

protection-record = capability-declaration / handshake / established-record /
                    pq-epoch

capability-declaration = {
  0 => 0,                            ; recordType capabilityDeclaration
  1 => digest256,                    ; protocolLineId
  2 => digest256,                    ; endpointIdentityRef
  3 => [digest256],                  ; 1..MAX_CAPABILITY_PROFILES, unique
  4 => digest256,                    ; minimumProtectionProfile
  5 => epoch,                        ; capabilityEpoch
  6 => unix-seconds,                 ; validFrom
  7 => unix-seconds,                 ; validUntil, > validFrom
  8 => token256,                     ; declarationNonce
  9 => capability-signature
}

capability-signature = {
  0 => 0,                            ; algorithm Ed25519
  1 => 0,                            ; purpose capability-declaration
  2 => id128,                        ; keyId
  3 => bytes .size 64               ; signature value
}

handshake = {
  0 => 1,                            ; recordType handshake
  1 => id128,                        ; handshakeId
  2 => digest256,                    ; protocolLineId
  3 => digest256,                    ; protectionProfileId
  4 => uint .between 0 2,           ; purpose pairing/reconnect/rekey
  5 => 0,                            ; initiatorRole
  6 => 1,                            ; responderRole
  7 => digest256,                    ; initiatorEndpointIdentityRef
  8 => digest256,                    ; responderEndpointIdentityRef
  9 => digest256,                    ; initiatorCapabilityDigest
  10 => digest256,                   ; responderCapabilityDigest
  11 => id128,                       ; responderSignedPrekeyId
  ? 12 => id128,                     ; responderOneTimePrekeyId
  13 => bytes .size 32,              ; initiatorEphemeralX25519PublicKey
  14 => bstr,                        ; profile-sized ML-KEM public key
  15 => bstr,                        ; profile-sized ML-KEM ciphertext
  16 => digest256,                   ; transcriptDigest
  17 => [signature],                 ; exactly profile signature set
  18 => capability-declaration,      ; signed initiator declaration bytes
  19 => capability-declaration,      ; signed responder declaration bytes
  20 => prekey-bundle                ; responder prekey declaration
}

prekey-bundle = {
  0 => 4,                            ; recordType prekeyBundle
  1 => bytes .size 32,               ; Ed25519 identity public key
  2 => bstr,                         ; Profile-specific ML-DSA identity key
  3 => signed-prekey,
  4 => [* one-time-prekey],           ; <= 64 baseline / <= 32 high
  5 => bstr                          ; Profile-specific ML-KEM public key
}

signed-prekey = {
  0 => id128,
  1 => bytes .size 32,
  2 => bytes .size 64                ; Ed25519 signature over the prekey
}

one-time-prekey = {
  0 => id128,
  1 => bytes .size 32
}

signature = {
  0 => uint,                         ; profile-closed algorithm value
  1 => uint,                         ; identity/transcript purpose value
  2 => uint,                         ; profile-closed context value
  3 => id128,                         ; keyId
  4 => bstr                          ; profile-sized signature value
}

established-record = {
  0 => 2,                            ; recordType establishedRecord
  1 => id128,                        ; sessionId
  2 => epoch,                        ; baseline must be zero
  3 => uint .between 0 1,           ; direction
  4 => uint .between 0 9223372036854775807, ; counter
  5 => bstr                          ; ciphertext, <= profile record bound
}

pq-epoch = {
  0 => 3,                            ; recordType pqEpoch, high only
  1 => id128,                        ; sessionId
  2 => epoch,                        ; currentEpoch + 1
  3 => digest256,                    ; previousEpochDigest
  4 => bytes .size 32,               ; x25519RekeyPublicKey
  5 => bstr,                         ; ML-KEM-1024 ciphertext, 1568 octets
  6 => digest256,                    ; transcriptDigest
  7 => signature                      ; ML-DSA-87 epoch-transition signature
}

digest256 = bytes .size 32
token256 = bytes .size 32
id128 = bytes .size 16
epoch = uint .between 0 9007199254740991
unix-seconds = uint .between 0 9007199254740991

; Profile-specific cross-field rules:
; - exactly one complete profile is selected from the closed registry.
; - both capability declarations, both capability digests, roles, endpoint
;   identities, purpose, line, selected profile, key material, and role bytes
;   are canonicalized in the ordered transcript before signatures verify.
; - no component algorithm, Provider identifier, or fallback field exists.
; - stable handshake fields are inherited by established records; repetition
;   or mismatch is terminal stable-field-repetition/record-context-mismatch.
; - baseline uses ML-KEM-768, two signatures, DoubleRatchet, epoch zero,
;   MAX_SKIPPED_MESSAGE_KEYS=256, and MAX_REPLAY_WINDOW=512.
; - high uses ML-KEM-1024, Ed25519+ML-DSA-87, TripleRatchet, a single pending
;   PQ epoch, and the 64-record/600-second cadence.
; - every valid record derives its key and nonce from its chain and counter;
;   ciphertext authentication precedes chain advancement and key deletion.

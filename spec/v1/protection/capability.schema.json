{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/protection/capability.schema.json",
  "title": "Lico Arc Pairwise Protection capability declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "protocolLineId",
    "endpointIdentityRef",
    "supportedProtectionProfiles",
    "minimumProtectionProfile",
    "capabilityEpoch",
    "validFrom",
    "validUntil",
    "declarationNonce",
    "signature"
  ],
  "properties": {
    "recordType": { "const": "capabilityDeclaration" },
    "protocolLineId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "endpointIdentityRef": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "supportedProtectionProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "minimumProtectionProfile": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capabilityEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "validFrom": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "validUntil": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "declarationNonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "purpose", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "purpose": { "const": "capability-declaration" },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  }
}

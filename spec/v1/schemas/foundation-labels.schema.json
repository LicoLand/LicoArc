{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/schemas/foundation-labels.schema.json",
  "title": "LicoArc foundation runtime labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "registryVersion",
    "lifecycle",
    "scope",
    "keyEncoding",
    "unknownLabelPolicy",
    "duplicateLabelPolicy",
    "labels"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "const": "https://licoarc.com/spec/v1/schemas/foundation-labels.schema.json"
    },
    "registryVersion": {
      "type": "string",
      "const": "licoarc.foundation-labels.v1"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "Candidate",
        "Published",
        "Retired"
      ]
    },
    "scope": {
      "type": "string",
      "const": "foundation-runtime-record-only"
    },
    "keyEncoding": {
      "type": "string",
      "const": "compact-unsigned-integer"
    },
    "unknownLabelPolicy": {
      "type": "string",
      "const": "reject"
    },
    "duplicateLabelPolicy": {
      "type": "string",
      "const": "reject"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 128
          },
          "label": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/schemas/foundation-identifiers.schema.json",
  "title": "LicoArc foundation identifier registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "registryVersion", "lifecycle", "scope", "unknownPolicy", "retiredPolicy", "identifierSyntax", "identifiers"],
  "properties": {
    "$schema": { "type": "string", "const": "https://json-schema.org/draft/2020-12/schema" },
    "$id": { "type": "string", "const": "https://licoarc.com/spec/v1/schemas/foundation-identifiers.schema.json" },
    "registryVersion": { "type": "string", "const": "licoarc.foundation-identifiers.v1" },
    "lifecycle": { "type": "string", "enum": ["Candidate", "Published", "Retired"] },
    "scope": { "type": "string", "const": "foundation-contract-identifiers-only" },
    "unknownPolicy": { "type": "string", "const": "reject" },
    "retiredPolicy": { "type": "string", "const": "reject" },
    "identifierSyntax": { "type": "string", "const": "licoarc.<scope>.<name>.v<positive-integer>" },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "kind", "wire", "status"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "maxLength": 128 },
          "value": { "type": "string", "pattern": "^licoarc\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)?\\.v[1-9][0-9]*$", "maxLength": 128 },
          "kind": { "type": "string", "enum": ["source-contract", "composition-contract", "encoding-contract"] },
          "wire": { "type": "boolean", "const": false },
          "status": { "type": "string", "enum": ["Candidate", "Published", "Retired"] }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/schemas/foundation-lifecycle.schema.json",
  "title": "LicoArc foundation lifecycle registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "registryVersion", "lifecycle", "scope", "unknownStatePolicy", "states", "transitions", "publishedBytes", "unknownTransitionPolicy", "mixedLifecyclePolicy", "downgradePolicy"],
  "properties": {
    "$schema": { "type": "string", "const": "https://json-schema.org/draft/2020-12/schema" },
    "$id": { "type": "string", "const": "https://licoarc.com/spec/v1/schemas/foundation-lifecycle.schema.json" },
    "registryVersion": { "type": "string", "const": "licoarc.foundation-lifecycle.v1" },
    "lifecycle": { "type": "string", "enum": ["Candidate", "Published", "Retired"] },
    "scope": { "type": "string", "const": "protocol-line-and-source-lifecycle" },
    "unknownStatePolicy": { "type": "string", "const": "reject" },
    "states": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mutable", "published", "terminal"],
        "properties": {
          "id": { "type": "string", "enum": ["Draft", "Candidate", "Published", "Retired"] },
          "mutable": { "type": "boolean" },
          "published": { "type": "boolean" },
          "terminal": { "type": "boolean" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "requires"],
        "properties": {
          "from": { "type": "string", "enum": ["Draft", "Candidate", "Published", "Retired"] },
          "to": { "type": "string", "enum": ["Draft", "Candidate", "Published", "Retired"] },
          "requires": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "publishedBytes": { "type": "string", "const": "immutable-and-verifiable" },
    "unknownTransitionPolicy": { "type": "string", "const": "reject" },
    "mixedLifecyclePolicy": { "type": "string", "const": "reject" },
    "downgradePolicy": { "type": "string", "const": "reject" }
  }
}

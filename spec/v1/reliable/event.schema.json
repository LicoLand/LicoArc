{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/reliable/event.schema.json",
  "title": "Lico Arc Reliable Exchange event semantic projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordType", "eventKind", "logicalMessageId", "intentDigest"],
  "properties": {
    "recordType": { "type": "string", "const": "reliableEvent" },
    "eventKind": {
      "type": "string",
      "enum": [
        "create", "send", "retry", "stationHint", "endpointAccepted",
        "effectCompleted", "cancel", "timeout", "routeChange",
        "attachmentState", "groupResult", "terminalFailure"
      ]
    },
    "logicalMessageId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "intentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "routeEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "protectedPacket": { "type": "string", "pattern": "^[0-9a-f]{2,524288}$" },
    "protectedPacketDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "applicationResultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "failureCode": { "type": "integer", "minimum": 0, "maximum": 12 },
    "stationOutcome": { "type": "string", "enum": ["accepted", "rejected", "transient", "ambiguous"] },
    "confirmationId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attachmentId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "recoveryRound": { "type": "integer", "minimum": 0, "maximum": 32 },
    "requestedChunkRanges": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startChunkIndex", "endChunkIndexExclusive"],
        "properties": {
          "startChunkIndex": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "endChunkIndexExclusive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    "projectionResults": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectionId", "recipientEndpointRef", "outcome"],
        "properties": {
          "projectionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "recipientEndpointRef": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "outcome": { "type": "string", "enum": ["pending", "delivered", "rejected", "failed"] },
          "failureCode": { "type": "integer", "minimum": 0, "maximum": 12 },
          "authority": { "type": "string", "enum": ["endpoint-evidence", "none"] }
        }
      }
    }
  }
}

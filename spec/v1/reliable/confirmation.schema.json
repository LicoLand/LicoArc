{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/reliable/confirmation.schema.json",
  "title": "Lico Arc Reliable Exchange endpoint confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmationId", "stage", "outcome", "confirmedMessageIds"],
  "properties": {
    "confirmationId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "stage": { "type": "string", "enum": ["endpointAccepted", "effectCompleted"] },
    "outcome": { "type": "string", "enum": ["succeeded", "rejected", "failed"] },
    "confirmedMessageIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
    },
    "failureCode": { "type": "integer", "minimum": 0, "maximum": 13 },
    "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "succeeded" } }, "required": ["outcome"] },
      "then": { "not": { "required": ["failureCode"] } }
    }
  ]
}

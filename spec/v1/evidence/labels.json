{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/evidence/labels.json",
  "registryVersion": "licoarc.transferable-evidence-labels.v1",
  "lifecycle": "Candidate",
  "statement": [
    { "label": 0, "name": "statementKind", "type": "uint", "presence": "mandatory" },
    { "label": 1, "name": "protocolLineId", "type": "digest256", "presence": "mandatory" },
    { "label": 2, "name": "authorEndpointRef", "type": "digest256", "presence": "mandatory" },
    { "label": 3, "name": "counterpartyEndpointRef", "type": "digest256", "presence": "mandatory" },
    { "label": 4, "name": "identityStateDigest", "type": "digest256", "presence": "mandatory" },
    { "label": 5, "name": "logicalMessageId", "type": "id128", "presence": "mandatory" },
    { "label": 6, "name": "semanticBody", "type": "bytes", "presence": "mandatory" },
    { "label": 7, "name": "userPayload", "type": "bytes", "presence": "mandatory" },
    { "label": 8, "name": "predecessorDigest", "type": "digest256", "presence": "optional" },
    { "label": 9, "name": "attachmentId", "type": "id128", "presence": "optional" },
    { "label": 10, "name": "contentDigest", "type": "digest256", "presence": "optional" }
  ],
  "checkpoint": [
    { "label": 0, "name": "protocolLineId", "type": "digest256", "presence": "mandatory" },
    { "label": 1, "name": "signerEndpointRef", "type": "digest256", "presence": "mandatory" },
    { "label": 2, "name": "counterpartyEndpointRef", "type": "digest256", "presence": "mandatory" },
    { "label": 3, "name": "identityStateDigest", "type": "digest256", "presence": "mandatory" },
    { "label": 4, "name": "statementDigests", "type": "digest256[]", "presence": "mandatory" },
    { "label": 5, "name": "signatures", "type": "signature[]", "presence": "mandatory" }
  ],
  "signature": [
    { "label": 0, "name": "algorithm", "type": "uint", "presence": "mandatory" },
    { "label": 1, "name": "keyId", "type": "id128", "presence": "mandatory" },
    { "label": 2, "name": "purpose", "type": "uint", "presence": "mandatory" },
    { "label": 3, "name": "value", "type": "bytes", "presence": "mandatory" }
  ],
  "identityKey": [
    { "label": 0, "name": "keyId", "type": "id128", "presence": "mandatory" },
    { "label": 1, "name": "purpose", "type": "uint", "presence": "mandatory" },
    { "label": 2, "name": "state", "type": "uint", "presence": "mandatory" },
    { "label": 3, "name": "keyDigest", "type": "digest256", "presence": "mandatory" }
  ],
  "statementKinds": [
    { "value": 0, "name": "userIntent" },
    { "value": 1, "name": "endpointAccepted" },
    { "value": 2, "name": "effectCompleted" },
    { "value": 3, "name": "attachmentDeclared" },
    { "value": 4, "name": "attachmentVerified" },
    { "value": 5, "name": "groupMemberResult" },
    { "value": 6, "name": "confirmation" }
  ],
  "signatureAlgorithms": [
    { "value": 0, "name": "Ed25519" },
    { "value": 1, "name": "ML-DSA-65" }
  ],
  "signaturePurposes": [
    { "value": 0, "name": "endpoint-evidence" }
  ],
  "identityKeyStates": [
    { "value": 0, "name": "active" },
    { "value": 1, "name": "revoked" },
    { "value": 2, "name": "recovery" }
  ],
  "failureCodes": [
    { "value": 0, "name": "malformed" },
    { "value": 1, "name": "unknownProtocolLine" },
    { "value": 2, "name": "statementMismatch" },
    { "value": 3, "name": "identityMismatch" },
    { "value": 4, "name": "nonCanonicalSet" },
    { "value": 5, "name": "unknownSignature" },
    { "value": 6, "name": "missingSignature" },
    { "value": 7, "name": "surplusSignature" },
    { "value": 8, "name": "wrongPurpose" },
    { "value": 9, "name": "invalidSignature" },
    { "value": 10, "name": "identityRollback" },
    { "value": 11, "name": "identityFork" },
    { "value": 12, "name": "pendingExhausted" },
    { "value": 13, "name": "pendingExpired" },
    { "value": 14, "name": "checkpointBoundExceeded" },
    { "value": 15, "name": "recursiveCheckpoint" }
  ]
}

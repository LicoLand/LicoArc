{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/evidence/registry.json",
  "registryVersion": "licoarc.transferable-evidence.v1",
  "wireId": "licoarc.evidence.v1",
  "protocolLineIdType": "DIGEST256-line-content-identity",
  "lifecycle": "Candidate",
  "scope": "transferable-evidence-checkpoint-v1",
  "sourcePaths": {
    "bounds": "spec/v1/evidence/bounds.json",
    "labels": "spec/v1/evidence/labels.json",
    "statementSchema": "spec/v1/evidence/statement.schema.json",
    "checkpointSchema": "spec/v1/evidence/checkpoint.schema.json",
    "identityBundleSchema": "spec/v1/evidence/identity-bundle.schema.json",
    "runtime": "spec/v1/evidence/runtime.cddl",
    "sourceManifest": "spec/v1/evidence/source-manifest.json",
    "conformanceManifest": "conformance/v1/evidence/manifest.json"
  },
  "representation": {
    "governance": "restricted-jcs-json",
    "runtime": "deterministic-cbor",
    "mapKeyEncoding": "compact-unsigned-integer",
    "lengthEncoding": "definite",
    "rawBytes": "bstr",
    "tags": "forbidden",
    "floats": "forbidden",
    "indefiniteLengths": "forbidden",
    "duplicateLabels": "reject",
    "unknownCoreLabels": "reject",
    "trailingBytes": "reject"
  },
  "algorithm": {
    "statementDomain": "LP-EVIDENCE-STATEMENT\u0000",
    "checkpointDomain": "LP-EVIDENCE-CHECKPOINT\u0000",
    "digest": "SHA-256",
    "canonicalProjection": "deterministic-cbor",
    "baselineSignatureProfileIds": [
      "176b912b9547ca9c47ace10f881457ab63fcd493ef953616f5859e76b830fd60",
      "427e788bb9aed076acc2fb5a94715d14e694ec5fbc846ac52c8c7e118a6b1b8f"
    ],
    "signaturePurpose": "endpoint-evidence",
    "signatureProfileAuthority": "spec/v1/identity/signature-profiles.json",
    "signatureOrder": "baselineSignatureProfileIds-order",
    "signatureCount": 2
  },
  "verification": {
    "identityStateBinding": "checkpoint identityStateDigest selects exactly one state in the supplied continuity bundle",
    "continuity": "validate genesis then every exact epoch-plus-one predecessor-bound successor through the selected state",
    "continuityKeyPurpose": "identity",
    "keyResolution": "resolve keyId only within the selected identity state",
    "keyPurpose": "evidence",
    "keyState": "active",
    "profileMatch": "signature keyProfileId equals resolved key keyProfileId and the required ordered profile",
    "publicKey": "exact raw bytes and canonical encoding required by the signature Profile",
    "signature": "exact length and canonical encoding required by the signature Profile",
    "validationOrder": [
      "closed-canonical-record",
      "protocol-line-and-endpoint-binding",
      "identity-continuity-through-selected-state",
      "key-id-resolution-in-selected-state",
      "evidence-purpose",
      "active-key-state",
      "required-profile-and-order",
      "exact-public-key-length-and-canonical-encoding",
      "exact-signature-length-and-canonical-encoding",
      "cryptographic-verification"
    ],
    "failureMutation": "none"
  },
  "attribution": {
    "proves": "exact-statement-by-authorized-endpoint-key-state",
    "requires": ["statement", "checkpoint", "identity-continuity-bundle"],
    "excludes": [
      "human-intent",
      "statement-truth",
      "trusted-time",
      "legal-responsibility",
      "uncompromised-key-custody",
      "counterparty-cooperation",
      "station-honesty",
      "guaranteed-delivery"
    ]
  },
  "join": {
    "ordering": "statement-or-checkpoint-either-first",
    "finality": "both-valid-statement-and-checkpoint-before-delivery-or-peer-state-advance",
    "pending": "bounded-count-bytes-window",
    "orphan": "retained-pending-only",
    "loss": "retransmit-identical-signed-checkpoint",
    "unsignedFallback": "forbidden",
    "recursiveSelfReference": "forbidden",
    "atomicity": "validate-all-then-commit-one-snapshot"
  },
  "observerPolicy": {
    "station": "no-plaintext-statement-or-checkpoint-meaning-after-protection",
    "independentVerifier": "sees-disclosed-package-only",
    "endpoint": "owns-identity-key-custody-and-final-disclosure"
  },
  "outOfScope": [
    "human-or-legal-nonrepudiation",
    "trusted-wall-clock",
    "key-custody-guarantee",
    "application-truth",
    "station-generated-evidence",
    "unsigned-tail-fallback",
    "per-chunk-signatures",
    "recursive-checkpoints"
  ]
}

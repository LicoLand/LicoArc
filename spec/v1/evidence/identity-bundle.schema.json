{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/evidence/identity-bundle.schema.json",
  "title": "Lico Arc bounded Endpoint identity continuity evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordType", "endpointIdentityRef", "states"],
  "properties": {
    "recordType": { "type": "string", "const": "evidenceIdentityBundle" },
    "endpointIdentityRef": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identityStateDigest", "epoch", "predecessorDigest", "keys"],
        "properties": {
          "identityStateDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "predecessorDigest": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["keyId", "purpose", "state", "keyDigest"],
              "properties": {
                "keyId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                "purpose": { "type": "string", "const": "endpoint-evidence" },
                "state": { "type": "string", "enum": ["active", "revoked", "recovery"] },
                "keyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}

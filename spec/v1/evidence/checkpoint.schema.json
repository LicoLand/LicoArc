{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/evidence/checkpoint.schema.json",
  "title": "Lico Arc Evidence Checkpoint semantic projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "protocolLineId",
    "signerEndpointRef",
    "counterpartyEndpointRef",
    "identityStateDigest",
    "statementDigests",
    "signatures"
  ],
  "$defs": {
    "ed25519Signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyProfileId", "keyId", "purpose", "value"],
      "properties": {
        "keyProfileId": { "const": "176b912b9547ca9c47ace10f881457ab63fcd493ef953616f5859e76b830fd60" },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "purpose": { "const": "endpoint-evidence" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "mlDsa65Signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyProfileId", "keyId", "purpose", "value"],
      "properties": {
        "keyProfileId": { "const": "427e788bb9aed076acc2fb5a94715d14e694ec5fbc846ac52c8c7e118a6b1b8f" },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "purpose": { "const": "endpoint-evidence" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{6618}$" }
      }
    }
  },
  "properties": {
    "recordType": { "type": "string", "const": "evidenceCheckpoint" },
    "protocolLineId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signerEndpointRef": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counterpartyEndpointRef": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identityStateDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "statementDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/ed25519Signature" },
        { "$ref": "#/$defs/mlDsa65Signature" }
      ],
      "items": false
    }
  }
}

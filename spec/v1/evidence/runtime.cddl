; Lico Arc Transferable Evidence Checkpoint v1 deterministic-CBOR grammar.
; Every collection is bounded and every signature Profile fixes exact raw
; public-key and signature lengths. Unknown labels, Profiles, purposes,
; duplicate keys, indefinite lengths, and non-canonical encodings fail closed.

evidence-record = transferable-statement / evidence-checkpoint

transferable-statement = {
  0 => uint .le 6,
  1 => digest256,
  2 => digest256,
  3 => digest256,
  4 => digest256,
  5 => id128,
  6 => bstr .size (1..262144),
  7 => bstr .size (0..262144),
  ? 8 => digest256,
  ? 9 => id128,
  ? 10 => digest256
}

evidence-checkpoint = {
  0 => digest256,
  1 => digest256,
  2 => digest256,
  3 => digest256,
  4 => [1*32 digest256],
  5 => [ed25519-evidence-signature, ml-dsa-65-evidence-signature]
}

verification-package = {
  0 => transferable-statement,
  1 => evidence-checkpoint,
  2 => identity-continuity-bundle
}

signature = ed25519-signature / ml-dsa-65-signature
ed25519-signature = {
  0 => ed25519-profile-id,
  1 => digest256,
  2 => uint .le 1,
  3 => bstr .size 64
}
ml-dsa-65-signature = {
  0 => ml-dsa-65-profile-id,
  1 => digest256,
  2 => uint .le 1,
  3 => bstr .size 3309
}
ed25519-evidence-signature = {
  0 => ed25519-profile-id,
  1 => digest256,
  2 => 1,
  3 => bstr .size 64
}
ml-dsa-65-evidence-signature = {
  0 => ml-dsa-65-profile-id,
  1 => digest256,
  2 => 1,
  3 => bstr .size 3309
}

identity-continuity-bundle = {
  0 => digest256,
  1 => [1*64 identity-state]
}

identity-state = {
  0 => digest256,
  1 => epoch,
  2 => digest256 / null,
  3 => uint .le 3,
  4 => digest256,
  5 => [1*4 identity-key],
  ? 6 => [1*4 digest256],
  ? 7 => recovery-proof,
  8 => continuity-proof,
  9 => endpoint-continuity-signature
}

identity-key = ed25519-identity-key / ml-dsa-65-identity-key
ed25519-identity-key = {
  0 => digest256,
  1 => 0 / 1,
  2 => uint .le 2,
  3 => ed25519-profile-id,
  4 => bstr .size 32
}
ml-dsa-65-identity-key = {
  0 => digest256,
  1 => 0 / 1,
  2 => uint .le 2,
  3 => ml-dsa-65-profile-id,
  4 => bstr .size 1952
}

continuity-proof = {
  0 => uint .le 3,
  1 => digest256 / null,
  2 => endpoint-continuity-signature
}
recovery-proof = {
  0 => digest256,
  1 => [1*4 endpoint-continuity-signature]
}
endpoint-continuity-signature = ed25519-continuity-signature / ml-dsa-65-continuity-signature
ed25519-continuity-signature = {
  0 => ed25519-profile-id,
  1 => digest256,
  2 => 0,
  3 => bstr .size 64
}
ml-dsa-65-continuity-signature = {
  0 => ml-dsa-65-profile-id,
  1 => digest256,
  2 => 0,
  3 => bstr .size 3309
}

ed25519-profile-id = h'176b912b9547ca9c47ace10f881457ab63fcd493ef953616f5859e76b830fd60'
ml-dsa-65-profile-id = h'427e788bb9aed076acc2fb5a94715d14e694ec5fbc846ac52c8c7e118a6b1b8f'
id128 = bstr .size 16
digest256 = bstr .size 32
epoch = uint .between 1 9007199254740991

; The statement digest is SHA-256("LP-EVIDENCE-STATEMENT" || NUL || the
; canonical statement). The checkpoint signature input is
; "LP-EVIDENCE-CHECKPOINT" || NUL || the canonical checkpoint fields 0..4.
; Validation resolves each key only through the bound, fully validated
; identity continuity state, then checks purpose, active state, Profile,
; exact lengths, canonical encoding, and signature in that order.

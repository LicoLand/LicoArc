; Lico Arc Protocol Identity v1 deterministic-CBOR runtime grammar.
; Every map key and enum is the exact unsigned value in labels.json. Textual
; governance names are not wire values. Definite lengths and canonical CBOR
; ordering are mandatory; unknown or duplicate labels fail closed.

identity-record = user-authority-state / identity-update / affiliation-update / route-update /
                  first-contact / discovery-input / transparency-bundle /
                  station-descriptor

user-authority-state = {
  0 => 8, 1 => digest256, 2 => digest256, 3 => authority-epoch,
  ? 4 => digest256, 5 => authority-transition,
  6 => authority-signing-key-composition,
  7 => authority-signing-key-composition,
  8 => [1*16 authorized-device],
  ? 9 => replacement-possession-proof,
  10 => authority-signature-composition
}

authority-signing-key-composition = [
  ed25519-authority-signing-key,
  ml-dsa-65-authority-signing-key
]
ed25519-authority-signing-key = {
  0 => digest256, 1 => authority-key-purpose,
  2 => ed25519-profile-id, 3 => bstr .size 32
}
ml-dsa-65-authority-signing-key = {
  0 => digest256, 1 => authority-key-purpose,
  2 => ml-dsa-65-profile-id, 3 => bstr .size 1952
}
authorized-device = {
  0 => digest256, 1 => digest256, 2 => device-status,
  3 => authority-epoch, ? 4 => authority-epoch,
  5 => authority-signature-composition
}
replacement-possession-proof = {
  ? 0 => authority-signature-composition,
  ? 1 => authority-signature-composition
}
authority-signature-composition = [ed25519-authority-signature, ml-dsa-65-authority-signature]

identity-update = {
  0 => 0, 1 => digest256, 2 => digest256, 3 => epoch,
  ? 4 => digest256, 5 => identity-transition, 6 => digest256,
  7 => [1*4 signing-key], ? 8 => [1*4 digest256],
  ? 9 => recovery-proof, 10 => continuity-proof,
  11 => endpoint-continuity-signature
}

affiliation-update = {
  0 => 1, 1 => digest256, 2 => digest256, 3 => epoch,
  ? 4 => digest256, 5 => chain-transition,
  6 => [*4 station-affiliation], 7 => digest256,
  8 => endpoint-continuity-signature
}

route-update = {
  0 => 2, 1 => digest256, 2 => digest256, 3 => digest256,
  4 => epoch, ? 5 => digest256, 6 => chain-transition,
  7 => digest256, 8 => unix-seconds, 9 => [1*4 route],
  10 => endpoint-continuity-signature
}

first-contact = {
  0 => 3, 1 => 1, 2 => token256, 3 => digest256,
  4 => digest256, 5 => 0, 6 => true, 7 => unix-seconds,
  8 => protected-invitation, 9 => 0
}

discovery-input = {
  0 => 4, 1 => id128, 2 => uint .le 3, 3 => digest256,
  4 => digest256, 5 => chain-kind, 6 => epoch, 7 => digest256,
  8 => digest256, 9 => unix-seconds, 10 => unix-seconds,
  11 => signature, 12 => true
}

transparency-bundle = {
  0 => 5, 1 => digest256, 2 => chain-kind, 3 => epoch,
  4 => digest256, 5 => [*8 authenticated-input],
  6 => [*8 authenticated-input], 7 => [*8 authenticated-input],
  8 => [*8 authenticated-input], 9 => [*8 authenticated-input],
  10 => 0, 11 => true, ? 12 => bool
}

station-descriptor = {
  0 => 7, 1 => digest256, 2 => epoch, ? 3 => digest256,
  4 => unix-seconds, 5 => unix-seconds,
  6 => [1*4 station-listener], 7 => [1*4 station-signing-key],
  ? 8 => [1*4 digest256], 9 => [1*4 station-descriptor-signature]
}

station-listener = { 0 => digest256, 1 => endpoint-uri }
station-signing-key = ed25519-station-signing-key / ml-dsa-65-station-signing-key
ed25519-station-signing-key = {
  0 => ed25519-profile-id, 1 => digest256, 2 => bstr .size 32
}
ml-dsa-65-station-signing-key = {
  0 => ml-dsa-65-profile-id, 1 => digest256, 2 => bstr .size 1952
}

station-affiliation = {
  0 => digest256, 1 => digest256, 2 => token256,
  3 => unix-seconds, 4 => station-affiliation-signature
}

route = {
  0 => digest256, 1 => digest256, 2 => digest256, 3 => 0,
  4 => token256, 5 => unix-seconds, 6 => station-route-signature
}

protected-invitation = {
  0 => digest256, ? 1 => digest256, 2 => digest256,
  3 => 0, 4 => digest256, ? 5 => token256
}

authenticated-input = {
  0 => id128, 1 => uint .le 4, 2 => digest256, 3 => epoch,
  4 => digest256, 5 => digest256, 6 => unix-seconds,
  7 => signature, 8 => true
}

signing-key = ed25519-signing-key / ml-dsa-65-signing-key
ed25519-signing-key = {
  0 => digest256, 1 => key-purpose, 2 => key-state,
  3 => ed25519-profile-id, 4 => bstr .size 32,
  5 => epoch, ? 6 => epoch
}
ml-dsa-65-signing-key = {
  0 => digest256, 1 => key-purpose, 2 => key-state,
  3 => ml-dsa-65-profile-id, 4 => bstr .size 1952,
  5 => epoch, ? 6 => epoch
}

continuity-proof = {
  0 => identity-transition,
  1 => digest256 / null,
  2 => endpoint-continuity-signature
}
recovery-proof = { 0 => digest256, 1 => [1*4 signature] }

signature = ed25519-signature / ml-dsa-65-signature
endpoint-continuity-signature = ed25519-continuity-signature / ml-dsa-65-continuity-signature
station-affiliation-signature = ed25519-station-affiliation-signature / ml-dsa-65-station-affiliation-signature
station-route-signature = ed25519-station-route-signature / ml-dsa-65-station-route-signature
station-descriptor-signature = ed25519-station-descriptor-signature / ml-dsa-65-station-descriptor-signature
ed25519-authority-signature = { 0 => ed25519-profile-id, 1 => digest256, 2 => 9..14, 3 => bstr .size 64 }
ml-dsa-65-authority-signature = { 0 => ml-dsa-65-profile-id, 1 => digest256, 2 => 9..14, 3 => bstr .size 3309 }

ed25519-signature = { 0 => ed25519-profile-id, 1 => digest256, 2 => signature-purpose, 3 => bstr .size 64 }
ml-dsa-65-signature = { 0 => ml-dsa-65-profile-id, 1 => digest256, 2 => signature-purpose, 3 => bstr .size 3309 }
ed25519-continuity-signature = { 0 => ed25519-profile-id, 1 => digest256, 2 => 0, 3 => bstr .size 64 }
ml-dsa-65-continuity-signature = { 0 => ml-dsa-65-profile-id, 1 => digest256, 2 => 0, 3 => bstr .size 3309 }
ed25519-station-affiliation-signature = { 0 => ed25519-profile-id, 1 => digest256, 2 => 2, 3 => bstr .size 64 }
ml-dsa-65-station-affiliation-signature = { 0 => ml-dsa-65-profile-id, 1 => digest256, 2 => 2, 3 => bstr .size 3309 }
ed25519-station-route-signature = { 0 => ed25519-profile-id, 1 => digest256, 2 => 3, 3 => bstr .size 64 }
ml-dsa-65-station-route-signature = { 0 => ml-dsa-65-profile-id, 1 => digest256, 2 => 3, 3 => bstr .size 3309 }
ed25519-station-descriptor-signature = { 0 => ed25519-profile-id, 1 => digest256, 2 => 8, 3 => bstr .size 64 }
ml-dsa-65-station-descriptor-signature = { 0 => ml-dsa-65-profile-id, 1 => digest256, 2 => 8, 3 => bstr .size 3309 }

authority-transition = 0 / 1 / 2
identity-transition = 0 / 1 / 2 / 3
authority-key-purpose = 0 / 1
device-status = 0 / 1
chain-transition = 0 / 1 / 2 / 3 / 4
key-purpose = 0 / 1 / 2
key-state = 0 / 1 / 2
signature-purpose = 0 / 1 / 2 / 3 / 4 / 5 / 6 / 7
chain-kind = 0 / 1 / 2

ed25519-profile-id = h'176b912b9547ca9c47ace10f881457ab63fcd493ef953616f5859e76b830fd60'
ml-dsa-65-profile-id = h'427e788bb9aed076acc2fb5a94715d14e694ec5fbc846ac52c8c7e118a6b1b8f'
digest256 = bstr .size 32
token256 = bstr .size 32
id128 = bstr .size 16
epoch = uint .between 1 9007199254740991
authority-epoch = uint .between 0 9007199254740991
unix-seconds = uint .between 0 9007199254740991
endpoint-uri = tstr .size (10..128)

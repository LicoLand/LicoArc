{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/identity/registry.json",
  "registryVersion": "licoarc.identity-registry.v1",
  "wireId": "licoarc.identity.v1",
  "lifecycle": "Candidate",
  "schemaPath": "spec/v1/identity/identity.schema.json",
  "policyPath": "spec/v1/identity/identity.policy.json",
  "labelsPath": "spec/v1/identity/labels.json",
  "signatureProfilesPath": "spec/v1/identity/signature-profiles.json",
  "runtimePath": "spec/v1/identity/runtime.cddl",
  "sourceManifestPath": "spec/v1/identity/source-manifest.json",
  "unknownFieldPolicy": "reject-record",
  "closedRecordTypes": [
    "userAuthorityState",
    "identityUpdate",
    "affiliationUpdate",
    "routeUpdate",
    "firstContact",
    "discoveryInput",
    "transparencyBundle",
    "stationDescriptor"
  ],
  "runtimeAuthority": {
    "fieldLabels": "labelsPath records and structures",
    "enumValues": "labelsPath enums",
    "textNamesOnWire": "forbidden",
    "unknownNumericValue": "reject-record"
  },
  "signingKeyResolution": {
    "keyIdType": "DIGEST256",
    "profileIdType": "DIGEST256",
    "publicMaterial": "raw-public-verification-bytes",
    "profileSelection": "signatureProfilesPath-only",
    "duplicateKeyId": "reject-state",
    "privateMaterial": "forbidden",
    "validationOrder": [
      "resolve-bound-identity-state",
      "resolve-key-id-in-state",
      "require-purpose",
      "require-active-state",
      "match-key-and-signature-profile-id",
      "validate-exact-public-key-length-and-canonical-encoding",
      "validate-exact-signature-length-and-canonical-encoding",
      "verify-signature"
    ]
  },
  "sourceClosure": {
    "manifestPath": "spec/v1/identity/source-manifest.json",
    "undeclaredFiles": "reject",
    "symlinks": "reject",
    "sortedPaths": "required"
  },
  "chainKinds": [
    {
      "kind": "userAuthority",
      "recordType": "userAuthorityState",
      "epochField": "authorityEpoch",
      "predecessorField": "previousUserAuthorityStateDigest",
      "digestField": "canonicalStateDigestExcludingAuthoritySignatures",
      "scope": "userIdentityRef",
      "forkPolicy": "equal-parent-unequal-children-explicit-reject"
    },
    {
      "kind": "identity",
      "recordType": "identityUpdate",
      "epochField": "identityEpoch",
      "predecessorField": "previousIdentityStateDigest",
      "digestField": "stateDigest",
      "scope": "endpointIdentityRef"
    },
    {
      "kind": "affiliation",
      "recordType": "affiliationUpdate",
      "epochField": "affiliationEpoch",
      "predecessorField": "previousAffiliationUpdateDigest",
      "digestField": "stateDigest",
      "scope": "endpointIdentityRef-global"
    },
    {
      "kind": "route",
      "recordType": "routeUpdate",
      "epochField": "routeEpoch",
      "predecessorField": "previousRouteUpdateDigest",
      "digestField": "logicalCanonicalRouteDigest",
      "logicalDigestExcludes": [
        "endpointSignature"
      ],
      "scope": "endpointIdentityRef-peerEndpointIdentityRef"
    }
  ],
  "stationDescriptorState": {
    "scope": "one-stable-station-identity",
    "recordType": "stationDescriptor",
    "identityField": "stationId",
    "sequenceField": "descriptorSequence",
    "predecessorField": "previousDescriptorDigest",
    "contentDigest": "complete-descriptor-including-signatures",
    "signatureCoverage": "complete-descriptor-excluding-signatures",
    "highWater": "endpoint-retained",
    "arrivalOrder": "never-selects",
    "expiry": "never-resets-high-water",
    "replacement": "atomic-after-complete-validation"
  },
  "fieldGroups": {
    "userAuthority": [
      "userIdentityRef",
      "authorityEpoch",
      "previousUserAuthorityStateDigest",
      "authorityTransitionKind",
      "managementSigningKeys",
      "recoverySigningKeys",
      "authorizedDevices",
      "possessionProof",
      "authoritySignatures"
    ],
    "signingKey": [
      "keyId",
      "keyPurpose",
      "keyState",
      "keyProfileId",
      "publicKey",
      "validFromEpoch",
      "revokedAtEpoch"
    ],
    "endpointIdentity": [
      "endpointIdentityRef",
      "identityEpoch",
      "previousIdentityStateDigest",
      "stateDigest",
      "keyAuthorizations",
      "continuityProof",
      "endpointSignature"
    ],
    "stationDescriptor": [
      "stationId",
      "descriptorSequence",
      "previousDescriptorDigest",
      "notBefore",
      "notAfter",
      "listeners",
      "signingKeys",
      "certificationRefs",
      "signatures"
    ],
    "stationListener": [
      "transportProfileId",
      "endpointUri"
    ],
    "stationSigningKey": [
      "keyProfileId",
      "keyId",
      "publicKey"
    ],
    "affiliation": [
      "affiliationEpoch",
      "previousAffiliationUpdateDigest",
      "stationAffiliations",
      "affiliationNonce",
      "affiliationCommitment",
      "affiliationNotAfter",
      "stationAffiliationSignature"
    ],
    "route": [
      "peerEndpointIdentityRef",
      "routeEpoch",
      "previousRouteUpdateDigest",
      "affiliationStateDigest",
      "routes",
      "routeNotAfter",
      "deliveryHandle",
      "serviceUntil",
      "stationServiceSignature"
    ],
    "firstContact": [
      "handleClass",
      "deliveryHandle",
      "audienceDigest",
      "invitationBinding",
      "singleUse",
      "expiresAt",
      "protectedInvitation",
      "peerVerificationState"
    ],
    "transparency": [
      "witnessInputs",
      "gossipInputs",
      "discoveryInputs",
      "stationSignatureInputs",
      "verificationInputs"
    ]
  },
  "observerContracts": {
    "endpoint": "retains-identity-trust-and-all-three-chain-high-water-marks",
    "peerEndpoint": "receives-protected-records-and-may-verify-continuity",
    "station": "sees-only-operation-scope-opaque-commitment-handle-and-finite-service-statement",
    "directory": "supplies-discovery-input-only",
    "witness": "supplies-transparency-input-only",
    "gossip": "supplies-transparency-input-only"
  },
  "forbiddenAuthority": [
    "station-selects-chain-tip",
    "directory-selects-chain-tip",
    "witness-selects-chain-tip",
    "gossip-selects-chain-tip",
    "arrival-order-selects-chain-tip",
    "station-time-selects-chain-tip",
    "expiry-resets-chain",
    "route-order-selects-global-primary",
    "station-success-sets-peer-trust",
    "endpoint-state-alone-grants-user-authority",
    "station-selects-user-authority"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/identity/identity.policy.json",
  "title": "Lico Arc Protocol identity and transparency policy",
  "registryVersion": "licoarc.identity-policy.v1",
  "wireId": "licoarc.identity.v1",
  "lifecycle": "Candidate",
  "scope": "user-authority-endpoint-identity-discovery-affiliation-route-transparency",
  "unknownPolicy": "reject",
  "retiredPolicy": "reject",
  "downgradePolicy": "reject",
  "bounds": {
    "MAX_RECORD_BYTES": 141501,
    "MAX_STATE_BYTES": 424503,
    "MAX_DIGEST_BYTES": 32,
    "MAX_NONCE_BYTES": 32,
    "MAX_DELIVERY_HANDLE_BYTES": 32,
    "MAX_TEXT_BYTES": 128,
    "MAX_IDENTITY_CHAIN_RECORDS": 64,
    "MAX_AUTHORITY_CATCH_UP_STATES": 64,
    "MAX_AUTHORIZED_DEVICES_PER_SNAPSHOT": 16,
    "MAX_AUTHORITY_KEYS_PER_PURPOSE": 2,
    "MAX_AFFILIATION_CHAIN_RECORDS": 64,
    "MAX_ROUTE_CHAIN_RECORDS": 64,
    "MAX_AFFILIATIONS": 4,
    "MAX_ROUTES": 4,
    "MAX_DISCOVERY_INPUTS": 8,
    "MAX_WITNESS_INPUTS": 8,
    "MAX_GOSSIP_INPUTS": 8,
    "MAX_STATION_INPUTS": 8,
    "MAX_VERIFICATION_INPUTS": 8,
    "MAX_ASSOCIATED_ENDPOINTS": 8,
    "MAX_SIGNATURES": 4,
    "MAX_LISTENERS": 4,
    "MAX_STATION_KEYS": 4,
    "MAX_CERTIFICATION_REFS": 4,
    "MAX_ENDPOINT_URI_BYTES": 128,
    "MAX_PUBLIC_KEY_BYTES": 1952,
    "MAX_SIGNATURE_BYTES": 3309,
    "MAX_PATH_DIGESTS": 64,
    "MAX_EPOCH": 9007199254740991,
    "MAX_VERIFICATION_INPUT_BYTES": 3535
  },
  "signatureProfiles": {
    "registryPath": "spec/v1/identity/signature-profiles.json",
    "keyId": "DIGEST256-scoped-to-containing-identity-or-descriptor",
    "profileId": "DIGEST256-content-identity",
    "publicKey": "exact-raw-public-verification-bytes",
    "algorithmNamesOnWire": "forbidden",
    "privateMaterial": "forbidden"
  },
  "canonicalMaxima": {
    "encoding": "deterministic-cbor",
    "maximumSignatureRecordBytes": 3386,
    "maximumAuthenticatedInputBytes": 3535,
    "maximumEightInputArrayBytes": 28281,
    "maximumTransparencyRecordBytes": 141501,
    "threeChainHighWaterBytes": 424503
  },
  "chains": {
    "userAuthority": {
      "scope": "one-self-certifying-user-authority",
      "genesisEpoch": 0,
      "successorStep": 1,
      "predecessor": "absent-at-genesis-required-after-genesis",
      "digest": "domain-separated-canonical-complete-snapshot-excluding-authority-signatures",
      "transitionKinds": [
        "genesis",
        "management",
        "recovery"
      ],
      "managementAuthorization": "exact-predecessor-management-ed25519-plus-ml-dsa-65",
      "managementRecoveryKeyRule": "preserve-current-recovery-key-set-exactly",
      "recoveryAuthorization": "exact-predecessor-recovery-ed25519-plus-ml-dsa-65",
      "recoveryReplacement": "replacement-recovery-keys-prove-possession",
      "fork": "equal-parent-unequal-successors-remain-explicit",
      "bounds": "per-complete-snapshot-or-catch-up-batch-never-lifetime"
    },
    "identity": {
      "scope": "one-stable-endpoint-identity",
      "genesisEpoch": 1,
      "successorStep": 1,
      "predecessor": "absent-at-genesis-required-after-genesis",
      "highWater": "endpoint-retained",
      "transitionKinds": [
        "genesis",
        "rotation",
        "revocation",
        "recovery"
      ]
    },
    "affiliation": {
      "scope": "one-stable-endpoint-identity-global-across-peers",
      "genesisEpoch": 1,
      "successorStep": 1,
      "predecessor": "absent-at-genesis-required-after-genesis",
      "highWater": "endpoint-retained-and-peer-reconciled",
      "transitionKinds": [
        "genesis",
        "migration",
        "rotation",
        "revocation",
        "recovery"
      ]
    },
    "route": {
      "scope": "stable-endpoint-and-one-peer-relationship",
      "genesisEpoch": 1,
      "successorStep": 1,
      "predecessor": "absent-at-genesis-required-after-genesis",
      "highWater": "endpoint-and-peer-retained",
      "transitionKinds": [
        "genesis",
        "migration",
        "rotation",
        "revocation",
        "recovery"
      ]
    }
  },
  "successorValidation": {
    "order": [
      "closed-schema",
      "scope-and-identity",
      "epoch-and-predecessor",
      "canonical-logical-digest",
      "continuity-proof",
      "transition-specific-rules",
      "cross-chain-references",
      "bounds-and-observer-rules"
    ],
    "replacement": "atomic-after-complete-validation",
    "arrivalOrder": "never-selects",
    "stationTime": "never-selects",
    "directoryOrder": "never-selects",
    "expiry": "never-selects-and-never-resets-high-water",
    "gap": "reject-and-no-mutation",
    "fork": "reject-equal-epoch-different-digest-and-no-mutation",
    "replay": "reject-duplicate-or-idempotently-observe-without-mutation",
    "rollback": "reject-lower-epoch-and-no-mutation",
    "continuityFailure": "new-endpoint-requires-repairing-not-migration",
    "overflow": "reject-without-wrap"
  },
  "stationDescriptor": {
    "stationIdDerivation": "SHA-256(UTF8(\"LICOARC-V1/STATION-ID\u0000\") || 32-byte-unpredictable-station-identity-seed)",
    "stationIdentitySeed": "generated-once;-never-transmitted;-never-derived-from-host-uri-provider-endpoint-or-signing-key",
    "contentDigest": "SHA-256(UTF8(\"LICOARC-V1/STATION-DESCRIPTOR\u0000\") || deterministic-CBOR-complete-station-descriptor-including-signatures)",
    "signatureInput": "UTF8(\"LICOARC-V1/STATION-DESCRIPTOR/SIGN\u0000\") || deterministic-CBOR-complete-station-descriptor-excluding-signatures",
    "signaturePurpose": "station-descriptor",
    "genesis": "descriptorSequence-equals-1;-previousDescriptorDigest-absent;-at-least-one-signature-resolves-to-a-listed-signing-key",
    "successor": "same-stationId;-descriptorSequence-strictly-greater-than-retained-high-water;-previousDescriptorDigest-equals-complete-predecessor-contentDigest;-at-least-one-signature-resolves-to-a-signing-key-authorized-by-the-predecessor",
    "equalSequence": "equal-contentDigest-is-replay-without-mutation;-different-contentDigest-is-fork-without-mutation",
    "rollback": "lower-descriptorSequence-reject-without-mutation",
    "replacement": "atomic-after-closed-schema-canonical-order-validity-key-and-signature-validation",
    "validity": "notBefore-must-not-exceed-notAfter;-local-time-controls-use-only-and-never-selects-lineage-or-proves-freshness",
    "keyIdDerivation": "SHA-256(UTF8(\"LICOARC-V1/STATION-KEY-ID\u0000\") || stationId || keyProfileId || publicKey)",
    "collectionOrder": "listeners-signingKeys-certificationRefs-and-signatures-are-strictly-ascending-by-their-deterministic-CBOR-encoding;-duplicates-reject",
    "endpointUri": "canonical-ASCII-HTTPS-absolute-URI;-lowercase-scheme-and-DNS-host;-canonical-IP-literal;-no-userinfo-query-fragment-or-port;-percent-escapes-uppercase;-dot-segments-forbidden;-UTF8-length-at-most-MAX_ENDPOINT_URI_BYTES",
    "certificationAuthority": "local-policy-input-only;-never-a-mandatory-federation-root",
    "forbiddenClaims": [
      "endpoint-identity",
      "station-honesty",
      "availability",
      "federation-membership",
      "provider-identity",
      "message-freshness",
      "key-deletion"
    ]
  },
  "stationBoundary": {
    "identityVisibility": "never",
    "affiliationOperationInput": [
      "stationDescriptorDigest",
      "affiliationCommitment",
      "operationId"
    ],
    "affiliationStatementScope": [
      "stationDescriptorDigest",
      "affiliationCommitment",
      "affiliationNotAfter",
      "stationAffiliationSignature"
    ],
    "routeStatementScope": [
      "stationDescriptorDigest",
      "affiliationCommitment",
      "transportProfileId",
      "deliveryHandle",
      "serviceUntil",
      "stationServiceSignature"
    ],
    "stationAuthority": "finite-service-statement-only",
    "forbiddenClaims": [
      "endpoint-identity",
      "peer-trust",
      "availability",
      "retention",
      "delivery",
      "acceptance",
      "application-effect",
      "chain-order",
      "fork-selection",
      "key-custody"
    ]
  },
  "firstContact": {
    "handleClass": "firstContact",
    "purpose": "first-contact-routing-only",
    "singleUse": true,
    "audienceBound": true,
    "scopeBound": true,
    "shortLived": true,
    "protectedInvitationBinding": true,
    "independentTokenField": false,
    "stableEndpointIdentifier": false,
    "initialPeerVerificationState": "unverified",
    "stationSuccessMeaning": "routing-hint-only",
    "redemption": "one-accepted-attempt; replay-rejects-without-trust-change"
  },
  "transparency": {
    "inputKinds": [
      "witness",
      "gossip",
      "discovery",
      "stationSignature",
      "verificationRecord"
    ],
    "authority": "bounded-authenticated-input-only",
    "endpointRetainsContinuity": true,
    "inputSelectsIdentity": false,
    "inputSelectsTrust": false,
    "splitView": "surface-conflict-to-endpoint;-never-pick-arrival-or-source",
    "nonEnumeration": true
  },
  "applicationAdmission": {
    "authorityPayload": "independently-validated-protected-complete-user-authority-state",
    "endpointStateInputs": "matching-protected-identity-records-or-exact-locally-accepted-states;never-a-public-directory-or-station-roster",
    "possessionKeyResolution": "exact-signing-keys-from-the-matching-endpoint-state",
    "sessionBinding": "sibling-endpoint-state-and-user-authority-state-digests",
    "payloadDigestMismatch": "reject-without-application-state-mutation",
    "unauthorizedEndpoint": "reject-without-application-state-mutation",
    "learnedRevocation": "reject-later-application-records-even-on-an-existing-session",
    "unchangedOfflineDevice": "retain-original-admission-epoch-possession-proof-without-resigning-successors",
    "localPeerTrust": "unchanged-by-authority-validation"
  },
  "endpointIdentityExclusions": [
    "stationId",
    "stationDescriptorDigest",
    "domain",
    "providerId",
    "accountId",
    "deviceId",
    "listener",
    "listenerLocation",
    "deliveryHandle",
    "mailboxId",
    "networkId",
    "directoryId"
  ]
}

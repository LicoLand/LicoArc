    "authenticatedInput": {
      "inputId": 0,
      "inputKind": 1,
      "sourceRef": 2,
      "stateEpoch": 3,
      "stateDigest": 4,
      "statementDigest": 5,
      "expiresAt": 6,
      "signature": 7,
      "authenticatedInputOnly": 8

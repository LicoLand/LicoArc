    "transparencyBundle": {
      "recordType": 0,
      "subjectEndpointIdentityRef": 1,
      "chainKind": 2,
      "stateEpoch": 3,
      "stateDigest": 4,
      "witnessInputs": 5,
      "gossipInputs": 6,
      "discoveryInputs": 7,
      "stationSignatureInputs": 8,
      "verificationInputs": 9,
      "authority": 10,
      "endpointRetainsContinuity": 11,
      "splitView": 12

    "sourceKind": {
      "directory": 0,
      "witness": 1,
      "gossip": 2,
      "station": 3
    },
    "inputKind": {
      "witness": 0,
      "gossip": 1,
      "discovery": 2,
      "stationSignature": 3,
      "verificationRecord": 4
    },
    "chainKind": {
      "identity": 0,
      "affiliation": 1,
      "route": 2
    },
    "handleClass": {
      "async": 0,
      "firstContact": 1
    },
    "invitationPurpose": {
      "firstContact": 0
    },
    "peerVerificationState": {
      "unverified": 0
    },
    "transparencyAuthority": {
      "bounded-authenticated-input-only": 0
    },
    "authorityKeyPurpose": {
      "management": 0,
      "recovery": 1
    },
    "deviceStatus": {
      "active": 0,
      "revoked": 1
    }
  }
}

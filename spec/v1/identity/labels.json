    "stationDescriptor": {
      "recordType": 0,
      "stationId": 1,
      "descriptorSequence": 2,
      "previousDescriptorDigest": 3,
      "notBefore": 4,
      "notAfter": 5,
      "listeners": 6,
      "signingKeys": 7,
      "certificationRefs": 8,
      "signatures": 9
    }
  },
  "structures": {
    "signingKey": {
      "keyId": 0,
      "keyPurpose": 1,
      "keyState": 2,
      "keyProfileId": 3,
      "publicKey": 4,
      "validFromEpoch": 5,
      "revokedAtEpoch": 6
    },
    "signature": {
      "keyProfileId": 0,
      "keyId": 1,
      "signaturePurpose": 2,
      "signatureValue": 3
    },
    "continuityProof": {
      "proofKind": 0,
      "predecessorStateDigest": 1,
      "signature": 2
    },
    "recoveryProof": {
      "recoveryDigest": 0,
      "witnesses": 1
    },
    "stationAffiliation": {
      "stationDescriptorDigest": 0,
      "affiliationCommitment": 1,
      "affiliationNonce": 2,
      "affiliationNotAfter": 3,
      "stationAffiliationSignature": 4
    },
    "route": {
      "stationDescriptorDigest": 0,
      "affiliationCommitment": 1,
      "transportProfileId": 2,
      "handleClass": 3,
      "deliveryHandle": 4,
      "serviceUntil": 5,
      "stationServiceSignature": 6
    },
    "protectedInvitation": {
      "inviterEndpointIdentityRef": 0,
      "inviteeEndpointIdentityRef": 1,
      "invitationBinding": 2,
      "purpose": 3,
      "audienceDigest": 4,
      "handshakeNonce": 5

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/identity/labels.json",
  "registryVersion": "licoarc.identity-labels.v1",
  "lifecycle": "Candidate",
  "keyEncoding": "compact-unsigned-integer",
  "unknownLabelPolicy": "reject-record",
  "duplicateLabelPolicy": "reject-record",
  "records": {
    "userAuthorityState": {
      "recordType": 0,
      "protocolLineId": 1,
      "userIdentityRef": 2,
      "authorityEpoch": 3,
      "previousUserAuthorityStateDigest": 4,
      "authorityTransitionKind": 5,
      "managementSigningKeys": 6,
      "recoverySigningKeys": 7,
      "authorizedDevices": 8,
      "possessionProof": 9,
      "authoritySignatures": 10
    },
    "identityUpdate": {
      "recordType": 0,
      "protocolLineId": 1,
      "endpointIdentityRef": 2,
      "identityEpoch": 3,
      "previousIdentityStateDigest": 4,
      "transition": 5,
      "stateDigest": 6,
      "keyAuthorizations": 7,
      "revokedKeyIds": 8,
      "recoveryProof": 9,
      "continuityProof": 10,
      "endpointSignature": 11
    },
    "affiliationUpdate": {
      "recordType": 0,
      "protocolLineId": 1,
      "endpointIdentityRef": 2,
      "affiliationEpoch": 3,
      "previousAffiliationUpdateDigest": 4,
      "transition": 5,
      "stationAffiliations": 6,
      "stateDigest": 7,
      "endpointSignature": 8
    },
    "routeUpdate": {
      "recordType": 0,
      "protocolLineId": 1,
      "endpointIdentityRef": 2,
      "peerEndpointIdentityRef": 3,
      "routeEpoch": 4,
      "previousRouteUpdateDigest": 5,
      "transition": 6,
      "affiliationStateDigest": 7,
      "routeNotAfter": 8,
      "routes": 9,
      "endpointSignature": 10
    },
    "firstContact": {
      "recordType": 0,
      "handleClass": 1,
      "deliveryHandle": 2,
      "audienceDigest": 3,
      "invitationBinding": 4,
      "purpose": 5,
      "singleUse": 6,
      "expiresAt": 7,
      "protectedInvitation": 8,
      "peerVerificationState": 9
    },
    "discoveryInput": {
      "recordType": 0,
      "inputId": 1,
      "sourceKind": 2,
      "sourceRef": 3,
      "subjectEndpointIdentityRef": 4,
      "chainKind": 5,
      "stateEpoch": 6,
      "stateDigest": 7,
      "statementDigest": 8,
      "observedAt": 9,
      "expiresAt": 10,
      "sourceSignature": 11,
      "authenticatedInputOnly": 12

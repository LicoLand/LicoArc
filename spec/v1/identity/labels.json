    "stationListener": {
      "transportProfileId": 0,
      "endpointUri": 1
    },
    "stationSigningKey": {
      "keyProfileId": 0,
      "keyId": 1,
      "publicKey": 2
    },
    "authoritySigningKey": {
      "keyId": 0,
      "keyPurpose": 1,
      "keyProfileId": 2,
      "publicKey": 3
    },
    "authorizedDevice": {
      "endpointIdentityRef": 0,
      "identityStateDigest": 1,
      "deviceStatus": 2,
      "admittedAuthorityEpoch": 3,
      "revokedAuthorityEpoch": 4,
      "possessionProof": 5
    },
    "replacementPossessionProof": {
      "managementSignatures": 0,
      "recoverySignatures": 1
    }
  },
  "labelRule": "each object value is the exact unsigned CBOR label of its member name",
  "enums": {
    "recordType": {
      "identityUpdate": 0,
      "affiliationUpdate": 1,
      "routeUpdate": 2,
      "firstContact": 3,
      "discoveryInput": 4,
      "transparencyBundle": 5,
      "stationDescriptor": 7,
      "userAuthorityState": 8
    },
    "identityTransition": {
      "genesis": 0,
      "rotation": 1,
      "revocation": 2,
      "recovery": 3
    },
    "authorityTransition": {
      "genesis": 0,
      "management": 1,
      "recovery": 2
    },
    "chainTransition": {
      "genesis": 0,
      "migration": 1,
      "rotation": 2,
      "revocation": 3,
      "recovery": 4
    },
    "keyPurpose": {
      "identity": 0,
      "handshake": 1
    },
    "keyState": {
      "active": 0,
      "revoked": 1,
      "recovery": 2
    },
    "signaturePurpose": {
      "endpoint-continuity": 0,
      "station-affiliation": 1,
      "station-route-service": 2,
      "witness": 3,
      "gossip": 4,
      "discovery": 5,
      "verification": 6,
      "station-descriptor": 7,
      "authority-genesis": 8,
      "authority-management": 9,
      "authority-recovery": 10,
      "device-possession": 11,
      "replacement-management-possession": 12,
      "replacement-recovery-possession": 13

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/messaging/message.schema.json",
  "title": "Lico Arc Generic Message semantic projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "kind", "contentType", "payload"],
  "properties": {
    "messageId": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]*={0,2}$" },
    "kind": { "enum": ["event", "request", "response", "error", "cancel", "streamChunk"] },
    "relatesTo": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]*={0,2}$" },
    "contentType": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "payload": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]*={0,2}$" },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 16,
      "properties": {}
    },
    "critical": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
    },
    "chunkIndex": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "chunkFinal": { "type": "boolean" },
    "attachmentId": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]*={0,2}$" },
    "attachments": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attachmentId", "mediaType", "byteLength", "contentDigest"],
        "properties": {
          "attachmentId": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]*={0,2}$" },
          "mediaType": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "byteLength": { "type": "integer", "minimum": 0, "maximum": 8388608 },
          "contentDigest": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]*={0,2}$" }
        }
      }
    }
  }
}

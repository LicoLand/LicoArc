{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/messaging/capability-sync.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issuer",
    "audience"
  ],
  "properties": {
    "issuer": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "indexes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740990
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/messaging/control.schema.json",
  "title": "Lico Arc Attachment Receive State semantic projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["attachmentId", "requestedChunkRanges", "stateUpdate", "outcome", "recoveryRound"],
  "properties": {
    "attachmentId": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]*={0,2}$" },
    "requestedChunkRanges": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startChunkIndex", "endChunkIndexExclusive"],
        "properties": {
          "startChunkIndex": { "type": "integer", "minimum": 0, "maximum": 128 },
          "endChunkIndexExclusive": { "type": "integer", "minimum": 0, "maximum": 128 }
        }
      }
    },
    "stateUpdate": { "type": "integer", "minimum": 0, "maximum": 64 },
    "outcome": { "enum": ["pending", "complete", "cancelled", "failed"] },
    "failureCode": { "type": "integer", "minimum": 0, "maximum": 14 },
    "recoveryRound": { "type": "integer", "minimum": 0, "maximum": 32 }
  }
}

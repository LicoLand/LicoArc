{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoarc.com/spec/v1/identity/conformance-manifest.json",
  "manifestVersion": "licoarc.identity-conformance-manifest.v1",
  "contractVersion": "licoarc.identity.v1",
  "lifecycle": "Candidate",
  "schemaPath": "spec/v1/identity/identity.schema.json",
  "policyPath": "spec/v1/identity/identity.policy.json",
  "registryPath": "spec/v1/identity/registry.json",
  "runtimePath": "spec/v1/identity/runtime.cddl",
  "validCasesPath": "conformance/v1/identity/valid.json",
  "invalidCasesPath": "conformance/v1/identity/invalid.json",
  "formatAssertions": [
    "closed-json-schema",
    "deterministic-logical-digest",
    "bounded-opaque-hex-values",
    "closed-record-types"
  ],
  "caseIds": [
    "identity-v1.accept.affiliation-genesis-unaffiliated",
    "identity-v1.accept.affiliation-migration",
    "identity-v1.accept.association-claim-non-authoritative",
    "identity-v1.accept.discovery-input-is-not-authority",
    "identity-v1.accept.epoch-boundary",
    "identity-v1.accept.first-contact-unverified",
    "identity-v1.accept.identity-genesis",
    "identity-v1.accept.identity-rotation",
    "identity-v1.accept.malicious-station-finite-statement",
    "identity-v1.accept.restart-preserves-high-water",
    "identity-v1.accept.rotation-revocation-recovery",
    "identity-v1.accept.route-genesis",
    "identity-v1.accept.transparency-bounded-inputs",
    "identity-v1.reject.affiliation-genesis-predecessor",
    "identity-v1.reject.affiliation-split-view",
    "identity-v1.reject.association-human-identity",
    "identity-v1.reject.directory-selects-tip",
    "identity-v1.reject.discovery-unknown-source",
    "identity-v1.reject.first-contact-replay",
    "identity-v1.reject.first-contact-reusable",
    "identity-v1.reject.first-contact-stable-id",
    "identity-v1.reject.identity-endpoint-id-not-digest",
    "identity-v1.reject.identity-fork",
    "identity-v1.reject.identity-gap",
    "identity-v1.reject.identity-genesis-epoch-two",
    "identity-v1.reject.identity-missing-required",
    "identity-v1.reject.identity-replay",
    "identity-v1.reject.identity-rollback-after-restart",
    "identity-v1.reject.identity-successor-missing-predecessor",
    "identity-v1.reject.instance-null",
    "identity-v1.reject.route-first-contact-handle",
    "identity-v1.reject.route-old-affiliation",
    "identity-v1.reject.route-successor-missing-predecessor",
    "identity-v1.reject.station-fabricated-route",
    "identity-v1.reject.station-id-duplicate",
    "identity-v1.reject.station-time-selects-tip",
    "identity-v1.reject.transparency-trust-authority"
  ],
  "requirementCoverage": [
    {
      "requirementId": "IDENTITY-CHAIN-001",
      "statement": "Identity, affiliation, and peer Route chains have genesis, exact successor epochs, immediate predecessor digests, and bounded high-water state.",
      "caseIds": [
        "identity-v1.accept.identity-genesis",
        "identity-v1.accept.affiliation-genesis-unaffiliated",
        "identity-v1.accept.route-genesis",
        "identity-v1.reject.identity-gap",
        "identity-v1.reject.identity-fork",
        "identity-v1.reject.identity-replay",
        "identity-v1.reject.identity-rollback-after-restart"
      ]
    },
    {
      "requirementId": "IDENTITY-CHAIN-002",
      "statement": "Successors are fully validated before atomic high-water replacement; arrival order, Station time, directory order, and expiry never choose a fork or reset state.",
      "caseIds": [
        "identity-v1.accept.restart-preserves-high-water",
        "identity-v1.reject.affiliation-split-view",
        "identity-v1.reject.directory-selects-tip",
        "identity-v1.reject.station-time-selects-tip"
      ]
    },
    {
      "requirementId": "IDENTITY-DISCOVERY-001",
      "statement": "Discovery, witness, gossip, Station signatures, and Verification Records are bounded authenticated inputs and never continuity or trust authorities.",
      "caseIds": [
        "identity-v1.accept.discovery-input-is-not-authority",
        "identity-v1.accept.transparency-bounded-inputs",
        "identity-v1.reject.discovery-unknown-source",
        "identity-v1.reject.transparency-trust-authority"
      ]
    },
    {
      "requirementId": "IDENTITY-AFFILIATION-001",
      "statement": "Station-facing affiliation reveals only randomized identity-bound commitments and finite service statements; full affiliation state remains protected.",
      "caseIds": [
        "identity-v1.accept.affiliation-migration",
        "identity-v1.accept.malicious-station-finite-statement",
        "identity-v1.reject.station-id-duplicate"
      ]
    },
    {
      "requirementId": "IDENTITY-ROUTE-001",
      "statement": "Private Routes bind one exact affiliation digest, use asynchronous Handles only, and preserve stable Endpoint identity through migration, rotation, revocation, and recovery.",
      "caseIds": [
        "identity-v1.accept.route-genesis",
        "identity-v1.accept.rotation-revocation-recovery",
        "identity-v1.reject.route-first-contact-handle",
        "identity-v1.reject.route-old-affiliation",
        "identity-v1.reject.station-fabricated-route"
      ]
    },
    {
      "requirementId": "IDENTITY-FIRST-CONTACT-001",
      "statement": "First contact uses one purpose-scoped single-use Delivery Handle and protected invitation binding; the initial peer state is locally unverified and Station success is not trust.",
      "caseIds": [
        "identity-v1.accept.first-contact-unverified",
        "identity-v1.reject.first-contact-replay",
        "identity-v1.reject.first-contact-reusable",
        "identity-v1.reject.first-contact-stable-id"
      ]
    },
    {
      "requirementId": "IDENTITY-TRANSPARENCY-001",
      "statement": "Continuity-preserving key rotation, explicit revocation, and recovery retain the stable Endpoint identity; continuity failure requires re-pairing, and association claims never merge identities or establish trust.",
      "caseIds": [
        "identity-v1.accept.identity-rotation",
        "identity-v1.accept.rotation-revocation-recovery",
        "identity-v1.accept.association-claim-non-authoritative",
        "identity-v1.reject.association-human-identity",
        "identity-v1.reject.identity-endpoint-id-not-digest"
      ]
    }
  ],
  "negativeClasses": [
    "instance-type",
    "required-field",
    "unknown-field",
    "pattern-or-bound",
    "transition",
    "gap",
    "fork",
    "replay",
    "rollback",
    "stale-affiliation",
    "handle-class",
    "single-use-replay",
    "no-authority",
    "unauthenticated-route",
    "forbidden-field"
  ]
}

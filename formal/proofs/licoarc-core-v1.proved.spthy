                           $I, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                        'i2r', ~coordinate>,
                       ideal_hybrid(~classical_component, ~pq_component, $I, $I,
                                    h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                       'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                       '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                       $I, $I, ~pair, h(~prekey), h(~classical_component), h(~pq_component)
                                      >)))
             ) @ #vk )
        case c_senc
        by solve( !KU( ~coordinate ) @ #vk.11 )
      qed
    next
      case ResponderAccept
      by contradiction /* cyclic */
    qed
  qed
next
  case case_2
  solve( ChainState( $R, S, td, direction, n, chain ) ▶₀ #i )
    case InitiatorAccept
    solve( ChainState( $R, S,
                       h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                          'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                          '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                          $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                       'i2r', ~coordinate, chain
           ) ▶₀ #j )
      case InitiatorAccept
      by contradiction /* cyclic */
    next
      case ResponderAccept
      solve( !KU( senc(<message, sender_metadata,
                        h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                           'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                           '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                           $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                        'i2r', ~coordinate>,
                       ideal_hybrid(~classical_component, ~pq_component, $R, $R,
                                    h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                       'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                       '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                       $R, $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)
                                      >)))
             ) @ #vk )
        case c_senc
        by solve( !KU( ~coordinate ) @ #vk.11 )
      qed
    qed
  next
    case ResponderAccept
    solve( ChainState( $R, S,
                       h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                          'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                          '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                          $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                       'i2r', ~coordinate, chain
           ) ▶₀ #j )
      case InitiatorAccept
      solve( !KU( senc(<message, sender_metadata,
                        h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                           'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                           '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                           $I, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                        'i2r', ~coordinate>,
                       ideal_hybrid(~classical_component, ~pq_component, $I, $I,
                                    h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                       'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                       '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                       $I, $I, ~pair, h(~prekey), h(~classical_component), h(~pq_component)
                                      >)))
             ) @ #vk )
        case c_senc
        by solve( !KU( ~coordinate ) @ #vk.11 )
      qed
    next
      case ResponderAccept
      by contradiction /* cyclic */
    qed
  qed
qed

lemma SEC_014_self_certifying_user_authority:
  all-traces
  "∀ user_ref authority_state management_public recovery_public #accept.
    (UserAuthorityGenesisAccepted( user_ref, authority_state,
                                   management_public, recovery_public
     ) @ #accept) ⇒
    (∃ #create.
      (UserAuthorityGenesisCreated( user_ref, authority_state,
                                    management_public, recovery_public
       ) @ #create) ∧
      (#create < #accept))"
/*
guarded formula characterizing all counter-examples:
"∃ user_ref authority_state management_public recovery_public #accept.
  (UserAuthorityGenesisAccepted( user_ref, authority_state,
                                 management_public, recovery_public
   ) @ #accept)
 ∧
  ∀ #create.
   (UserAuthorityGenesisCreated( user_ref, authority_state,
                                 management_public, recovery_public
    ) @ #create)
  ⇒
   ¬(#create < #accept)"
*/
simplify
solve( !AuthorityGenesisVerification( user_ref, authority_state,
                                      management_secret, recovery_secret
       ) ▶₀ #accept )
  case ProvisionUserAuthority
  by contradiction /* from formulas */
qed

lemma SEC_015_route_migration_safety:
  all-traces
  "∀ E P public old_route new_route route_digest #accept.
    (RouteMigrationAccepted( E, P, public, old_route, new_route, route_digest
     ) @ #accept) ⇒
    ((∃ #authorize.
       (RouteMigrationAuthorized( E, P, public, old_route, new_route,
                                  route_digest
        ) @ #authorize) ∧
       (#authorize < #accept)) ∨
     (∃ #c. (IdentityMaterialCompromise( E, public ) @ #c) ∧ (#c < #accept)))"
/*
guarded formula characterizing all counter-examples:
"∃ E P public old_route new_route route_digest #accept.
  (RouteMigrationAccepted( E, P, public, old_route, new_route, route_digest
   ) @ #accept)
 ∧
  (∀ #authorize.
    (RouteMigrationAuthorized( E, P, public, old_route, new_route,
                               route_digest
     ) @ #authorize)
   ⇒
    ¬(#authorize < #accept)) ∧
  (∀ #c. (IdentityMaterialCompromise( E, public ) @ #c) ⇒ ¬(#c < #accept))"
*/
simplify
solve( !IdentityVerification( $E, secret ) ▶₀ #accept )
  case ProvisionPair_case_1
  solve( !KU( sign(<'route-migration',
                    'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $E,
                    P, old_route, new_route, route_digest>,
                   ~identity_secret_i)
         ) @ #vk.12 )
    case AuthorizeRouteMigration
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_i ) @ #vk.18 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
next
  case ProvisionPair_case_2
  solve( !KU( sign(<'route-migration',
                    'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $E,
                    P, old_route, new_route, route_digest>,
                   ~identity_secret_r)
         ) @ #vk.12 )
    case AuthorizeRouteMigration
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_r ) @ #vk.18 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
qed

lemma SEC_016_management_and_recovery_transition_authorization:
  all-traces
  "∀ user_ref predecessor successor kind public #accept.
    (AuthorityTransitionAccepted( user_ref, predecessor, successor, kind,
                                  public
     ) @ #accept) ⇒
    (((kind = 'management') ∧
      ((∃ #authorize.
         (ManagementTransitionAuthorized( user_ref, predecessor, successor, public
          ) @ #authorize) ∧
         (#authorize < #accept)) ∨
       (∃ #c.
         (ManagementAuthorityCompromise( user_ref, predecessor, public ) @ #c) ∧
         (#c < #accept)))) ∨
     ((kind = 'recovery') ∧
      ((∃ #authorize.
         (RecoveryTransitionAuthorized( user_ref, predecessor, successor, public
          ) @ #authorize) ∧
         (#authorize < #accept)) ∨
       (∃ #c.
         (RecoveryAuthorityCompromise( user_ref, predecessor, public ) @ #c) ∧
         (#c < #accept)))))"
/*
guarded formula characterizing all counter-examples:
"∃ user_ref predecessor successor kind public #accept.
  (AuthorityTransitionAccepted( user_ref, predecessor, successor, kind,
                                public
   ) @ #accept)
 ∧
  (((¬(kind = 'management')) ∨
    ((∀ #authorize.
       (ManagementTransitionAuthorized( user_ref, predecessor, successor, public
        ) @ #authorize)
      ⇒
       ¬(#authorize < #accept)) ∧
     (∀ #c.
       (ManagementAuthorityCompromise( user_ref, predecessor, public ) @ #c)
      ⇒
       ¬(#c < #accept))))) ∧
  (((¬(kind = 'recovery')) ∨
    ((∀ #authorize.
       (RecoveryTransitionAuthorized( user_ref, predecessor, successor, public
        ) @ #authorize)
      ⇒
       ¬(#authorize < #accept)) ∧
     (∀ #c.
       (RecoveryAuthorityCompromise( user_ref, predecessor, public ) @ #c)
      ⇒
       ¬(#c < #accept)))))"
*/
simplify
solve( (¬(kind = 'management'))  ∥
       ((∀ #authorize.
          (ManagementTransitionAuthorized( user_ref, predecessor, successor, public
           ) @ #authorize)
         ⇒
          ¬(#authorize < #accept)) ∧
        (∀ #c.
          (ManagementAuthorityCompromise( user_ref, predecessor, public ) @ #c)
         ⇒
          ¬(#c < #accept))) )
  case case_1
  solve( (¬(kind = 'recovery'))  ∥
         ((∀ #authorize.
            (RecoveryTransitionAuthorized( user_ref, predecessor, successor, public
             ) @ #authorize)
           ⇒
            ¬(#authorize < #accept)) ∧
          (∀ #c.
            (RecoveryAuthorityCompromise( user_ref, predecessor, public ) @ #c)
           ⇒
            ¬(#c < #accept))) )
    case case_1
    solve( AuthorityTransitionAccepted( user_ref, predecessor, successor,
                                        kind, public
           ) @ #accept )
      case AcceptManagementTransition
      by contradiction /* from formulas */
    next
      case AcceptRecoveryTransition
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( AuthorityTransitionAccepted( user_ref, predecessor, successor,
                                        kind, public
           ) @ #accept )
      case AcceptManagementTransition
      by contradiction /* from formulas */
    next
      case AcceptRecoveryTransition
      solve( !RecoveryAuthority( user_ref, predecessor, recovery_secret
             ) ▶₀ #accept )
        case ProvisionUserAuthority
        solve( RecoveryTransitionEnvelope( h(<'user-authority-genesis',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              pk(~management_secret), pk(~recovery_secret)>),
                                           h(<'user-authority-state',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              h(<'user-authority-genesis',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 pk(~management_secret), pk(~recovery_secret)>),
                                              '0', pk(~management_secret), pk(~recovery_secret), $E,
                                              h(<'endpoint-state',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 $E, pk(~endpoint_secret)>)
                                             >),
                                           successor, pk(~recovery_secret),
                                           sign(<'user-authority-recovery-transition',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 h(<'user-authority-genesis',
                                                    'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                    pk(~management_secret), pk(~recovery_secret)>),
                                                 h(<'user-authority-state',
                                                    'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                    h(<'user-authority-genesis',
                                                       'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                       pk(~management_secret), pk(~recovery_secret)>),
                                                    '0', pk(~management_secret), pk(~recovery_secret), $E,
                                                    h(<'endpoint-state',
                                                       'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                       $E, pk(~endpoint_secret)>)
                                                   >),
                                                 successor>,
                                                ~recovery_secret)
               ) ▶₁ #accept )
          case AuthorizeRecoveryTransition
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( (¬(kind = 'recovery'))  ∥
         ((∀ #authorize.
            (RecoveryTransitionAuthorized( user_ref, predecessor, successor, public
             ) @ #authorize)
           ⇒
            ¬(#authorize < #accept)) ∧
          (∀ #c.
            (RecoveryAuthorityCompromise( user_ref, predecessor, public ) @ #c)
           ⇒
            ¬(#c < #accept))) )
    case case_1
    solve( AuthorityTransitionAccepted( user_ref, predecessor, successor,
                                        kind, public
           ) @ #accept )
      case AcceptManagementTransition
      solve( !ManagementAuthority( user_ref, predecessor, management_secret
             ) ▶₀ #accept )
        case ProvisionUserAuthority
        solve( ManagementTransitionEnvelope( h(<'user-authority-genesis',
                                                'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                pk(~management_secret), pk(~recovery_secret)>),
                                             h(<'user-authority-state',
                                                'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                h(<'user-authority-genesis',
                                                   'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                   pk(~management_secret), pk(~recovery_secret)>),
                                                '0', pk(~management_secret), pk(~recovery_secret), $E,
                                                h(<'endpoint-state',
                                                   'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                   $E, pk(~endpoint_secret)>)
                                               >),
                                             successor, pk(~management_secret),
                                             sign(<'user-authority-management-transition',
                                                   'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                   h(<'user-authority-genesis',
                                                      'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                      pk(~management_secret), pk(~recovery_secret)>),
                                                   h(<'user-authority-state',
                                                      'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                      h(<'user-authority-genesis',
                                                         'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                         pk(~management_secret), pk(~recovery_secret)>),
                                                      '0', pk(~management_secret), pk(~recovery_secret), $E,
                                                      h(<'endpoint-state',
                                                         'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                         $E, pk(~endpoint_secret)>)
                                                     >),
                                                   successor>,
                                                  ~management_secret)
               ) ▶₁ #accept )
          case AuthorizeManagementTransition
          by contradiction /* from formulas */
        qed
      qed
    next
      case AcceptRecoveryTransition
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( AuthorityTransitionAccepted( user_ref, predecessor, successor,
                                        kind, public
           ) @ #accept )
      case AcceptManagementTransition
      solve( !ManagementAuthority( user_ref, predecessor, management_secret
             ) ▶₀ #accept )
        case ProvisionUserAuthority
        solve( ManagementTransitionEnvelope( h(<'user-authority-genesis',
                                                'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                pk(~management_secret), pk(~recovery_secret)>),
                                             h(<'user-authority-state',
                                                'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                h(<'user-authority-genesis',
                                                   'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                   pk(~management_secret), pk(~recovery_secret)>),
                                                '0', pk(~management_secret), pk(~recovery_secret), $E,
                                                h(<'endpoint-state',
                                                   'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                   $E, pk(~endpoint_secret)>)
                                               >),
                                             successor, pk(~management_secret),
                                             sign(<'user-authority-management-transition',
                                                   'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                   h(<'user-authority-genesis',
                                                      'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                      pk(~management_secret), pk(~recovery_secret)>),
                                                   h(<'user-authority-state',
                                                      'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                      h(<'user-authority-genesis',
                                                         'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                         pk(~management_secret), pk(~recovery_secret)>),
                                                      '0', pk(~management_secret), pk(~recovery_secret), $E,
                                                      h(<'endpoint-state',
                                                         'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                         $E, pk(~endpoint_secret)>)
                                                     >),
                                                   successor>,
                                                  ~management_secret)
               ) ▶₁ #accept )
          case AuthorizeManagementTransition
          by contradiction /* from formulas */
        qed
      qed
    next
      case AcceptRecoveryTransition
      solve( !RecoveryAuthority( user_ref, predecessor, recovery_secret
             ) ▶₀ #accept )
        case ProvisionUserAuthority
        solve( RecoveryTransitionEnvelope( h(<'user-authority-genesis',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              pk(~management_secret), pk(~recovery_secret)>),
                                           h(<'user-authority-state',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              h(<'user-authority-genesis',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 pk(~management_secret), pk(~recovery_secret)>),
                                              '0', pk(~management_secret), pk(~recovery_secret), $E,
                                              h(<'endpoint-state',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 $E, pk(~endpoint_secret)>)
                                             >),
                                           successor, pk(~recovery_secret),
                                           sign(<'user-authority-recovery-transition',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 h(<'user-authority-genesis',
                                                    'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                    pk(~management_secret), pk(~recovery_secret)>),
                                                 h(<'user-authority-state',
                                                    'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                    h(<'user-authority-genesis',
                                                       'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                       pk(~management_secret), pk(~recovery_secret)>),
                                                    '0', pk(~management_secret), pk(~recovery_secret), $E,
                                                    h(<'endpoint-state',
                                                       'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',

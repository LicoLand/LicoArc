lemma SEC_014_identity_continuity:
  all-traces
  "∀ E old_public new_public successor #accept.
    (IdentityContinuityAccepted( E, old_public, new_public, successor
     ) @ #accept) ⇒
    ((∃ #authorize.
       (IdentitySuccessorAuthorized( E, old_public, new_public, successor
        ) @ #authorize) ∧
       (#authorize < #accept)) ∨
     (∃ #c.
       (IdentityMaterialCompromise( E, old_public ) @ #c) ∧ (#c < #accept)))"
/*
guarded formula characterizing all counter-examples:
"∃ E old_public new_public successor #accept.
  (IdentityContinuityAccepted( E, old_public, new_public, successor
   ) @ #accept)
 ∧
  (∀ #authorize.
    (IdentitySuccessorAuthorized( E, old_public, new_public, successor
     ) @ #authorize)
   ⇒
    ¬(#authorize < #accept)) ∧
  (∀ #c.
    (IdentityMaterialCompromise( E, old_public ) @ #c) ⇒ ¬(#c < #accept))"
*/
simplify
solve( !IdentityVerification( $E, old_secret ) ▶₀ #accept )
  case ProvisionPair_case_1
  solve( !KU( sign(<'identity-continuity', 
                    'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                    pk(~identity_secret_i), new_public, successor>,
                   ~identity_secret_i)
         ) @ #vk.4 )
    case AuthorizeIdentitySuccessor
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_i ) @ #vk.7 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
next
  case ProvisionPair_case_2
  solve( !KU( sign(<'identity-continuity', 
                    'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                    pk(~identity_secret_r), new_public, successor>,
                   ~identity_secret_r)
         ) @ #vk.4 )
    case AuthorizeIdentitySuccessor
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_r ) @ #vk.7 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
qed

lemma SEC_015_route_migration_safety:
  all-traces
  "∀ E P public old_route new_route route_digest #accept.
    (RouteMigrationAccepted( E, P, public, old_route, new_route, route_digest
     ) @ #accept) ⇒
    ((∃ #authorize.
       (RouteMigrationAuthorized( E, P, public, old_route, new_route,
                                  route_digest
        ) @ #authorize) ∧
       (#authorize < #accept)) ∨
     (∃ #c. (IdentityMaterialCompromise( E, public ) @ #c) ∧ (#c < #accept)))"
/*
guarded formula characterizing all counter-examples:
"∃ E P public old_route new_route route_digest #accept.
  (RouteMigrationAccepted( E, P, public, old_route, new_route, route_digest
   ) @ #accept)
 ∧
  (∀ #authorize.
    (RouteMigrationAuthorized( E, P, public, old_route, new_route,
                               route_digest
     ) @ #authorize)
   ⇒
    ¬(#authorize < #accept)) ∧
  (∀ #c. (IdentityMaterialCompromise( E, public ) @ #c) ⇒ ¬(#c < #accept))"
*/
simplify
solve( !IdentityVerification( $E, secret ) ▶₀ #accept )
  case ProvisionPair_case_1
  solve( !KU( sign(<'route-migration', 
                    'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                    P, old_route, new_route, route_digest>,
                   ~identity_secret_i)
         ) @ #vk.12 )
    case AuthorizeRouteMigration
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_i ) @ #vk.18 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
next
  case ProvisionPair_case_2
  solve( !KU( sign(<'route-migration', 
                    'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                    P, old_route, new_route, route_digest>,
                   ~identity_secret_r)
         ) @ #vk.12 )
    case AuthorizeRouteMigration
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_r ) @ #vk.18 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
qed

lemma SEC_016_evidence_unforgeability:
  all-traces
  "∀ E public statement signed #accept.
    (EvidenceAccepted( E, public, statement, signed ) @ #accept) ⇒
    ((∃ #issue.
       (EvidenceIssued( E, public, statement, signed ) @ #issue) ∧
       (#issue < #accept)) ∨
     (∃ #c. (IdentityMaterialCompromise( E, public ) @ #c) ∧ (#c < #accept)))"
/*
guarded formula characterizing all counter-examples:
"∃ E public statement signed #accept.
  (EvidenceAccepted( E, public, statement, signed ) @ #accept)
 ∧
  (∀ #issue.
    (EvidenceIssued( E, public, statement, signed ) @ #issue)
   ⇒
    ¬(#issue < #accept)) ∧
  (∀ #c. (IdentityMaterialCompromise( E, public ) @ #c) ⇒ ¬(#c < #accept))"
*/
simplify
solve( !IdentityVerification( $E, secret ) ▶₀ #accept )
  case ProvisionPair_case_1
  solve( !KU( sign(<'endpoint-evidence', 
                    'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                    statement>,
                   ~identity_secret_i)
         ) @ #vk.6 )
    case IssueEvidence
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_i ) @ #vk.9 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
next
  case ProvisionPair_case_2
  solve( !KU( sign(<'endpoint-evidence', 
                    'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                    statement>,
                   ~identity_secret_r)
         ) @ #vk.6 )
    case IssueEvidence
    by contradiction /* from formulas */
  next
    case c_sign
    solve( !KU( ~identity_secret_r ) @ #vk.9 )
      case CompromiseIdentityMaterial
      by contradiction /* from formulas */
    qed
  qed
qed

lemma SEC_017_evidence_identity_attribution:
  all-traces
  "∀ E public statement signed #accept.
    (EvidenceAccepted( E, public, statement, signed ) @ #accept) ⇒
    ((∃ #provision.
       (EndpointIdentityProvisioned( E, public ) @ #provision) ∧
       (#provision < #accept)) ∧
     ((∃ #issue.
        (EvidenceIssued( E, public, statement, signed ) @ #issue) ∧
        (#issue < #accept)) ∨
      (∃ #c.
        (IdentityMaterialCompromise( E, public ) @ #c) ∧ (#c < #accept))))"
/*
guarded formula characterizing all counter-examples:
"∃ E public statement signed #accept.
  (EvidenceAccepted( E, public, statement, signed ) @ #accept)
 ∧
  ((∀ #provision.
     (EndpointIdentityProvisioned( E, public ) @ #provision)
    ⇒
     ¬(#provision < #accept)) ∨
   ((∀ #issue.
      (EvidenceIssued( E, public, statement, signed ) @ #issue)
     ⇒
      ¬(#issue < #accept)) ∧
    (∀ #c.
      (IdentityMaterialCompromise( E, public ) @ #c) ⇒ ¬(#c < #accept))))"
*/
simplify
solve( (∀ #provision.
         (EndpointIdentityProvisioned( $E, pk(secret) ) @ #provision)
        ⇒
         ¬(#provision < #accept))  ∥
       ((∀ #issue.
          (EvidenceIssued( $E, pk(secret), statement,
                           sign(<'endpoint-evidence', 
                                 'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                                 statement>,
                                secret)
           ) @ #issue)
         ⇒
          ¬(#issue < #accept)) ∧
        (∀ #c.
          (IdentityMaterialCompromise( $E, pk(secret) ) @ #c) ⇒ ¬(#c < #accept))) )
  case case_1
  solve( !IdentityVerification( $E, secret ) ▶₀ #accept )
    case ProvisionPair_case_1
    by contradiction /* from formulas */
  next
    case ProvisionPair_case_2
    by contradiction /* from formulas */
  qed
next
  case case_2
  solve( !IdentityVerification( $E, secret ) ▶₀ #accept )
    case ProvisionPair_case_1
    solve( !KU( sign(<'endpoint-evidence', 
                      'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                      statement>,
                     ~identity_secret_i)
           ) @ #vk.6 )
      case IssueEvidence
      by contradiction /* from formulas */
    next
      case c_sign
      solve( !KU( ~identity_secret_i ) @ #vk.9 )
        case CompromiseIdentityMaterial
        by contradiction /* from formulas */
      qed
    qed
  next
    case ProvisionPair_case_2
    solve( !KU( sign(<'endpoint-evidence', 
                      'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', $E, 
                      statement>,
                     ~identity_secret_r)
           ) @ #vk.6 )
      case IssueEvidence
      by contradiction /* from formulas */
    next
      case c_sign
      solve( !KU( ~identity_secret_r ) @ #vk.9 )
        case CompromiseIdentityMaterial
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

lemma SEC_018_station_cannot_manufacture_endpoint_accepted:
  all-traces
  "∀ R S td direction n message packet chain #accept.
    (EndpointAccepted( R, S, td, direction, n, message, packet, chain
     ) @ #accept) ⇒
    ((((∃ #send.
         (RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send) ∧
         (#send < #accept)) ∨
       (∃ E P #c.
         (SessionCompromise( E, P, td, chain ) @ #c) ∧ (#c < #accept))) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td, chain ) @ #c) ∧ (#c < #accept))) ∨
     ((∃ I P #c.
        (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ∧
        (#c < #accept)) ∧
      (∃ I P #q.
        (PostQuantumComponentCompromise( I, P, td, chain ) @ #q) ∧
        (#q < #accept))))"
/*
guarded formula characterizing all counter-examples:
"∃ R S td direction n message packet chain #accept.
  (EndpointAccepted( R, S, td, direction, n, message, packet, chain
   ) @ #accept)
 ∧
  (∀ #send.
    (RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send)
   ⇒
    ¬(#send < #accept)) ∧
  (∀ E P #c.
    (SessionCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #accept)) ∧
  (∀ E P #c.
    (RatchetKeyCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #accept)) ∧
  (((∀ I P #c.
      (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
     ⇒
      ¬(#c < #accept)) ∨
    (∀ I P #q.
      (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
     ⇒
      ¬(#q < #accept))))"
*/
simplify
solve( (∀ I P #c.
         (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
        ⇒
         ¬(#c < #accept))  ∥
       (∀ I P #q.
         (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
        ⇒
         ¬(#q < #accept)) )
  case case_1
  solve( ChainState( $R, S, td, direction, n, chain ) ▶₀ #accept )
    case InitiatorAccept
    solve( !KU( senc(<message, sender_metadata, 
                      h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                         'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                         'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $R, 
                         $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>), 
                      'i2r', ~coordinate>,
                     ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                  h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                     'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                     'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $R, 
                                     $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>)))
           ) @ #vk )
      case SendRecord
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( ~coordinate ) @ #vk.10 )
        case SendRecord
        solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                 h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                    'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                    'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $R, 
                                    $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
               ) @ #vk.3 )
          case CompromiseSession_case_1
          by contradiction /* from formulas */
        next
          case CompromiseSession_case_2
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_1
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_2

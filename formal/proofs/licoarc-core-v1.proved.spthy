lemma SEC_009_initial_forward_secrecy:
  all-traces
  "∀ R I pair td root #accept #know.
    (((ResponderAccepted( R, I, pair, td, root ) @ #accept) ∧
      (K( root ) @ #know)) ∧
     (#accept < #know)) ⇒
    (((∃ E P #c. (SessionCompromise( E, P, td, root ) @ #c) ∧ (#c < #know)) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td, root ) @ #c) ∧ (#c < #know))) ∨
     ((∃ #c.
        (ClassicalComponentCompromise( I, R, td, root ) @ #c) ∧ (#c < #know)) ∧
      (∃ #q.
        (PostQuantumComponentCompromise( I, R, td, root ) @ #q) ∧
        (#q < #know))))"
/*
guarded formula characterizing all counter-examples:
"∃ R I pair td root #accept #know.
  (ResponderAccepted( R, I, pair, td, root ) @ #accept) ∧
  (K( root ) @ #know)
 ∧
  (#accept < #know) ∧
  (∀ E P #c. (SessionCompromise( E, P, td, root ) @ #c) ⇒ ¬(#c < #know)) ∧
  (∀ E P #c.
    (RatchetKeyCompromise( E, P, td, root ) @ #c) ⇒ ¬(#c < #know)) ∧
  (((∀ #c.
      (ClassicalComponentCompromise( I, R, td, root ) @ #c) ⇒ ¬(#c < #know)) ∨
    (∀ #q.
      (PostQuantumComponentCompromise( I, R, td, root ) @ #q)
     ⇒
      ¬(#q < #know))))"
*/
simplify
solve( (∀ #c.
         (ClassicalComponentCompromise( I, $R, td, root ) @ #c)
        ⇒
         ¬(#c < #know))  ∥
       (∀ #q.
         (PostQuantumComponentCompromise( I, $R, td, root ) @ #q)
        ⇒
         ¬(#q < #know)) )
  case case_1
  solve( ResponderReady( $R, I, pair, prekey_pub ) ▶₀ #accept )
    case ProvisionPair
    solve( HandshakeOffer( $I, $R, ~pair, td, root, coordinate ) ▶₁ #accept )
      case InitiatorFirstPacket
      solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $I, $R,
                               h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                  'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                  'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $I, 
                                  $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
             ) @ #vk )
        case CompromiseSession_case_1
        by contradiction /* from formulas */
      next
        case CompromiseSession_case_2
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_1
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_2
        by contradiction /* from formulas */
      next
        case c_ideal_hybrid
        solve( !KU( ~classical_component ) @ #vk.1 )
          case CompromiseClassicalComponent
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( ResponderReady( $R, I, pair, prekey_pub ) ▶₀ #accept )
    case ProvisionPair
    solve( HandshakeOffer( $I, $R, ~pair, td, root, coordinate ) ▶₁ #accept )
      case InitiatorFirstPacket
      solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $I, $R,
                               h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                  'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                  'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $I, 
                                  $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
             ) @ #vk )
        case CompromiseSession_case_1
        by contradiction /* from formulas */
      next
        case CompromiseSession_case_2
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_1
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_2
        by contradiction /* from formulas */
      next
        case c_ideal_hybrid
        solve( !KU( ~classical_component ) @ #vk.1 )
          case CompromiseClassicalComponent
          solve( !KU( ~pq_component ) @ #vk.2 )
            case CompromisePostQuantumComponent
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

lemma SEC_010_double_ratchet_forward_secrecy:
  all-traces
  "∀ E P td old next #advance #know.
    ((RatchetAdvanced( E, P, td, old, next ) @ #advance) ∧
     (K( old ) @ #know)) ⇒
    (((∃ E2 P2 #c.
        (SessionCompromise( E2, P2, td, old ) @ #c) ∧ (#c < #know)) ∨
      (∃ E2 P2 #c.
        (RatchetKeyCompromise( E2, P2, td, old ) @ #c) ∧ (#c < #know))) ∨
     ((∃ I R #c.
        (ClassicalComponentCompromise( I, R, td, old ) @ #c) ∧ (#c < #know)) ∧
      (∃ I R #q.
        (PostQuantumComponentCompromise( I, R, td, old ) @ #q) ∧ (#q < #know))))"
/*
guarded formula characterizing all counter-examples:
"∃ E P td old next #advance #know.
  (RatchetAdvanced( E, P, td, old, next ) @ #advance) ∧ (K( old ) @ #know)
 ∧
  (∀ E2 P2 #c.
    (SessionCompromise( E2, P2, td, old ) @ #c) ⇒ ¬(#c < #know)) ∧
  (∀ E2 P2 #c.
    (RatchetKeyCompromise( E2, P2, td, old ) @ #c) ⇒ ¬(#c < #know)) ∧
  (((∀ I R #c.
      (ClassicalComponentCompromise( I, R, td, old ) @ #c) ⇒ ¬(#c < #know)) ∨
    (∀ I R #q.
      (PostQuantumComponentCompromise( I, R, td, old ) @ #q)
     ⇒
      ¬(#q < #know))))"
*/
simplify
solve( (∀ I R #c.
         (ClassicalComponentCompromise( I, R, td, old ) @ #c) ⇒ ¬(#c < #know))  ∥
       (∀ I R #q.
         (PostQuantumComponentCompromise( I, R, td, old ) @ #q) ⇒ ¬(#q < #know)) )
  case case_1
  solve( RatchetInitial( $E, P, td, old ) ▶₀ #advance )
    case InitiatorAccept
    solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $E, $R,
                             h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $E, 
                                $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
           ) @ #vk )
      case CompromiseSession_case_1
      by contradiction /* from formulas */
    next
      case CompromiseSession_case_2
      by contradiction /* from formulas */
    next
      case RatchetCompromiseBeforeRecovery
      by contradiction /* from formulas */
    next
      case c_ideal_hybrid
      solve( !KU( ~classical_component ) @ #vk.1 )
        case CompromiseClassicalComponent
        by contradiction /* from formulas */
      qed
    qed
  next
    case ResponderAccept
    solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $I, $E,
                             h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $I, 
                                $E, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
           ) @ #vk )
      case CompromiseSession_case_1
      by contradiction /* from formulas */
    next
      case CompromiseSession_case_2
      by contradiction /* from formulas */
    next
      case RatchetCompromiseBeforeRecovery
      by contradiction /* from formulas */
    next
      case c_ideal_hybrid
      solve( !KU( ~classical_component ) @ #vk.1 )
        case CompromiseClassicalComponent
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case case_2
  solve( RatchetInitial( $E, P, td, old ) ▶₀ #advance )
    case InitiatorAccept
    solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $E, $R,
                             h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $E, 
                                $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
           ) @ #vk )
      case CompromiseSession_case_1
      by contradiction /* from formulas */
    next
      case CompromiseSession_case_2
      by contradiction /* from formulas */
    next
      case RatchetCompromiseBeforeRecovery
      by contradiction /* from formulas */
    next
      case c_ideal_hybrid
      solve( !KU( ~classical_component ) @ #vk.1 )
        case CompromiseClassicalComponent
        solve( !KU( ~pq_component ) @ #vk.2 )
          case CompromisePostQuantumComponent
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case ResponderAccept
    solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $I, $E,
                             h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $I, 
                                $E, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
           ) @ #vk )
      case CompromiseSession_case_1
      by contradiction /* from formulas */
    next
      case CompromiseSession_case_2
      by contradiction /* from formulas */
    next
      case RatchetCompromiseBeforeRecovery
      by contradiction /* from formulas */
    next
      case c_ideal_hybrid
      solve( !KU( ~classical_component ) @ #vk.1 )
        case CompromiseClassicalComponent
        solve( !KU( ~pq_component ) @ #vk.2 )
          case CompromisePostQuantumComponent
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

lemma SEC_011_double_ratchet_post_compromise_recovery:
  all-traces
  "∀ E P td old next #recover #know.
    ((RatchetRecovered( E, P, td, old, next ) @ #recover) ∧
     (K( next ) @ #know)) ⇒
    (∃ #c. (RatchetKeyCompromise( E, P, td, next ) @ #c) ∧ (#c < #know))"
/*
guarded formula characterizing all counter-examples:
"∃ E P td old next #recover #know.
  (RatchetRecovered( E, P, td, old, next ) @ #recover) ∧
  (K( next ) @ #know)
 ∧
  ∀ #c. (RatchetKeyCompromise( E, P, td, next ) @ #c) ⇒ ¬(#c < #know)"
*/
simplify
solve( RatchetExposed( $E, P, td, old ) ▶₀ #recover )
  case RatchetCompromiseBeforeRecovery_case_1
  solve( !KU( ratchet_step(ideal_hybrid(~classical_component,
                                        ~pq_component, $I, $E,
                                        h(<
                                           'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                           'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                           'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', 
                                           $I, $E, ~pair, h(~prekey), h(~classical_component), 
                                           h(~pq_component)>)),
                           ~fresh_dh)
         ) @ #vk )
    case RatchetCompromiseAdvanced
    by contradiction /* from formulas */
  next
    case c_ratchet_step
    by solve( !KU( ~fresh_dh ) @ #vk.2 )
  qed
next
  case RatchetCompromiseBeforeRecovery_case_2
  solve( !KU( ratchet_step(ideal_hybrid(~classical_component,
                                        ~pq_component, $E, $R,
                                        h(<
                                           'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                           'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                           'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', 
                                           $E, $R, ~pair, h(~prekey), h(~classical_component), 
                                           h(~pq_component)>)),
                           ~fresh_dh)
         ) @ #vk )
    case RatchetCompromiseAdvanced
    by contradiction /* from formulas */
  next
    case c_ratchet_step
    by solve( !KU( ~fresh_dh ) @ #vk.2 )
  qed
qed

lemma SEC_012_replay_resistance:
  all-traces
  "∀ R S td direction n m1 p1 c1 m2 p2 c2 #i #j.
    ((RecordReceived( R, S, td, direction, n, m1, p1, c1 ) @ #i) ∧
     (RecordReceived( R, S, td, direction, n, m2, p2, c2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ R S td direction n m1 p1 c1 m2 p2 c2 #i #j.
  (RecordReceived( R, S, td, direction, n, m1, p1, c1 ) @ #i) ∧
  (RecordReceived( R, S, td, direction, n, m2, p2, c2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( ChainState( $R, S, td, direction, n, c1 ) ▶₀ #i )
    case InitiatorAccept
    solve( ChainState( $R, $R.1,
                       h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                          'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                          'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $R, 
                          $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                       'i2r', ~coordinate, c2
           ) ▶₀ #j )
      case InitiatorAccept
      by contradiction /* cyclic */
    next
      case ResponderAccept
      solve( !KU( senc(<m1, sender_metadata, 
                        h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                           'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 

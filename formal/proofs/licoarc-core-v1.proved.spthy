                           $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>), 
                        'i2r', ~coordinate>,
                       ideal_hybrid(~classical_component, ~pq_component, $R, $R,
                                    h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                       'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                       'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', 
                                       $R, $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)
                                      >)))
             ) @ #vk )
        case c_senc
        by solve( !KU( ~coordinate ) @ #vk.11 )
      qed
    qed
  next
    case ResponderAccept
    solve( ChainState( $R, $I,
                       h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                          'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                          'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $I, 
                          $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                       'i2r', ~coordinate, c2
           ) ▶₀ #j )
      case InitiatorAccept
      solve( !KU( senc(<m1, sender_metadata, 
                        h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                           'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                           'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $I, 
                           $I, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>), 
                        'i2r', ~coordinate>,
                       ideal_hybrid(~classical_component, ~pq_component, $I, $I,
                                    h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                       'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                       'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', 
                                       $I, $I, ~pair, h(~prekey), h(~classical_component), h(~pq_component)
                                      >)))
             ) @ #vk )
        case c_senc
        by solve( !KU( ~coordinate ) @ #vk.11 )
      qed
    next
      case ResponderAccept
      by contradiction /* cyclic */
    qed
  qed
next
  case case_2

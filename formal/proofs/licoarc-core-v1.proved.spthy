lemma SEC_008_session_independence:
  all-traces
  "∀ I1 R1 td1 root1 I2 R2 td2 root2 #e1 #e2 #compromise #know.
    (((((HybridEstablished( I1, R1, td1, root1 ) @ #e1) ∧
        (HybridEstablished( I2, R2, td2, root2 ) @ #e2)) ∧
       (SessionCompromise( I1, R1, td1, root1 ) @ #compromise)) ∧
      (K( root2 ) @ #know)) ∧
     (¬(root1 = root2))) ⇒
    (((∃ E P #c.
        (SessionCompromise( E, P, td2, root2 ) @ #c) ∧ (#c < #know)) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td2, root2 ) @ #c) ∧ (#c < #know))) ∨
     ((∃ #c.
        (ClassicalComponentCompromise( I2, R2, td2, root2 ) @ #c) ∧
        (#c < #know)) ∧
      (∃ #q.
        (PostQuantumComponentCompromise( I2, R2, td2, root2 ) @ #q) ∧
        (#q < #know))))"
/*
guarded formula characterizing all counter-examples:
"∃ I1 R1 td1 root1 I2 R2 td2 root2 #e1 #e2 #compromise #know.
  (HybridEstablished( I1, R1, td1, root1 ) @ #e1) ∧
  (HybridEstablished( I2, R2, td2, root2 ) @ #e2) ∧
  (SessionCompromise( I1, R1, td1, root1 ) @ #compromise) ∧
  (K( root2 ) @ #know)
 ∧
  (¬(root1 = root2)) ∧
  (∀ E P #c.
    (SessionCompromise( E, P, td2, root2 ) @ #c) ⇒ ¬(#c < #know)) ∧
  (∀ E P #c.
    (RatchetKeyCompromise( E, P, td2, root2 ) @ #c) ⇒ ¬(#c < #know)) ∧
  (((∀ #c.
      (ClassicalComponentCompromise( I2, R2, td2, root2 ) @ #c)
     ⇒
      ¬(#c < #know)) ∨
    (∀ #q.
      (PostQuantumComponentCompromise( I2, R2, td2, root2 ) @ #q)
     ⇒
      ¬(#q < #know))))"
*/
simplify
solve( (∀ #c.
         (ClassicalComponentCompromise( $I.1, R2,
                                        h(<
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                           '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                           $I.1, R2, pair.1, prekey_pub.1, h(~classical_component.1),
                                           h(~pq_component.1)>),
                                        ideal_hybrid(~classical_component.1, ~pq_component.1, $I.1, R2,
                                                     h(<
                                                        'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                        'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                                        '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                                        $I.1, R2, pair.1, prekey_pub.1,
                                                        h(~classical_component.1), h(~pq_component.1)>))
          ) @ #c)
        ⇒
         ¬(#c < #know))  ∥
       (∀ #q.
         (PostQuantumComponentCompromise( $I.1, R2,
                                          h(<
                                             'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                             'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                             '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                             $I.1, R2, pair.1, prekey_pub.1, h(~classical_component.1),
                                             h(~pq_component.1)>),
                                          ideal_hybrid(~classical_component.1, ~pq_component.1, $I.1, R2,
                                                       h(<
                                                          'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                          'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                                          '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                                          $I.1, R2, pair.1, prekey_pub.1,
                                                          h(~classical_component.1), h(~pq_component.1)>))
          ) @ #q)
        ⇒
         ¬(#q < #know)) )
  case case_1
  solve( InitiatorReady( $I, R1, pair, prekey_pub ) ▶₀ #e1 )
    case ProvisionPair
    solve( InitiatorReady( $I.1, R2, pair.1, prekey_pub ) ▶₀ #e2 )
      case ProvisionPair
      solve( !Established( $I, $R,
                           h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                              'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                              '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                              $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                           ideal_hybrid(~classical_component, ~pq_component, $I, $R,
                                        h(<
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                           '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                           $I, $R, ~pair, h(~prekey), h(~classical_component),
                                           h(~pq_component)>))
             ) ▶₀ #compromise )
        case InitiatorAccept
        solve( !KU( ideal_hybrid(~classical_component.1, ~pq_component.1, $I.1,
                                 $R.1,
                                 h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                    'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                    '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                    $I.1, $R.1, ~pair.1, h(~prekey.1), h(~classical_component.1),
                                    h(~pq_component.1)>))
               ) @ #vk )
          case CompromiseSession_case_1
          by contradiction /* from formulas */
        next
          case CompromiseSession_case_2
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_1
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_2
          by contradiction /* from formulas */
        next
          case c_ideal_hybrid
          solve( !KU( ~classical_component.1 ) @ #vk.1 )
            case CompromiseClassicalComponent
            by contradiction /* from formulas */
          qed
        qed
      next
        case ResponderAccept
        solve( !KU( ideal_hybrid(~classical_component.1, ~pq_component.1, $I.1,
                                 $R,
                                 h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                    'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                    '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                    $I.1, $R, ~pair.1, h(~prekey.1), h(~classical_component.1),
                                    h(~pq_component.1)>))
               ) @ #vk )
          case CompromiseSession_case_1
          by contradiction /* from formulas */
        next
          case CompromiseSession_case_2
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_1
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_2
          by contradiction /* from formulas */
        next
          case c_ideal_hybrid
          solve( !KU( ~classical_component.1 ) @ #vk.1 )
            case CompromiseClassicalComponent
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( InitiatorReady( $I, R1, pair, prekey_pub ) ▶₀ #e1 )
    case ProvisionPair
    solve( InitiatorReady( $I.1, R2, pair.1, prekey_pub ) ▶₀ #e2 )
      case ProvisionPair
      solve( !Established( $I, $R,
                           h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                              'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                              '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                              $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                           ideal_hybrid(~classical_component, ~pq_component, $I, $R,
                                        h(<
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                           '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                           $I, $R, ~pair, h(~prekey), h(~classical_component),
                                           h(~pq_component)>))
             ) ▶₀ #compromise )
        case InitiatorAccept
        solve( !KU( ideal_hybrid(~classical_component.1, ~pq_component.1, $I.1,
                                 $R.1,
                                 h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                    'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                    '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                    $I.1, $R.1, ~pair.1, h(~prekey.1), h(~classical_component.1),
                                    h(~pq_component.1)>))
               ) @ #vk )
          case CompromiseSession_case_1
          by contradiction /* from formulas */
        next
          case CompromiseSession_case_2
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_1
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_2
          by contradiction /* from formulas */
        next
          case c_ideal_hybrid
          solve( !KU( ~classical_component.1 ) @ #vk.1 )
            case CompromiseClassicalComponent
            solve( !KU( ~pq_component.1 ) @ #vk.2 )
              case CompromisePostQuantumComponent
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case ResponderAccept
        solve( !KU( ideal_hybrid(~classical_component.1, ~pq_component.1, $I.1,
                                 $R,
                                 h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                    'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                    '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17',
                                    $I.1, $R, ~pair.1, h(~prekey.1), h(~classical_component.1),
                                    h(~pq_component.1)>))
               ) @ #vk )

lemma SEC_023_sender_metadata_confidentiality:
  all-traces
  "∀ S R td metadata packet chain #send #know.
    ((SenderMetadataProtected( S, R, td, metadata, packet, chain ) @ #send) ∧
     (K( metadata ) @ #know)) ⇒
    (((∃ E P #c.
        (SessionCompromise( E, P, td, chain ) @ #c) ∧ (#c < #know)) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td, chain ) @ #c) ∧ (#c < #know))) ∨
     ((∃ I P #c.
        (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ∧ (#c < #know)) ∧
      (∃ I P #q.
        (PostQuantumComponentCompromise( I, P, td, chain ) @ #q) ∧
        (#q < #know))))"
/*
guarded formula characterizing all counter-examples:
"∃ S R td metadata packet chain #send #know.
  (SenderMetadataProtected( S, R, td, metadata, packet, chain ) @ #send) ∧
  (K( metadata ) @ #know)
 ∧
  (∀ E P #c. (SessionCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #know)) ∧
  (∀ E P #c.
    (RatchetKeyCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #know)) ∧
  (((∀ I P #c.
      (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ⇒ ¬(#c < #know)) ∨
    (∀ I P #q.
      (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
     ⇒
      ¬(#q < #know))))"
*/
simplify
solve( (∀ I P #c.
         (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
        ⇒
         ¬(#c < #know))  ∥
       (∀ I P #q.
         (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
        ⇒
         ¬(#q < #know)) )
  case case_1
  solve( ChainState( $S, R, td, direction, n, chain ) ▶₀ #send )
    case InitiatorAccept
    solve( !KU( ~sender_metadata ) @ #vk )
      case SendRecord
      solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $S, $R,
                               h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                  'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                  '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $S,
                                  $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
             ) @ #vk.1 )
        case CompromiseSession_case_1
        by contradiction /* from formulas */
      next
        case CompromiseSession_case_2
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_1
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_2
        by contradiction /* from formulas */
      next
        case c_ideal_hybrid
        solve( !KU( ~classical_component ) @ #vk.2 )
          case CompromiseClassicalComponent
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case ResponderAccept
    solve( !KU( ~sender_metadata ) @ #vk )
      case SendRecord
      solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $I, $S,
                               h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                  'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                  '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                                  $S, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
             ) @ #vk.1 )
        case CompromiseSession_case_1
        by contradiction /* from formulas */
      next
        case CompromiseSession_case_2
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_1
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_2
        by contradiction /* from formulas */
      next
        case c_ideal_hybrid
        solve( !KU( ~classical_component ) @ #vk.2 )
          case CompromiseClassicalComponent
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( ChainState( $S, R, td, direction, n, chain ) ▶₀ #send )
    case InitiatorAccept
    solve( !KU( ~sender_metadata ) @ #vk )
      case SendRecord
      solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $S, $R,
                               h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                  'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                  '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $S,
                                  $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
             ) @ #vk.1 )
        case CompromiseSession_case_1
        by contradiction /* from formulas */
      next
        case CompromiseSession_case_2
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_1
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_2
        by contradiction /* from formulas */
      next
        case c_ideal_hybrid
        solve( !KU( ~classical_component ) @ #vk.2 )
          case CompromiseClassicalComponent
          solve( !KU( ~pq_component ) @ #vk.3 )
            case CompromisePostQuantumComponent
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case ResponderAccept
    solve( !KU( ~sender_metadata ) @ #vk )
      case SendRecord
      solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $I, $S,
                               h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                  'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                  '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                                  $S, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
             ) @ #vk.1 )
        case CompromiseSession_case_1
        by contradiction /* from formulas */
      next
        case CompromiseSession_case_2
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_1
        by contradiction /* from formulas */
      next
        case RatchetCompromiseBeforeRecovery_case_2
        by contradiction /* from formulas */
      next
        case c_ideal_hybrid
        solve( !KU( ~classical_component ) @ #vk.2 )
          case CompromiseClassicalComponent
          solve( !KU( ~pq_component ) @ #vk.3 )
            case CompromisePostQuantumComponent
            by contradiction /* from formulas */
          qed
        qed

  all-traces
  "∀ S R td direction n message packet chain #send #know.
    ((RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send) ∧
     (K( message ) @ #know)) ⇒
    (((∃ E P #c.
        (SessionCompromise( E, P, td, chain ) @ #c) ∧ (#c < #know)) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td, chain ) @ #c) ∧ (#c < #know))) ∨
     ((∃ I P #c.
        (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ∧ (#c < #know)) ∧
      (∃ I P #q.

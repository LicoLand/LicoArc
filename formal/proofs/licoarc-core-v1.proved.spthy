lemma SEC_019_station_cannot_manufacture_effect_completed:
  all-traces
  "∀ R S td direction n message_digest #complete.
    (EndpointEffectCompleted( R, S, td, direction, n, message_digest
     ) @ #complete) ⇒
    (∃ message packet chain #accept.
      (EndpointAccepted( R, S, td, direction, n, message, packet, chain
       ) @ #accept) ∧
      (#accept < #complete))"
/*
guarded formula characterizing all counter-examples:
"∃ R S td direction n message_digest #complete.
  (EndpointEffectCompleted( R, S, td, direction, n, message_digest
   ) @ #complete)
 ∧
  ∀ message packet chain #accept.
   (EndpointAccepted( R, S, td, direction, n, message, packet, chain
    ) @ #accept)
  ⇒
   ¬(#accept < #complete)"
*/
simplify
solve( !DurableInbox( $E, S, td, direction, n, message_digest
       ) ▶₀ #complete )
  case ReceiveRecord_case_1
  by contradiction /* from formulas */
next
  case ReceiveRecord_case_2
  by contradiction /* from formulas */
qed

lemma SEC_020_fail_closed_resource_bounds:
  all-traces
  "(∀ input #accept.
     (ParserAccepted( input ) @ #accept) ⇒
     (ResourceBoundsValidated( input,
                               'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd'
      ) @ #accept)) ∧
   (∀ input #reject.
     (ResourceLimitRejected( input,
                             'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd'
      ) @ #reject) ⇒
     (¬(∃ #commit. ParserStateCommitted( input ) @ #commit)))"
/*
guarded formula characterizing all counter-examples:
"((∃ input #accept.
    (ParserAccepted( input ) @ #accept)
   ∧
    ¬(ResourceBoundsValidated( input,
                               'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd'
      ) @ #accept)) ∨
  (∃ input #reject.
    (ResourceLimitRejected( input,
                            'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd'
     ) @ #reject)
   ∧
    ∃ #commit. (ParserStateCommitted( input ) @ #commit)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (∃ input #accept.
           (ParserAccepted( input ) @ #accept)
          ∧
           ¬(ResourceBoundsValidated( input,
                                      'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd'
             ) @ #accept))  ∥
         (∃ input #reject.
           (ResourceLimitRejected( input,
                                   'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd'
            ) @ #reject)
          ∧
           ∃ #commit. (ParserStateCommitted( input ) @ #commit)) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    solve( (last(#reject))  ∥
           (∀ #commit. (ParserStateCommitted( input ) @ #commit) ⇒ last(#commit)) )
      case case_1
      solve( OverResourceBounds( input ) ▶₀ #reject )
        case ClassifyOverResourceBounds
        by solve( WithinResourceBounds( ~input ) ▶₀ #commit )
      qed
    next
      case case_2
      solve( OverResourceBounds( input ) ▶₀ #reject )
        case ClassifyOverResourceBounds
        by solve( WithinResourceBounds( ~input ) ▶₀ #commit )
      qed
    qed
  qed
qed

lemma SEC_022_pairwise_record_authentication_and_integrity:
  all-traces
  "∀ R S td direction n message packet chain #receive.
    (RecordReceived( R, S, td, direction, n, message, packet, chain
     ) @ #receive) ⇒
    ((((∃ #send.
         (RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send) ∧
         (#send < #receive)) ∨
       (∃ E P #c.
         (SessionCompromise( E, P, td, chain ) @ #c) ∧ (#c < #receive))) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td, chain ) @ #c) ∧ (#c < #receive))) ∨
     ((∃ I P #c.
        (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ∧
        (#c < #receive)) ∧
      (∃ I P #q.
        (PostQuantumComponentCompromise( I, P, td, chain ) @ #q) ∧
        (#q < #receive))))"
/*
guarded formula characterizing all counter-examples:
"∃ R S td direction n message packet chain #receive.
  (RecordReceived( R, S, td, direction, n, message, packet, chain
   ) @ #receive)
 ∧
  (∀ #send.
    (RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send)
   ⇒
    ¬(#send < #receive)) ∧
  (∀ E P #c.
    (SessionCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #receive)) ∧
  (∀ E P #c.
    (RatchetKeyCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #receive)) ∧
  (((∀ I P #c.
      (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
     ⇒
      ¬(#c < #receive)) ∨
    (∀ I P #q.
      (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
     ⇒
      ¬(#q < #receive))))"
*/
simplify
solve( (∀ I P #c.
         (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
        ⇒
         ¬(#c < #receive))  ∥
       (∀ I P #q.
         (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
        ⇒
         ¬(#q < #receive)) )
  case case_1
  solve( ChainState( $R, S, td, direction, n, chain ) ▶₀ #receive )
    case InitiatorAccept
    solve( !KU( senc(<message, sender_metadata, 
                      h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                         'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                         'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $R, 
                         $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>), 
                      'i2r', ~coordinate>,
                     ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                  h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                     'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 
                                     'c79674646025916c801a78fed1d3aa5adf83775602d8a9dea06ad615e19273cf', $R, 
                                     $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>)))
           ) @ #vk )
      case SendRecord
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( ~coordinate ) @ #vk.10 )
        case SendRecord
        solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                 h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                                    'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 

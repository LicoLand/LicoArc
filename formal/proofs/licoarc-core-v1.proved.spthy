lemma SEC_021_pairwise_record_confidentiality:
  all-traces
  "∀ S R td direction n message packet chain #send #know.
    ((RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send) ∧
     (K( message ) @ #know)) ⇒
    (((∃ E P #c.
        (SessionCompromise( E, P, td, chain ) @ #c) ∧ (#c < #know)) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td, chain ) @ #c) ∧ (#c < #know))) ∨
     ((∃ I P #c.
        (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ∧ (#c < #know)) ∧
      (∃ I P #q.
        (PostQuantumComponentCompromise( I, P, td, chain ) @ #q) ∧
        (#q < #know))))"
/*
guarded formula characterizing all counter-examples:
"∃ S R td direction n message packet chain #send #know.
  (RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send) ∧
  (K( message ) @ #know)
 ∧
  (∀ E P #c. (SessionCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #know)) ∧
  (∀ E P #c.
    (RatchetKeyCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #know)) ∧
  (((∀ I P #c.
      (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ⇒ ¬(#c < #know)) ∨
    (∀ I P #q.
      (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
     ⇒
      ¬(#q < #know))))"
*/
simplify
solve( (∀ I P #c.
         (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
        ⇒
         ¬(#c < #know))  ∥
       (∀ I P #q.
         (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
        ⇒
         ¬(#q < #know)) )
  case case_1
  solve( ChainState( $S, R, td, direction, n, chain ) ▶₀ #send )
    case InitiatorAccept
    solve( !KU( ~message ) @ #vk )
      case SendRecord
      solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $S, $R,
                               h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                  'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                  '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $S,
                                  $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
             ) @ #vk.1 )
        case CompromiseSession_case_1
        by contradiction /* from formulas */
      next
        case CompromiseSession_case_2
        by contradiction /* from formulas */
      next

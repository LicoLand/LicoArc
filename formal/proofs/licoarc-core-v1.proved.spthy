lemma SEC_017_endpoint_possession_authorization:
  all-traces
  "∀ user_ref epoch E endpoint_state endpoint_public #accept.
    (EndpointPossessionAccepted( user_ref, epoch, E, endpoint_state,
                                 endpoint_public
     ) @ #accept) ⇒
    ((∃ proof #authorize.
       (EndpointPossessionAuthorized( user_ref, epoch, E, endpoint_state,
                                      endpoint_public, proof
        ) @ #authorize) ∧
       (#authorize < #accept)) ∨
     (∃ #c.
       (EndpointAuthorityCompromise( E, endpoint_public ) @ #c) ∧
       (#c < #accept)))"
/*
guarded formula characterizing all counter-examples:
"∃ user_ref epoch E endpoint_state endpoint_public #accept.
  (EndpointPossessionAccepted( user_ref, epoch, E, endpoint_state,
                               endpoint_public
   ) @ #accept)
 ∧
  (∀ proof #authorize.
    (EndpointPossessionAuthorized( user_ref, epoch, E, endpoint_state,
                                   endpoint_public, proof
     ) @ #authorize)
   ⇒
    ¬(#authorize < #accept)) ∧
  (∀ #c.
    (EndpointAuthorityCompromise( E, endpoint_public ) @ #c)
   ⇒
    ¬(#c < #accept))"
*/
simplify
solve( !AuthorityGenesisVerification( user_ref, authority_state,
                                      management_secret, recovery_secret
       ) ▶₀ #accept )
  case ProvisionUserAuthority
  solve( !EndpointVerification( $E.1, endpoint_secret.1 ) ▶₁ #accept )
    case ProvisionUserAuthority
    solve( AuthorityGenesisEnvelope( h(<'user-authority-genesis',
                                        'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                        pk(~management_secret), pk(~recovery_secret)>),
                                     h(<'user-authority-state',
                                        'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                        h(<'user-authority-genesis',
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           pk(~management_secret), pk(~recovery_secret)>),
                                        '0', pk(~management_secret), pk(~recovery_secret), $E,
                                        h(<'endpoint-state',
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           $E, pk(~endpoint_secret)>)
                                       >),
                                     pk(~management_secret), pk(~recovery_secret), $E.1, endpoint_state,
                                     pk(~endpoint_secret.1),
                                     sign(<'endpoint-possession',
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           h(<'user-authority-genesis',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              pk(~management_secret), pk(~recovery_secret)>),
                                           '0', $E.1, endpoint_state>,
                                          ~endpoint_secret.1),
                                     sign(<'user-authority-genesis-management',
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           h(<'user-authority-genesis',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              pk(~management_secret), pk(~recovery_secret)>),
                                           h(<'user-authority-state',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              h(<'user-authority-genesis',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 pk(~management_secret), pk(~recovery_secret)>),
                                              '0', pk(~management_secret), pk(~recovery_secret), $E,
                                              h(<'endpoint-state',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 $E, pk(~endpoint_secret)>)
                                             >)
                                          >,
                                          ~management_secret),
                                     sign(<'user-authority-genesis-recovery',
                                           'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                           h(<'user-authority-genesis',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              pk(~management_secret), pk(~recovery_secret)>),
                                           h(<'user-authority-state',
                                              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                              h(<'user-authority-genesis',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 pk(~management_secret), pk(~recovery_secret)>),
                                              '0', pk(~management_secret), pk(~recovery_secret), $E,
                                              h(<'endpoint-state',
                                                 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                                 $E, pk(~endpoint_secret)>)
                                             >)
                                          >,
                                          ~recovery_secret)
           ) ▶₂ #accept )
      case ProvisionUserAuthority
      by contradiction /* from formulas */
    qed
  qed
qed

lemma SEC_018_acyclic_sibling_endpoint_authority_session_binding:
  all-traces
  "∀ E P td endpoint_state authority_state peer_endpoint_state
     peer_authority_state #bound.
    (SessionSiblingBound( E, P, td, endpoint_state, authority_state,
                          peer_endpoint_state, peer_authority_state
     ) @ #bound) ⇒
    ((¬(endpoint_state = authority_state)) ∧
     (¬(peer_endpoint_state = peer_authority_state)))"
/*
guarded formula characterizing all counter-examples:
"∃ E P td endpoint_state authority_state peer_endpoint_state
   peer_authority_state #bound.
  (SessionSiblingBound( E, P, td, endpoint_state, authority_state,
                        peer_endpoint_state, peer_authority_state
   ) @ #bound)
 ∧
  ((endpoint_state = authority_state) ∨
   (peer_endpoint_state = peer_authority_state))"
*/
simplify
by contradiction /* from formulas */

lemma SEC_019_authenticated_confirmation_finality:
  all-traces
  "∀ S E td confirmation_id logical_message_ids stage message_digest
     result_digest confirmation public #finality.
    (AuthenticatedConfirmationFinalized( S, E, td, confirmation_id,
                                         logical_message_ids, stage, message_digest, result_digest,
                                         confirmation, public
     ) @ #finality) ⇒
    ((∃ #issue.
       (AuthenticatedConfirmationIssued( E, S, td, confirmation_id,
                                         logical_message_ids, stage, message_digest, result_digest,
                                         confirmation, public
        ) @ #issue) ∧
       (#issue < #finality)) ∨
     (∃ #c.
       (IdentityMaterialCompromise( E, public ) @ #c) ∧ (#c < #finality)))"
/*
guarded formula characterizing all counter-examples:
"∃ S E td confirmation_id logical_message_ids stage message_digest
   result_digest confirmation public #finality.
  (AuthenticatedConfirmationFinalized( S, E, td, confirmation_id,
                                       logical_message_ids, stage, message_digest, result_digest,
                                       confirmation, public
   ) @ #finality)
 ∧
  (∀ #issue.
    (AuthenticatedConfirmationIssued( E, S, td, confirmation_id,
                                      logical_message_ids, stage, message_digest, result_digest, confirmation,
                                      public
     ) @ #issue)
   ⇒
    ¬(#issue < #finality)) ∧
  (∀ #c.
    (IdentityMaterialCompromise( E, public ) @ #c) ⇒ ¬(#c < #finality))"
*/
simplify
solve( !IdentityVerification( E, secret ) ▶₀ #finality )
  case ProvisionPair_case_1
  solve( ConfirmationEnvelope( $I, $S, td, confirmation_id,
                               logical_message_ids, stage, message_digest, result_digest,
                               sign(<'authenticated-confirmation',
                                     'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $I,
                                     $S, td, confirmation_id, logical_message_ids, stage, message_digest,
                                     result_digest>,
                                    ~identity_secret_i)
         ) ▶₁ #finality )
    case IssueAuthenticatedConfirmation_case_1
    by contradiction /* from formulas */
  next
    case IssueAuthenticatedConfirmation_case_2
    by contradiction /* from formulas */
  qed
next
  case ProvisionPair_case_2
  solve( ConfirmationEnvelope( $R, $S, td, confirmation_id,
                               logical_message_ids, stage, message_digest, result_digest,
                               sign(<'authenticated-confirmation',
                                     'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $R,
                                     $S, td, confirmation_id, logical_message_ids, stage, message_digest,
                                     result_digest>,
                                    ~identity_secret_r)
         ) ▶₁ #finality )
    case IssueAuthenticatedConfirmation_case_1
    by contradiction /* from formulas */
  next
    case IssueAuthenticatedConfirmation_case_2
    by contradiction /* from formulas */
  qed
qed

lemma SEC_020_fail_closed_resource_bounds:
  all-traces
  "(∀ input #accept.
     (ParserAccepted( input ) @ #accept) ⇒
     (ResourceBoundsValidated( input,
                               'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc'
      ) @ #accept)) ∧
   (∀ input #reject.
     (ResourceLimitRejected( input,
                             'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc'
      ) @ #reject) ⇒
     (¬(∃ #commit. ParserStateCommitted( input ) @ #commit)))"
/*
guarded formula characterizing all counter-examples:
"((∃ input #accept.
    (ParserAccepted( input ) @ #accept)
   ∧
    ¬(ResourceBoundsValidated( input,
                               'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc'
      ) @ #accept)) ∨
  (∃ input #reject.
    (ResourceLimitRejected( input,
                            'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc'
     ) @ #reject)
   ∧
    ∃ #commit. (ParserStateCommitted( input ) @ #commit)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (∃ input #accept.
           (ParserAccepted( input ) @ #accept)
          ∧
           ¬(ResourceBoundsValidated( input,
                                      'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc'
             ) @ #accept))  ∥
         (∃ input #reject.
           (ResourceLimitRejected( input,
                                   'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc'
            ) @ #reject)
          ∧
           ∃ #commit. (ParserStateCommitted( input ) @ #commit)) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    solve( (last(#reject))  ∥
           (∀ #commit. (ParserStateCommitted( input ) @ #commit) ⇒ last(#commit)) )
      case case_1
      solve( OverResourceBounds( input ) ▶₀ #reject )
        case ClassifyOverResourceBounds
        by solve( WithinResourceBounds( ~input ) ▶₀ #commit )
      qed
    next
      case case_2
      solve( OverResourceBounds( input ) ▶₀ #reject )
        case ClassifyOverResourceBounds
        by solve( WithinResourceBounds( ~input ) ▶₀ #commit )
      qed
    qed
  qed
qed

lemma SEC_022_pairwise_record_authentication_and_integrity:
  all-traces
  "∀ R S td direction n message packet chain #receive.
    (RecordReceived( R, S, td, direction, n, message, packet, chain
     ) @ #receive) ⇒
    ((((∃ #send.
         (RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send) ∧
         (#send < #receive)) ∨
       (∃ E P #c.
         (SessionCompromise( E, P, td, chain ) @ #c) ∧ (#c < #receive))) ∨
      (∃ E P #c.
        (RatchetKeyCompromise( E, P, td, chain ) @ #c) ∧ (#c < #receive))) ∨
     ((∃ I P #c.
        (ClassicalComponentCompromise( I, P, td, chain ) @ #c) ∧
        (#c < #receive)) ∧
      (∃ I P #q.
        (PostQuantumComponentCompromise( I, P, td, chain ) @ #q) ∧
        (#q < #receive))))"
/*
guarded formula characterizing all counter-examples:
"∃ R S td direction n message packet chain #receive.
  (RecordReceived( R, S, td, direction, n, message, packet, chain
   ) @ #receive)
 ∧
  (∀ #send.
    (RecordSent( S, R, td, direction, n, message, packet, chain ) @ #send)
   ⇒
    ¬(#send < #receive)) ∧
  (∀ E P #c.
    (SessionCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #receive)) ∧
  (∀ E P #c.
    (RatchetKeyCompromise( E, P, td, chain ) @ #c) ⇒ ¬(#c < #receive)) ∧
  (((∀ I P #c.
      (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
     ⇒
      ¬(#c < #receive)) ∨
    (∀ I P #q.
      (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
     ⇒
      ¬(#q < #receive))))"
*/
simplify
solve( (∀ I P #c.
         (ClassicalComponentCompromise( I, P, td, chain ) @ #c)
        ⇒
         ¬(#c < #receive))  ∥
       (∀ I P #q.
         (PostQuantumComponentCompromise( I, P, td, chain ) @ #q)
        ⇒
         ¬(#q < #receive)) )
  case case_1
  solve( ChainState( $R, S, td, direction, n, chain ) ▶₀ #receive )
    case InitiatorAccept
    solve( !KU( senc(<message, sender_metadata,
                      h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                         'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                         '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                         $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                      'i2r', ~coordinate>,
                     ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                  h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                     'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                     '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                                     $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>)))
           ) @ #vk )
      case SendRecord
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( ~coordinate ) @ #vk.10 )
        case SendRecord
        solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                 h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                    'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                    '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                                    $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
               ) @ #vk.3 )
          case CompromiseSession_case_1
          by contradiction /* from formulas */
        next
          case CompromiseSession_case_2
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_1
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_2
          by contradiction /* from formulas */
        next
          case c_ideal_hybrid
          solve( !KU( ~classical_component ) @ #vk.11 )
            case CompromiseClassicalComponent
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case ResponderAccept
    solve( !KU( senc(<message, sender_metadata,
                      h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                         'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                         '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                         $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                      'i2r', ~coordinate>,
                     ideal_hybrid(~classical_component, ~pq_component, $I, $R,
                                  h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                     'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                     '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                                     $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>)))
           ) @ #vk )
      case SendRecord
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( ~coordinate ) @ #vk.10 )
        case SendRecord
        solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $I, $R,
                                 h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                    'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                    '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I,
                                    $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
               ) @ #vk.3 )
          case CompromiseSession_case_1
          by contradiction /* from formulas */
        next
          case CompromiseSession_case_2
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_1
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_2
          by contradiction /* from formulas */
        next
          case c_ideal_hybrid
          solve( !KU( ~classical_component ) @ #vk.11 )
            case CompromiseClassicalComponent
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( ChainState( $R, S, td, direction, n, chain ) ▶₀ #receive )
    case InitiatorAccept
    solve( !KU( senc(<message, sender_metadata,
                      h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                         'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                         '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                         $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>),
                      'i2r', ~coordinate>,
                     ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                  h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                     'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                     '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                                     $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>)))
           ) @ #vk )
      case SendRecord
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( ~coordinate ) @ #vk.10 )
        case SendRecord
        solve( !KU( ideal_hybrid(~classical_component, ~pq_component, $R, $R.1,
                                 h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                    'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                                    '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $R,
                                    $R.1, ~pair, h(~prekey), h(~classical_component), h(~pq_component)>))
               ) @ #vk.3 )
          case CompromiseSession_case_1
          by contradiction /* from formulas */
        next
          case CompromiseSession_case_2
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_1
          by contradiction /* from formulas */
        next
          case RatchetCompromiseBeforeRecovery_case_2
          by contradiction /* from formulas */
        next
          case c_ideal_hybrid
          solve( !KU( ~classical_component ) @ #vk.11 )
            case CompromiseClassicalComponent
            solve( !KU( ~pq_component ) @ #vk.12 )
              case CompromisePostQuantumComponent
              by contradiction /* from formulas */
            qed
          qed
        qed

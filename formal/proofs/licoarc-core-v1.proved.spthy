                                       $R, $R, ~pair, h(~prekey), h(~classical_component), h(~pq_component)
                                      >)))
             ) @ #vk )
        case c_senc
        by solve( !KU( ~coordinate ) @ #vk.11 )
      qed
    qed
  next
    case ResponderAccept
    solve( ChainState( $R, $I,
                       h(<'ec6b77e2c536500fdcfa6d70aabccaab3e2db4aa8db08c06241300f3d67dfdbd', 
                          'c29c454f3d39273a15d500b9d665b0eed5e93864d63243822e10ba22f5384d83', 

theory LicoArc_Core_V1
begin

builtins: hashing, symmetric-encryption, signing

functions:
  ideal_hybrid/5,
  ratchet_step/2

/* generated semantic-source binding: de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc */

/*
This source-bound model verifies the protocol state/event invariants named by
its lemmas. ideal_hybrid, signature verification, authenticated record
protection, and source-derived bound classification are explicit ideal
abstractions: the model does not claim computational security or downstream
implementation resource accounting of the admitted algorithms and bounds.

Linear Prekey, HandshakeOffer, and ChainState facts model one atomic durable
compare-and-commit. A rule consumes one complete prior snapshot and emits one
complete successor, or performs no mutation. Rollback detection under complete
store compromise, physical zeroization, ratchet-header confidentiality,
transferable session authentication, and ongoing post-quantum post-compromise
recovery are the modeled Profile's explicit nonclaims. Ratchet recovery below
models only a fresh uncompromised classical DH input.

The Dolev-Yao network represents the untrusted Station carrier. Identity,
route, user-authority, Endpoint-possession, and confirmation acceptance require
an exact persistent verification authority. User-authority and Endpoint-state
digests are independent siblings in the session transcript; the model does not
place either digest inside the other state.
*/

rule ProvisionPair:
  [ Fr(~pair), Fr(~prekey), Fr(~identity_secret_i), Fr(~identity_secret_r) ]
  --[ PeerAcceptedLocally($I, $R), PrekeyPublished($R, ~pair, h(~prekey)),
      EndpointIdentityProvisioned($I, pk(~identity_secret_i)),
      EndpointIdentityProvisioned($R, pk(~identity_secret_r)) ]->
  [ InitiatorReady($I, $R, ~pair, h(~prekey)),
    ResponderReady($R, $I, ~pair, h(~prekey)),
    !IdentityMaterial($I, ~identity_secret_i),
    !IdentityMaterial($R, ~identity_secret_r),
    !IdentityPublic($I, pk(~identity_secret_i)),
    !IdentityPublic($R, pk(~identity_secret_r)),
    !IdentityVerification($I, ~identity_secret_i),
    !IdentityVerification($R, ~identity_secret_r),
    !PrekeyMaterial($R, ~pair, ~prekey) ]

rule InitiatorFirstPacket:
  let transcript = h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', 'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08',
                      '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17', $I, R, pair, prekey_pub,
                      h(~classical_component), h(~pq_component)>)
      root = ideal_hybrid(~classical_component, ~pq_component, $I, R, transcript)
  in
  [ InitiatorReady($I, R, pair, prekey_pub),
    Fr(~classical_component), Fr(~pq_component), Fr(~coordinate) ]
  --[ InitiatorStarted($I, R, pair, transcript, root),
      HybridEstablished($I, R, transcript, root),
      SessionSecret(root) ]->
  [ HandshakeOffer($I, R, pair, transcript, root, ~coordinate),
    InitiatorPending($I, R, pair, transcript, root, ~coordinate),
    !HybridComponents($I, R, transcript, root,
                      ~classical_component, ~pq_component) ]

rule ResponderAccept:
  [ ResponderReady($R, I, pair, prekey_pub),
    HandshakeOffer(I, $R, pair, transcript, root, coordinate) ]
  --[ ResponderAccepted($R, I, pair, transcript, root),
      LineAuthenticated('c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08'), ProfileAuthenticated('4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17'),
      AtomicHandshakeCommit($R, pair, transcript) ]->
  [ !Established($R, I, transcript, root),
    !ReplayBinding($R, pair, transcript),
    ChainState($R, I, transcript, 'i2r', coordinate, root),
    RatchetInitial($R, I, transcript, root),
    SessionBindingReady($R, I, transcript),
    SessionAccept(I, $R, pair, transcript, root, coordinate) ]

rule ReplayExactFirstPacket:
  [ !ReplayBinding($R, pair, transcript) ]
  --[ ExactHandshakeReplay($R, pair, transcript) ]->
  [ ]

rule InitiatorAccept:
  [ InitiatorPending($I, R, pair, transcript, root, coordinate),
    SessionAccept($I, R, pair, transcript, root, coordinate) ]
  --[ InitiatorEstablished($I, R, pair, transcript, root),
      AtomicHandshakeCommit($I, pair, transcript) ]->
  [ !Established($I, R, transcript, root),
    ChainState($I, R, transcript, 'i2r', coordinate, root),
    RatchetInitial($I, R, transcript, root),
    SessionBindingReady($I, R, transcript) ]

rule BindSiblingAuthorityState:
  let endpoint_state = h(<'endpoint-state', $E, transcript>)
      authority_state = h(<'user-authority-state', $E, transcript>)
      peer_endpoint_state = h(<'endpoint-state', P, transcript>)
      peer_authority_state = h(<'user-authority-state', P, transcript>)
  in
  [ SessionBindingReady($E, P, transcript) ]
  --[ SessionSiblingBound($E, P, transcript,
                          endpoint_state, authority_state,
                          peer_endpoint_state, peer_authority_state) ]->
  [ ]

rule SendRecord:
  let packet = senc(<~message, ~sender_metadata, transcript, direction, n>, chain)
  in
  [ ChainState($S, R, transcript, direction, n, chain),
    Fr(~message), Fr(~sender_metadata) ]
  --[ RecordSent($S, R, transcript, direction, n, ~message, packet, chain),
      SenderMetadataProtected($S, R, transcript, ~sender_metadata, packet, chain),
      AtomicSendCommit($S, transcript, direction, n) ]->
  [ Out(packet) ]

rule ReceiveRecord:
  let packet = senc(<message, sender_metadata, transcript, direction, n>, chain)
  in
  [ ChainState($R, S, transcript, direction, n, chain), In(packet) ]
  --[ RecordReceived($R, S, transcript, direction, n, message, packet, chain),
      EndpointAccepted($R, S, transcript, direction, n, message, packet, chain),
      AtomicReceiveCommit($R, transcript, direction, n) ]->
  [ DurableInbox($R, S, transcript, direction, n, h(message)) ]

rule CompromiseSession:
  [ !Established($E, P, transcript, root) ]
  --[ SessionCompromise($E, P, transcript, root) ]->
  [ Out(root) ]

rule CompromiseClassicalComponent:
  [ !HybridComponents(I, R, transcript, root, classical, pq) ]
  --[ ClassicalComponentCompromise(I, R, transcript, root) ]->
  [ Out(classical) ]

rule CompromisePostQuantumComponent:
  [ !HybridComponents(I, R, transcript, root, classical, pq) ]
  --[ PostQuantumComponentCompromise(I, R, transcript, root) ]->
  [ Out(pq) ]

rule CompromiseIdentityMaterial:
  [ !IdentityMaterial($E, secret) ]
  --[ IdentityMaterialCompromise($E, pk(secret)) ]->
  [ Out(secret) ]

rule CompromisePrekeyMaterial:
  [ !PrekeyMaterial($R, pair, prekey) ]
  --[ PrekeyMaterialCompromise($R, pair) ]->
  [ Out(prekey) ]

rule RatchetAdvanceUncompromised:
  let next = ratchet_step(old, ~fresh_dh)
  in
  [ RatchetInitial($E, P, transcript, old), Fr(~fresh_dh) ]
  --[ RatchetAdvanced($E, P, transcript, old, next), RatchetSecret(next) ]->
  [ RatchetAdvancedState($E, P, transcript, old, next) ]

rule RatchetCompromiseBeforeRecovery:
  [ RatchetInitial($E, P, transcript, old) ]
  --[ RatchetKeyCompromise($E, P, transcript, old) ]->
  [ RatchetExposed($E, P, transcript, old), Out(old) ]

rule RatchetRecoverAfterCompromise:
  let next = ratchet_step(old, ~fresh_dh)
  in
  [ RatchetExposed($E, P, transcript, old), Fr(~fresh_dh) ]
  --[ RatchetRecovered($E, P, transcript, old, next), RatchetSecret(next) ]->
  [ RatchetAdvancedState($E, P, transcript, old, next) ]

rule RatchetCompromiseAdvanced:
  [ RatchetAdvancedState($E, P, transcript, old, next) ]
  --[ RatchetKeyCompromise($E, P, transcript, next) ]->
  [ Out(next) ]

rule ProvisionUserAuthority:
  let user_ref = h(<'user-authority-genesis', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                     pk(~management_secret), pk(~recovery_secret)>)
      endpoint_state = h(<'endpoint-state', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                           $E, pk(~endpoint_secret)>)
      authority_state = h(<'user-authority-state', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                            user_ref, '0', pk(~management_secret),
                            pk(~recovery_secret), $E, endpoint_state>)
      possession = sign(<'endpoint-possession', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                          user_ref, '0', $E, endpoint_state>, ~endpoint_secret)
      management_signature = sign(<'user-authority-genesis-management',
                                    'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', user_ref,
                                    authority_state>, ~management_secret)
      recovery_signature = sign(<'user-authority-genesis-recovery',
                                  'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', user_ref,
                                  authority_state>, ~recovery_secret)
  in
  [ Fr(~management_secret), Fr(~recovery_secret), Fr(~endpoint_secret) ]
  --[ UserAuthorityGenesisCreated(user_ref, authority_state,
                                  pk(~management_secret), pk(~recovery_secret)),
      EndpointPossessionAuthorized(user_ref, '0', $E, endpoint_state,
                                   pk(~endpoint_secret), possession) ]->
  [ !ManagementAuthority(user_ref, authority_state, ~management_secret),
    !RecoveryAuthority(user_ref, authority_state, ~recovery_secret),
    !AuthorityGenesisVerification(user_ref, authority_state,
                                  ~management_secret, ~recovery_secret),
    !EndpointVerification($E, ~endpoint_secret),
    AuthorityGenesisEnvelope(user_ref, authority_state,
                             pk(~management_secret), pk(~recovery_secret),
                             $E, endpoint_state, pk(~endpoint_secret),
                             possession, management_signature,
                             recovery_signature) ]

rule AcceptUserAuthorityGenesis:
  [ !AuthorityGenesisVerification(user_ref, authority_state,
                                   management_secret, recovery_secret),
    !EndpointVerification($E, endpoint_secret),
    AuthorityGenesisEnvelope(
        user_ref, authority_state, pk(management_secret), pk(recovery_secret),
        $E, endpoint_state, pk(endpoint_secret),
        sign(<'endpoint-possession', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
              user_ref, '0', $E, endpoint_state>, endpoint_secret),
        sign(<'user-authority-genesis-management', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
              user_ref, authority_state>, management_secret),
        sign(<'user-authority-genesis-recovery', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
              user_ref, authority_state>, recovery_secret)) ]
  --[ UserAuthorityGenesisAccepted(user_ref, authority_state,
                                   pk(management_secret), pk(recovery_secret)),
      EndpointPossessionAccepted(user_ref, '0', $E, endpoint_state,
                                 pk(endpoint_secret)) ]->
  [ ]

rule AuthorizeManagementTransition:
  let signed = sign(<'user-authority-management-transition',
                     'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', user_ref, predecessor,
                     ~successor>, management_secret)
  in
  [ !ManagementAuthority(user_ref, predecessor, management_secret),
    Fr(~successor) ]
  --[ ManagementTransitionAuthorized(user_ref, predecessor, ~successor,
                                     pk(management_secret)) ]->
  [ ManagementTransitionEnvelope(user_ref, predecessor, ~successor,
                                 pk(management_secret), signed) ]

rule AcceptManagementTransition:
  [ !ManagementAuthority(user_ref, predecessor, management_secret),
    ManagementTransitionEnvelope(
        user_ref, predecessor, successor, pk(management_secret),
        sign(<'user-authority-management-transition',
              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', user_ref, predecessor,
              successor>, management_secret)) ]
  --[ AuthorityTransitionAccepted(user_ref, predecessor, successor,
                                  'management', pk(management_secret)) ]->
  [ ]

rule AuthorizeRecoveryTransition:
  let signed = sign(<'user-authority-recovery-transition',
                     'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', user_ref, predecessor,
                     ~successor>, recovery_secret)
  in
  [ !RecoveryAuthority(user_ref, predecessor, recovery_secret),
    Fr(~successor) ]
  --[ RecoveryTransitionAuthorized(user_ref, predecessor, ~successor,
                                   pk(recovery_secret)) ]->
  [ RecoveryTransitionEnvelope(user_ref, predecessor, ~successor,
                               pk(recovery_secret), signed) ]

rule AcceptRecoveryTransition:
  [ !RecoveryAuthority(user_ref, predecessor, recovery_secret),
    RecoveryTransitionEnvelope(
        user_ref, predecessor, successor, pk(recovery_secret),
        sign(<'user-authority-recovery-transition',
              'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', user_ref, predecessor,
              successor>, recovery_secret)) ]
  --[ AuthorityTransitionAccepted(user_ref, predecessor, successor,
                                  'recovery', pk(recovery_secret)) ]->
  [ ]

rule CompromiseManagementAuthority:
  [ !ManagementAuthority(user_ref, state, management_secret) ]
  --[ ManagementAuthorityCompromise(user_ref, state, pk(management_secret)) ]->
  [ Out(management_secret) ]

rule CompromiseRecoveryAuthority:
  [ !RecoveryAuthority(user_ref, state, recovery_secret) ]
  --[ RecoveryAuthorityCompromise(user_ref, state, pk(recovery_secret)) ]->
  [ Out(recovery_secret) ]

rule CompromiseEndpointAuthority:
  [ !EndpointVerification($E, endpoint_secret) ]
  --[ EndpointAuthorityCompromise($E, pk(endpoint_secret)) ]->
  [ Out(endpoint_secret) ]

rule AuthorizeRouteMigration:
  let route_digest = h(<'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $E, $P, ~old_route, ~new_route>)
      signed = sign(<'route-migration', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $E, $P,
                     ~old_route, ~new_route, route_digest>, secret)
  in
  [ !IdentityMaterial($E, secret), Fr(~old_route), Fr(~new_route) ]
  --[ RouteMigrationAuthorized($E, $P, pk(secret), ~old_route, ~new_route,
                               route_digest) ]->
  [ Out(<$E, $P, pk(secret), ~old_route, ~new_route, route_digest, signed>) ]

rule AcceptRouteMigration:
  [ !IdentityVerification($E, secret),
    In(<$E, P, pk(secret), old_route, new_route, route_digest,
        sign(<'route-migration', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $E, P,
              old_route, new_route, route_digest>, secret)>) ]
  --[ RouteMigrationAccepted($E, P, pk(secret), old_route, new_route,
                             route_digest) ]->
  [ ]

rule IssueAuthenticatedConfirmation:
  let confirmation = sign(<'authenticated-confirmation',
                            'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc', $E, S, transcript,
                            ~confirmation_id, ~logical_message_ids,
                            ~stage, message_digest, ~result_digest>, secret)
  in
  [ !IdentityMaterial($E, secret),
    DurableInbox($E, S, transcript, direction, n, message_digest),
    Fr(~confirmation_id), Fr(~logical_message_ids),
    Fr(~stage), Fr(~result_digest) ]
  --[ AuthenticatedConfirmationIssued($E, S, transcript,
                                      ~confirmation_id, ~logical_message_ids,
                                      ~stage, message_digest, ~result_digest,
                                      confirmation, pk(secret)) ]->
  [ ConfirmationEnvelope($E, S, transcript, ~confirmation_id,
                         ~logical_message_ids, ~stage, message_digest,
                         ~result_digest, confirmation) ]

rule AcceptAuthenticatedConfirmation:
  [ !IdentityVerification(E, secret),
    ConfirmationEnvelope(
        E, $S, transcript, confirmation_id, logical_message_ids,
        stage, message_digest, result_digest,
        sign(<'authenticated-confirmation', 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
              E, $S, transcript, confirmation_id, logical_message_ids,
              stage, message_digest, result_digest>, secret)) ]
  --[ AuthenticatedConfirmationFinalized($S, E, transcript,
                                         confirmation_id, logical_message_ids,
                                         stage, message_digest, result_digest,
                                         sign(<'authenticated-confirmation',
                                               'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc',
                                               E, $S, transcript,
                                               confirmation_id,
                                               logical_message_ids, stage,
                                               message_digest, result_digest>,
                                              secret), pk(secret)) ]->
  [ ]

rule ClassifyWithinResourceBounds:
  [ Fr(~input) ]
  --[ InputClassifiedWithinBounds(~input, 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc') ]->
  [ WithinResourceBounds(~input), Out(~input) ]

rule AcceptWithinResourceBounds:
  [ WithinResourceBounds(input), In(input) ]
  --[ ResourceBoundsValidated(input, 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc'),
      ParserAccepted(input), ParserStateCommitted(input) ]->
  [ ]

rule ClassifyOverResourceBounds:
  [ Fr(~input) ]
  --[ InputClassifiedOverBounds(~input, 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc') ]->
  [ OverResourceBounds(~input), Out(~input) ]

rule RejectOverResourceBounds:
  [ OverResourceBounds(input), In(input) ]
  --[ ResourceLimitRejected(input, 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc') ]->
  [ ]

lemma executable_honest_handshake:
  exists-trace
  "Ex I R pair td root #i #r. InitiatorStarted(I, R, pair, td, root) @ i
   & ResponderAccepted(R, I, pair, td, root) @ r"

lemma executable_ratchet_evolution:
  exists-trace
  "Ex E1 P1 td1 old1 next1 E2 P2 td2 old2 next2 #advance #recover.
   RatchetAdvanced(E1, P1, td1, old1, next1) @ advance
   & RatchetRecovered(E2, P2, td2, old2, next2) @ recover"

lemma executable_user_authority_and_route:
  exists-trace
  "Ex user_ref authority_state management_public recovery_public
      E P public old_route new_route route_digest #authority #route.
   UserAuthorityGenesisAccepted(user_ref, authority_state,
                                management_public, recovery_public) @ authority
   & RouteMigrationAccepted(E, P, public, old_route, new_route,
                            route_digest) @ route"

lemma executable_authority_transitions_and_possession:
  exists-trace
  "Ex user_ref predecessor management_successor recovery_successor
      management_public recovery_public E endpoint_state endpoint_public
      #management #recovery #possession.
   AuthorityTransitionAccepted(user_ref, predecessor, management_successor,
                               'management', management_public) @ management
   & AuthorityTransitionAccepted(user_ref, predecessor, recovery_successor,
                                 'recovery', recovery_public) @ recovery
   & EndpointPossessionAccepted(user_ref, '0', E, endpoint_state,
                                endpoint_public) @ possession"

lemma executable_sibling_session_binding:
  exists-trace
  "Ex E P td endpoint_state authority_state peer_endpoint_state
      peer_authority_state #bound.
   SessionSiblingBound(E, P, td, endpoint_state, authority_state,
                       peer_endpoint_state, peer_authority_state) @ bound"

lemma executable_authenticated_confirmation_and_metadata:
  exists-trace
  "Ex S R td direction n message packet chain metadata confirmation_id
      logical_message_ids stage message_digest result_digest confirmation public
      #send #accept #finality.
   SenderMetadataProtected(S, R, td, metadata, packet, chain) @ send
   & EndpointAccepted(R, S, td, direction, n, message, packet, chain) @ accept
   & AuthenticatedConfirmationFinalized(S, R, td, confirmation_id,
                                       logical_message_ids, stage,
                                       message_digest, result_digest,
                                       confirmation, public) @ finality"

lemma executable_resource_bounds:
  exists-trace
  "Ex accepted rejected #accept #reject.
   ParserAccepted(accepted) @ accept
   & ResourceLimitRejected(rejected, 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc') @ reject"

lemma SEC_001_hybrid_ake_key_secrecy:
  "All I R td root #established #know.
   HybridEstablished(I, R, td, root) @ established & K(root) @ know
   ==> (Ex E P #c. SessionCompromise(E, P, td, root) @ c & c < know)
     | (Ex E P #c. RatchetKeyCompromise(E, P, td, root) @ c & c < know)
     | ((Ex #c. ClassicalComponentCompromise(I, R, td, root) @ c & c < know)
      & (Ex #q. PostQuantumComponentCompromise(I, R, td, root) @ q & q < know))"

lemma SEC_002_mutual_endpoint_authentication:
  "All R I pair td root #accept. ResponderAccepted(R, I, pair, td, root) @ accept
   ==> Ex #start. InitiatorStarted(I, R, pair, td, root) @ start & start < accept"

lemma SEC_004_unknown_key_share_resistance:
  "All R I pair td root R2 I2 #a #b. ResponderAccepted(R, I, pair, td, root) @ a
   & ResponderAccepted(R2, I2, pair, td, root) @ b ==> R = R2 & I = I2"

lemma SEC_005_key_compromise_impersonation_boundary:
  "All I R pair td root #accept.
   InitiatorEstablished(I, R, pair, td, root) @ accept
   ==> (Ex #respond. ResponderAccepted(R, I, pair, td, root) @ respond
                       & respond < accept)
     | (Ex public #c. IdentityMaterialCompromise(R, public) @ c & c < accept)
     | (Ex #c. PrekeyMaterialCompromise(R, pair) @ c & c < accept)"

lemma SEC_003_classical_pq_hybrid_robustness:
  "All I R td root #established #know.
   HybridEstablished(I, R, td, root) @ established & K(root) @ know
   ==> (Ex E P #c. SessionCompromise(E, P, td, root) @ c & c < know)
     | (Ex E P #c. RatchetKeyCompromise(E, P, td, root) @ c & c < know)
     | ((Ex #c. ClassicalComponentCompromise(I, R, td, root) @ c & c < know)
      & (Ex #q. PostQuantumComponentCompromise(I, R, td, root) @ q & q < know))"

lemma SEC_006_protocol_line_content_binding:
  "All line #i. LineAuthenticated(line) @ i ==> line = 'c0b64d71865ce972a944db3d31a18cb03395300f3ed006c21e64429178c23a08'"

lemma SEC_007_protection_profile_content_binding:
  "All profile #i. ProfileAuthenticated(profile) @ i ==> profile = '4b7d575f397862f9031e44b716921e86c410b5facf379bde21955922b0d58a17'"

lemma SEC_008_session_independence:
  "All I1 R1 td1 root1 I2 R2 td2 root2 #e1 #e2 #compromise #know.
   HybridEstablished(I1, R1, td1, root1) @ e1
   & HybridEstablished(I2, R2, td2, root2) @ e2
   & SessionCompromise(I1, R1, td1, root1) @ compromise
   & K(root2) @ know & not(root1 = root2)
   ==> (Ex E P #c. SessionCompromise(E, P, td2, root2) @ c & c < know)
     | (Ex E P #c. RatchetKeyCompromise(E, P, td2, root2) @ c & c < know)
     | ((Ex #c. ClassicalComponentCompromise(I2, R2, td2, root2) @ c & c < know)
      & (Ex #q. PostQuantumComponentCompromise(I2, R2, td2, root2) @ q & q < know))"

lemma SEC_009_initial_forward_secrecy:
  "All R I pair td root #accept #know.
   ResponderAccepted(R, I, pair, td, root) @ accept & K(root) @ know & accept < know
   ==> (Ex E P #c. SessionCompromise(E, P, td, root) @ c & c < know)
     | (Ex E P #c. RatchetKeyCompromise(E, P, td, root) @ c & c < know)
     | ((Ex #c. ClassicalComponentCompromise(I, R, td, root) @ c & c < know)
      & (Ex #q. PostQuantumComponentCompromise(I, R, td, root) @ q & q < know))"

lemma SEC_010_double_ratchet_forward_secrecy:
  "All E P td old next #advance #know.
   RatchetAdvanced(E, P, td, old, next) @ advance & K(old) @ know
   ==> (Ex E2 P2 #c. SessionCompromise(E2, P2, td, old) @ c & c < know)
     | (Ex E2 P2 #c. RatchetKeyCompromise(E2, P2, td, old) @ c & c < know)
     | ((Ex I R #c. ClassicalComponentCompromise(I, R, td, old) @ c & c < know)
      & (Ex I R #q. PostQuantumComponentCompromise(I, R, td, old) @ q & q < know))"

lemma SEC_011_double_ratchet_post_compromise_recovery:
  "All E P td old next #recover #know.
   RatchetRecovered(E, P, td, old, next) @ recover & K(next) @ know
   ==> Ex #c. RatchetKeyCompromise(E, P, td, next) @ c & c < know"

lemma SEC_012_replay_resistance:
  "All R S td direction n m1 p1 c1 m2 p2 c2 #i #j.
   RecordReceived(R, S, td, direction, n, m1, p1, c1) @ i
   & RecordReceived(R, S, td, direction, n, m2, p2, c2) @ j ==> #i = #j"

lemma SEC_013_state_rollback_resistance:
  "All E td direction n #i #j. AtomicReceiveCommit(E, td, direction, n) @ i
   & AtomicReceiveCommit(E, td, direction, n) @ j ==> #i = #j"

lemma SEC_014_self_certifying_user_authority:
  "All user_ref authority_state management_public recovery_public #accept.
   UserAuthorityGenesisAccepted(user_ref, authority_state,
                                management_public, recovery_public) @ accept
   ==> Ex #create.
       UserAuthorityGenesisCreated(user_ref, authority_state,
                                   management_public, recovery_public) @ create
       & create < accept"

lemma SEC_015_route_migration_safety:
  "All E P public old_route new_route route_digest #accept.
   RouteMigrationAccepted(E, P, public, old_route, new_route, route_digest) @ accept
   ==> (Ex #authorize.
        RouteMigrationAuthorized(E, P, public, old_route, new_route,
                                 route_digest) @ authorize
        & authorize < accept)
     | (Ex #c. IdentityMaterialCompromise(E, public) @ c & c < accept)"

lemma SEC_016_management_and_recovery_transition_authorization:
  "All user_ref predecessor successor kind public #accept.
   AuthorityTransitionAccepted(user_ref, predecessor, successor,
                               kind, public) @ accept
   ==> (kind = 'management'
        & ((Ex #authorize.
            ManagementTransitionAuthorized(user_ref, predecessor, successor,
                                           public) @ authorize
            & authorize < accept)
           | (Ex #c. ManagementAuthorityCompromise(user_ref, predecessor,
                                                    public) @ c & c < accept)))
     | (kind = 'recovery'
        & ((Ex #authorize.
            RecoveryTransitionAuthorized(user_ref, predecessor, successor,
                                         public) @ authorize
            & authorize < accept)
           | (Ex #c. RecoveryAuthorityCompromise(user_ref, predecessor,
                                                  public) @ c & c < accept)))"

lemma SEC_017_endpoint_possession_authorization:
  "All user_ref epoch E endpoint_state endpoint_public #accept.
   EndpointPossessionAccepted(user_ref, epoch, E, endpoint_state,
                              endpoint_public) @ accept
   ==> (Ex proof #authorize.
        EndpointPossessionAuthorized(user_ref, epoch, E, endpoint_state,
                                     endpoint_public, proof) @ authorize
        & authorize < accept)
     | (Ex #c. EndpointAuthorityCompromise(E, endpoint_public) @ c & c < accept)"

lemma SEC_018_acyclic_sibling_endpoint_authority_session_binding:
  "All E P td endpoint_state authority_state peer_endpoint_state
       peer_authority_state #bound.
   SessionSiblingBound(E, P, td, endpoint_state, authority_state,
                       peer_endpoint_state, peer_authority_state) @ bound
   ==> not(endpoint_state = authority_state)
     & not(peer_endpoint_state = peer_authority_state)"

lemma SEC_019_authenticated_confirmation_finality:
  "All S E td confirmation_id logical_message_ids stage message_digest
       result_digest confirmation public #finality.
   AuthenticatedConfirmationFinalized(S, E, td, confirmation_id,
                                      logical_message_ids, stage,
                                      message_digest, result_digest,
                                      confirmation, public) @ finality
   ==> (Ex #issue.
        AuthenticatedConfirmationIssued(E, S, td, confirmation_id,
                                        logical_message_ids, stage,
                                        message_digest, result_digest,
                                        confirmation, public) @ issue
        & issue < finality)
     | (Ex #c. IdentityMaterialCompromise(E, public) @ c & c < finality)"

lemma SEC_020_fail_closed_resource_bounds:
  "(All input #accept. ParserAccepted(input) @ accept
    ==> ResourceBoundsValidated(input, 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc') @ accept)
   & (All input #reject. ResourceLimitRejected(input, 'de14dc7ceb33da6ae41283268684da78c3a5448d74058752050761ded6904adc') @ reject
      ==> not (Ex #commit. ParserStateCommitted(input) @ commit))"

lemma SEC_022_pairwise_record_authentication_and_integrity:
  "All R S td direction n message packet chain #receive.
   RecordReceived(R, S, td, direction, n, message, packet, chain) @ receive
   ==> (Ex #send. RecordSent(S, R, td, direction, n, message, packet, chain) @ send & send < receive)
     | (Ex E P #c. SessionCompromise(E, P, td, chain) @ c & c < receive)
     | (Ex E P #c. RatchetKeyCompromise(E, P, td, chain) @ c & c < receive)
     | ((Ex I P #c. ClassicalComponentCompromise(I, P, td, chain) @ c & c < receive)
      & (Ex I P #q. PostQuantumComponentCompromise(I, P, td, chain) @ q & q < receive))"

lemma SEC_021_pairwise_record_confidentiality:
  "All S R td direction n message packet chain #send #know.
   RecordSent(S, R, td, direction, n, message, packet, chain) @ send & K(message) @ know
   ==> (Ex E P #c. SessionCompromise(E, P, td, chain) @ c & c < know)
     | (Ex E P #c. RatchetKeyCompromise(E, P, td, chain) @ c & c < know)
     | ((Ex I P #c. ClassicalComponentCompromise(I, P, td, chain) @ c & c < know)
      & (Ex I P #q. PostQuantumComponentCompromise(I, P, td, chain) @ q & q < know))"

lemma SEC_023_sender_metadata_confidentiality:
  "All S R td metadata packet chain #send #know.
   SenderMetadataProtected(S, R, td, metadata, packet, chain) @ send
   & K(metadata) @ know
   ==> (Ex E P #c. SessionCompromise(E, P, td, chain) @ c & c < know)
     | (Ex E P #c. RatchetKeyCompromise(E, P, td, chain) @ c & c < know)
     | ((Ex I P #c. ClassicalComponentCompromise(I, P, td, chain) @ c & c < know)
      & (Ex I P #q. PostQuantumComponentCompromise(I, P, td, chain) @ q & q < know))"

end
